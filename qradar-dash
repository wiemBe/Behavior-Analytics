#!/usr/bin/env bash
# qradar-dash -- install and operate the on-premises QRadar behavioural-analytics stack.
#
#   ./qradar-dash install [--non-interactive FILE] [--build | --offline BUNDLE]
#                         [--external-proxy] [--reconfigure] [--dry-run]
#                         [--skip-qradar-check]
#   ./qradar-dash status
#   ./qradar-dash logs [docker compose logs arguments]
#   ./qradar-dash doctor [--json]
#   ./qradar-dash backup [manual|scheduled|pre-upgrade] [--no-verify]
#                        [--print-timer | --install-timer]
#   ./qradar-dash restore <backup-directory> [--non-interactive --yes]
#   ./qradar-dash support-bundle
#   ./qradar-dash upgrade <version> [--offline [BUNDLE]]
#   ./qradar-dash bundle [--version X.Y.Z] [--output DIR]
#   ./qradar-dash rollback [--non-interactive --yes]
#   ./qradar-dash repair-state
#
# Specified in docs/OPERATIONS-DESIGN.md section 3. The script needs bash and
# Docker with Compose v2 on the host, plus openssl and curl. It never calls
# Python on the host, never changes the SELinux mode, never passes :z or :Z, and
# never bind-mounts the checkout: secrets travel through deploy/load-secrets.sh.
set -euo pipefail

ORIG_PWD="$PWD" # where the operator ran the script; a relative bundle path is relative to it
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"

START_SECONDS=$SECONDS
ENV_FILE=.env
SAVED_ANSWERS=.secrets/install.answers
TMP_DIR=.install-tmp
# The repository was renamed on 2026-10-18 (wiemBe/Behavior-Analytics); releases from the next
# one are pushed under the new prefix. The old one is used only by migrate_image_prefix.
DEFAULT_IMAGE_PREFIX=ghcr.io/wiembe/behavior-analytics
OLD_IMAGE_PREFIX=ghcr.io/wiembe/qradar-dashboard

say() { printf '%s\n' "$*"; }
info() { printf '[ ok ] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*" >&2; }
fail() { printf '[FAIL] %s\n' "$*" >&2; }
die() { fail "$*"; exit 1; }

usage() {
  cat <<'EOF'
Usage: ./qradar-dash <command> [options]

Commands
  install       Preflight, wizard, secrets, migrate, break-glass admin, start.
  status        Show the stack and the API health.
  logs          Show service logs (arguments go to `docker compose logs`).
  doctor        Run read-only host and in-container diagnostics.
                --json prints one JSON array (host checks, then the container's own --json).
  backup        Create and verify a private database, configuration and secrets backup.
  restore       Restore a complete backup after confirmation.
  support-bundle
                Write a redacted diagnostic archive under the backup root.
  upgrade       Pull and install one explicit production SemVer release.
  rollback      Restore the pre-upgrade backup and previous image digests (asks first).
  repair-state  Record a healthy upgrade or rollback whose state file was not written.
  bundle        On a connected host: write the offline bundle (images and checkout) for an
                air-gapped host.

backup options
  --no-verify       Skip the scratch-database restore (not allowed for pre-upgrade).
  --print-timer     Print the daily systemd service and timer; write nothing.
  --install-timer   Install and enable the daily systemd timer.

restore options
  --non-interactive Refuse unless --yes is also present.
  --yes             Confirm a non-interactive restore.

upgrade options
  --offline [BUNDLE]
                    Do not pull. With BUNDLE, verify and load the images from that offline
                    bundle first; without it, refuse unless every target image is already loaded.

bundle options
  --version X.Y.Z   Assert the release to bundle (it must equal this checkout's VERSION).
  --output DIR      Directory for qradar-dash-<version>-bundle.tar (default: the current directory).

rollback options
  --non-interactive Refuse unless --yes is also present.
  --yes             Confirm a non-interactive rollback.

install options
  --non-interactive FILE   Read the answers from FILE (mode 0600, no secrets).
  --build                  Build the images from this checkout instead of pulling.
  --offline BUNDLE         Load the images from an offline bundle tar (made by `bundle`).
  --external-proxy         Skip the bundled TLS proxy; you run your own.
  --reconfigure            Ask the questions again even when answers are saved.
  --dry-run                Run every check, write nothing, change nothing.
  --skip-qradar-check      Skip the TLS handshake test against the QRadar console.

doctor options
  --json            Print one JSON array and no text lines.

repair-state
  No options. Refuses unless the API is ready, the database revision matches the running
  image, and the last upgrade outcome is failed, or success while the running version is that
  upgrade's from version (a manual rollback whose record was lost). Writes nothing on refusal.
EOF
}

# One message for every command that needs Docker. Doctor calls it and keeps going.
need_docker() {
  command -v docker >/dev/null 2>&1 && return 0
  fail "Docker is not installed (docker not on PATH). Install Docker and rerun this ./qradar-dash command. Nothing was changed."
  return 1
}

install_signal_traps() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

# $1 is the command name. The first sentence is the prefix install and upgrade tests match.
refuse_if_last_upgrade_failed() {
  if [ "$STATE_LAST_PRESENT" = yes ] && [ "$STATE_LAST_OUTCOME" = failed ] \
    && [ -z "$STATE_LAST_RESTORED_FROM" ]; then
    fail "$1 refused: the last upgrade failed; run rollback or restore first. .qradar-dash/state.json last_upgrade.outcome is failed ($STATE_LAST_FROM -> $STATE_LAST_TO, backup ${STATE_LAST_BACKUP:-unset}). If the stack is healthy, run ./qradar-dash repair-state instead of rolling back a good upgrade."
    return 1
  fi
  return 0
}

# ---------------------------------------------------------------- answers

# Keys an answers file may hold. None is a secret: files are named, never read here.
ANSWER_KEYS="PUBLIC_HOSTNAME TLS_CERT_FILE TLS_KEY_FILE EXTERNAL_PROXY FORWARDED_ALLOW_IPS
QRADAR_URL QRADAR_CONSOLE_FQDN QRADAR_API_VERSION QRADAR_TOKEN_FILE QRADAR_CA_FILE
QRADAR_ALLOW_MISSING_AKI INSTANCE_NAME BACKUP_DIR GHCR_USER GHCR_TOKEN_FILE ADMIN_USERNAME
HTTPS_PORT API_LOOPBACK_PORT UI_LOOPBACK_PORT IMAGE_PREFIX SECRETS_VOLUME PROXY_CERTS_VOLUME
EDGE_SUBNET PROXY_EDGE_IP FRONTEND_EDGE_IP PROJECT_NAME HISTORY_BACKFILL"

declare -A ANS=()
ERRORS=()

is_answer_key() {
  local k
  for k in $ANSWER_KEYS; do [ "$k" = "$1" ] && return 0; done
  return 1
}

# check_value KEY VALUE -> prints the reason and returns 1 when VALUE is refused.
# Pure: it reads files to check they are there but writes nothing.
check_value() {
  local key=$1 val=$2
  case "$key" in
    PUBLIC_HOSTNAME)
      [[ $val =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
        || { say "must be a bare host name (no scheme, port or path)"; return 1; } ;;
    TLS_CERT_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'BEGIN CERTIFICATE' "$val" || { say "not a PEM certificate: $val"; return 1; } ;;
    TLS_KEY_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'PRIVATE KEY' "$val" || { say "not a PEM private key: $val"; return 1; } ;;
    EXTERNAL_PROXY | QRADAR_ALLOW_MISSING_AKI | HISTORY_BACKFILL)
      [[ $val =~ ^(yes|no)$ ]] || { say "must be yes or no"; return 1; } ;;
    FORWARDED_ALLOW_IPS)
      [ "$val" != "*" ] || { say "must list the proxy address, not *"; return 1; }
      [[ $val =~ ^[0-9A-Fa-f.:,/\ ]+$ ]] || { say "must be a comma list of addresses"; return 1; } ;;
    QRADAR_URL)
      [[ $val =~ ^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/?$ ]] \
        || { say "must be an https:// URL with a host and no path (plain http is refused)"; return 1; } ;;
    QRADAR_CONSOLE_FQDN)
      [[ $val =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
        || { say "must be a bare host name"; return 1; } ;;
    QRADAR_API_VERSION)
      [[ $val =~ ^[0-9]{1,3}\.[0-9]{1,3}$ ]] || { say "must look like 20.0"; return 1; } ;;
    QRADAR_TOKEN_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      [ -s "$val" ] || { say "file is empty: $val"; return 1; } ;;
    QRADAR_CA_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'BEGIN CERTIFICATE' "$val" || { say "no PEM certificate in: $val"; return 1; } ;;
    INSTANCE_NAME)
      [[ $val =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] \
        || { say "1 to 64 characters: letters, digits, . _ -"; return 1; } ;;
    BACKUP_DIR)
      [[ $val == /* ]] || { say "must be an absolute path"; return 1; }
      case "$val/" in
        "$ROOT"/*) say "must not be inside the checkout ($ROOT)"; return 1 ;;
      esac ;;
    GHCR_USER)
      [[ $val =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || { say "not a registry user name"; return 1; } ;;
    GHCR_TOKEN_FILE)
      [ -r "$val" ] && [ -f "$val" ] && [ -s "$val" ] \
        || { say "file not readable or empty: $val"; return 1; } ;;
    ADMIN_USERNAME)
      [[ $val =~ ^[^[:space:][:cntrl:]]{1,255}$ ]] \
        || { say "1 to 255 characters, no spaces or control characters"; return 1; } ;;
    HTTPS_PORT | API_LOOPBACK_PORT | UI_LOOPBACK_PORT)
      [[ $val =~ ^[0-9]{1,5}$ ]] && [ "$val" -ge 1 ] && [ "$val" -le 65535 ] \
        || { say "not a port number (1-65535)"; return 1; } ;;
    IMAGE_PREFIX)
      [[ $val =~ ^[a-z0-9][a-z0-9._/:-]*$ ]] || { say "not an image name prefix"; return 1; } ;;
    SECRETS_VOLUME | PROXY_CERTS_VOLUME | PROJECT_NAME)
      [[ $val =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] \
        || { say "lower-case letters, digits, _ and - only"; return 1; } ;;
    EDGE_SUBNET)
      [[ $val =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || { say "not an IPv4 CIDR"; return 1; } ;;
    PROXY_EDGE_IP | FRONTEND_EDGE_IP)
      [[ $val =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { say "not an IPv4 address"; return 1; } ;;
  esac
  return 0
}

# parse_answers FILE -> fills ANS. Never sources the file.
parse_answers() {
  local file=$1 mode line key val n=0
  [ -f "$file" ] || { fail "answers file not found: $file"; exit 2; }
  mode=$(stat -c '%a' "$file")
  if [ "$mode" != "600" ] && [ "$mode" != "400" ]; then
    fail "answers file $file has mode $mode; it must be 0600 (chmod 600 $file)"
    exit 2
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ ! $line =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
      ERRORS+=("$file:$n: not KEY=value")
      continue
    fi
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    if [[ $val =~ ^\"(.*)\"$ ]] || [[ $val =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}; fi
    if ! is_answer_key "$key"; then
      if [[ $key =~ (TOKEN|PASSWORD|SECRET|ENCRYPTION|PRIVATE) ]] && [[ ! $key =~ _FILE$ ]]; then
        ERRORS+=("$file:$n: $key looks like a secret; an answers file holds paths, never secrets")
      else
        ERRORS+=("$file:$n: unknown key $key")
      fi
      continue
    fi
    ANS[$key]=$val
  done <"$file"
}

# Defaults for the keys a file may leave out. Order matters: derived values last.
apply_defaults() {
  : "${ANS[EXTERNAL_PROXY]:=no}"
  : "${ANS[QRADAR_API_VERSION]:=20.0}"
  : "${ANS[QRADAR_ALLOW_MISSING_AKI]:=no}"
  : "${ANS[INSTANCE_NAME]:=qradar}"
  : "${ANS[BACKUP_DIR]:=${HOME:-/root}/qradar-dash-backups}"
  : "${ANS[ADMIN_USERNAME]:=admin}"
  : "${ANS[HTTPS_PORT]:=443}"
  : "${ANS[API_LOOPBACK_PORT]:=8000}"
  : "${ANS[UI_LOOPBACK_PORT]:=3000}"
  : "${ANS[IMAGE_PREFIX]:=$DEFAULT_IMAGE_PREFIX}"
  : "${ANS[SECRETS_VOLUME]:=qradar-observability-secrets}"
  : "${ANS[PROXY_CERTS_VOLUME]:=qradar-observability-proxy-certs}"
  : "${ANS[EDGE_SUBNET]:=172.28.10.0/24}"
  : "${ANS[PROXY_EDGE_IP]:=172.28.10.10}"
  : "${ANS[FRONTEND_EDGE_IP]:=$(next_address "${ANS[PROXY_EDGE_IP]}")}"
  : "${ANS[PROJECT_NAME]:=qradar-observability}"
  if [ -z "${ANS[QRADAR_CONSOLE_FQDN]:-}" ] && [ -n "${ANS[QRADAR_URL]:-}" ]; then
    local h=${ANS[QRADAR_URL]#https://}
    h=${h%%/*}
    ANS[QRADAR_CONSOLE_FQDN]=${h%%:*}
  fi
}

# validate_answers MODE -> appends to ERRORS; MODE is pull, build or offline.
validate_answers() {
  local mode=$1 key msg required
  required="PUBLIC_HOSTNAME QRADAR_URL QRADAR_TOKEN_FILE QRADAR_CA_FILE"
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then required="$required TLS_CERT_FILE TLS_KEY_FILE"; fi
  for key in $required; do
    if [ -z "${ANS[$key]:-}" ]; then ERRORS+=("$key: required"); fi
  done
  for key in $ANSWER_KEYS; do
    [ -n "${ANS[$key]:-}" ] || continue
    if [ "${ANS[EXTERNAL_PROXY]}" = "yes" ] && [[ $key == TLS_*_FILE ]]; then continue; fi
    if msg=$(check_value "$key" "${ANS[$key]}"); then :; else ERRORS+=("$key: $msg"); fi
  done
  if [ -n "${ANS[GHCR_TOKEN_FILE]:-}" ] && [ -z "${ANS[GHCR_USER]:-}" ]; then
    ERRORS+=("GHCR_USER: required with GHCR_TOKEN_FILE")
  fi
  if [ "$mode" = "pull" ] && [ -n "${ANS[GHCR_USER]:-}" ] && [ -z "${ANS[GHCR_TOKEN_FILE]:-}" ] \
    && [ ! -s .secrets/ghcr.token ]; then
    ERRORS+=("GHCR_TOKEN_FILE: required with GHCR_USER")
  fi
  # Ports must be distinct, or compose publishes two services on one port.
  local seen=" "
  for key in API_LOOPBACK_PORT UI_LOOPBACK_PORT; do
    if [[ $seen == *" ${ANS[$key]} "* ]]; then ERRORS+=("$key: port ${ANS[$key]} is used twice"); fi
    seen="$seen${ANS[$key]} "
  done
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ] && [[ $seen == *" ${ANS[HTTPS_PORT]} "* ]]; then
    ERRORS+=("HTTPS_PORT: port ${ANS[HTTPS_PORT]} is used twice")
  fi
}

report_errors_and_exit() {
  local e
  [ "${#ERRORS[@]}" -gt 0 ] || return 0
  fail "the answers are refused; nothing was written:"
  for e in "${ERRORS[@]}"; do printf '       %s\n' "$e" >&2; done
  exit 2
}

# ---------------------------------------------------------------- wizard

ask() { # ask KEY "question" [hint]
  local key=$1 question=$2 hint=${3:-} def=${ANS[$1]:-} reply msg
  while true; do
    if [ -n "$hint" ]; then say "    $hint"; fi
    if [ -n "$def" ]; then printf '%s [%s]: ' "$question" "$def"; else printf '%s: ' "$question"; fi
    IFS= read -r reply || die "input ended before the wizard finished"
    reply=${reply:-$def}
    if [ -z "$reply" ]; then
      case "$key" in
        GHCR_USER | GHCR_TOKEN_FILE | FORWARDED_ALLOW_IPS) ANS[$key]=""; return 0 ;;
      esac
      say "    an answer is required"
      continue
    fi
    reply=${reply/#\~/$HOME}
    if msg=$(check_value "$key" "$reply"); then ANS[$key]=$reply; return 0; fi
    say "    $msg"
  done
}

wizard() {
  local mode=$1
  say ""
  say "QRadar Dash installer. LDAP is not asked here: set it up in the UI afterwards."
  say ""
  ask PUBLIC_HOSTNAME "1. Public host name analysts will type" \
    "Becomes PUBLIC_ORIGIN=https://<name>. Production refuses any other shape."
  if [ "$FLAG_EXTERNAL_PROXY" = "yes" ]; then
    ANS[EXTERNAL_PROXY]=yes
  else
    ask EXTERNAL_PROXY "3. Use your own TLS proxy instead of the bundled one? (yes/no)" \
      "Default no: the bundled nginx terminates TLS on 443."
  fi
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    ask TLS_CERT_FILE "2. TLS certificate file (PEM) for that name"
    ask TLS_KEY_FILE "   TLS private key file (PEM)"
  else
    say "2. External proxy chosen: no certificate is needed here. Run your own TLS proxy to"
    say "   127.0.0.1:${ANS[API_LOOPBACK_PORT]:-8000} (/api/) and 127.0.0.1:${ANS[UI_LOOPBACK_PORT]:-3000}"
    say "   (everything else), and set FORWARDED_ALLOW_IPS in .env to the peer address uvicorn sees"
    say "   (README, 'Proxy headers and the rate limiter'). The frontend's own address is added to it"
    say "   for you: the pages the server draws are counted under the analyst's address."
    say "   Your proxy must APPEND the client address to X-Forwarded-For (nginx: \$proxy_add_x_forwarded_for)."
  fi
  ask QRADAR_URL "4. QRadar base URL (https://...)"
  ask QRADAR_CONSOLE_FQDN "5. QRadar console FQDN (bare host name)" \
    "Used by the MCP profile only; asked now so a later enable has the value."
  ask QRADAR_API_VERSION "6. QRadar API version" \
    "Default 20.0. The lab console in the README uses 29.0. Not guessed."
  ask QRADAR_TOKEN_FILE "7. Path to the file holding the SEC token" \
    "It is copied to .secrets/qradar.sec (0600). The token is never typed or put in .env."
  ask QRADAR_CA_FILE "8. Path to the QRadar CA bundle (root + intermediate)"
  ask QRADAR_ALLOW_MISSING_AKI "9. Accept a QRadar certificate without an Authority Key Identifier? (yes/no)" \
    "Only if the TLS check fails with 'Missing Authority Key Identifier' (runbook symptom 3)."
  ask INSTANCE_NAME "10. Instance name"
  ask BACKUP_DIR "11. Backup directory (absolute, outside this checkout)"
  if [ "$mode" = "pull" ]; then
    ask GHCR_USER "12. Registry user name (empty if the images are public)"
    if [ -n "${ANS[GHCR_USER]:-}" ]; then ask GHCR_TOKEN_FILE "    Path to the read:packages token file"; fi
  fi
  ask ADMIN_USERNAME "13. Break-glass admin user name" "The password is generated and shown once."
  # Asked once: never when the key is already set (a saved answer, also under --reconfigure),
  # and never on a site that has a state file (it was installed before this question existed).
  if [ -z "${ANS[HISTORY_BACKFILL]:-}" ] && [ ! -e .qradar-dash/state.json ] \
    && [ ! -L .qradar-dash/state.json ]; then
    say "    Nothing in the past raises an alert. It sends searches to QRadar for about 3 hours on"
    say "    a small estate and up to 3 days on a large one (a large estate gets a shorter window"
    say "    so that it fits 72 hours); the admin page shows the progress and the estimate."
    ask HISTORY_BACKFILL "14. Read the last 28 days of history from QRadar now, so baselines are steadier from day 1? (yes/no)"
  fi
}

# ---------------------------------------------------------------- preflight

CPU_MIN=4
MEM_MIN_KB=7864320 # 7.5 GiB: a nominal 8 GiB host reports slightly less
DISK_MIN_KB=$((80 * 1024 * 1024))
BACKUP_MIN_KB=$((20 * 1024 * 1024))
COMPOSE_MIN="2.24"

version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

free_kb() { # free space of the nearest existing parent of $1
  local p=$1
  while [ ! -e "$p" ] && [ "$p" != "/" ]; do p=$(dirname "$p"); done
  df -Pk "$p" 2>/dev/null | awk 'NR==2 {print $4}'
}

port_free() { ! ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }

preflight_host() {
  local bad=0 arch cv mem cpus root free
  need_docker || exit 1
  docker version >/dev/null 2>&1 || die "Docker is installed but 'docker version' failed (daemon down or no permission). Nothing was written."
  cv=$(docker compose version --short 2>/dev/null) || die "Docker Compose v2 is required ('docker compose version' failed). The script does not call docker-compose."
  cv=${cv#v}
  version_ge "$cv" "$COMPOSE_MIN" || die "Docker Compose $cv is too old; $COMPOSE_MIN or newer is required."
  info "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null), compose $cv"
  for tool in openssl curl ss tar sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || { fail "'$tool' is required on the host"; bad=1; }
  done
  arch=$(uname -m)
  if [ "$arch" = "x86_64" ]; then info "architecture $arch"; else fail "architecture $arch; the images are x86_64 only"; bad=1; fi
  cpus=$(nproc)
  if [ "$cpus" -ge "$CPU_MIN" ]; then info "$cpus CPUs"; else fail "$cpus CPUs; at least $CPU_MIN are required"; bad=1; fi
  # QRADAR_DASH_MEMINFO_FILE exists for the tests, so they run on a host of any size.
  mem=$(awk '/^MemTotal:/ {print $2}' "${QRADAR_DASH_MEMINFO_FILE:-/proc/meminfo}")
  if [ "$mem" -ge "$MEM_MIN_KB" ]; then info "RAM $((mem / 1024 / 1024)) GiB"; else fail "RAM $((mem / 1024 / 1024)) GiB; at least 8 GiB is required"; bad=1; fi
  root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)
  free=""
  if [ -n "$root" ]; then free=$(free_kb "$root" || true); fi
  if [ -z "$free" ] || [ ! -d "$root" ]; then
    warn "cannot read the free space of the Docker root (${root:-unknown}); check 80 GiB by hand"
  elif [ "$free" -ge "$DISK_MIN_KB" ]; then
    info "$((free / 1024 / 1024)) GiB free on the Docker root ($root)"
  else
    fail "$((free / 1024 / 1024)) GiB free on the Docker root ($root); at least 80 GiB is required"; bad=1
  fi
  if command -v getenforce >/dev/null 2>&1; then
    info "SELinux: $(getenforce) (left as it is; secrets go through deploy/load-secrets.sh)"
  else
    info "SELinux: not present"
  fi
  if command -v timedatectl >/dev/null 2>&1; then
    if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo no)" = "yes" ]; then
      info "clock is NTP-synchronised ($(date -u '+%Y-%m-%d %H:%M UTC'), zone $(date '+%Z'))"
    else
      warn "the clock is not NTP-synchronised; collection watermarks and sessions use UTC"
    fi
  else
    warn "timedatectl not found; check the clock by hand"
  fi
  [ "$bad" -eq 0 ] || { fail "preflight failed; nothing was written."; exit 1; }
}

stack_running() {
  [ -f "$ENV_FILE" ] || return 1
  [ -n "$(dc ps --status running -q 2>/dev/null || true)" ]
}

preflight_network() {
  local bad=0 p backup_free url host port out
  if stack_running; then
    info "this stack is already running; its published ports are not re-checked"
  else
    local ports="${ANS[API_LOOPBACK_PORT]} ${ANS[UI_LOOPBACK_PORT]}"
    if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then ports="${ANS[HTTPS_PORT]} $ports"; fi
    for p in $ports; do
      if port_free "$p"; then info "port $p is free"; else fail "port $p is already in use"; bad=1; fi
    done
  fi
  local dir_ok=yes
  if [ -e "${ANS[BACKUP_DIR]}" ] && [ ! -d "${ANS[BACKUP_DIR]}" ]; then
    fail "${ANS[BACKUP_DIR]} exists and is not a directory"; bad=1; dir_ok=no
  elif [ -d "${ANS[BACKUP_DIR]}" ]; then
    if [ ! -w "${ANS[BACKUP_DIR]}" ] || [ ! -x "${ANS[BACKUP_DIR]}" ]; then
      fail "the backup directory ${ANS[BACKUP_DIR]} is not writable by this account; give it to this account (see docs/OPERATIONS.md, Kurulum)"; bad=1; dir_ok=no
    fi
  elif [ ! -e "${ANS[BACKUP_DIR]}" ]; then
    local parent=${ANS[BACKUP_DIR]}
    while [ ! -e "$parent" ] && [ "$parent" != "/" ]; do parent=$(dirname "$parent"); done
    if [ ! -d "$parent" ] || [ ! -w "$parent" ] || [ ! -x "$parent" ]; then
      fail "cannot create the backup directory ${ANS[BACKUP_DIR]}: $parent is not writable by this account; create it first (see docs/OPERATIONS.md, Kurulum)"; bad=1; dir_ok=no
    fi
  fi
  # Free space is reported only for a directory the checks above accepted.
  if [ "$dir_ok" = yes ]; then
    backup_free=$(free_kb "${ANS[BACKUP_DIR]}" || true)
    if [ -z "$backup_free" ]; then
      warn "cannot read the free space of ${ANS[BACKUP_DIR]}"
    elif [ "$backup_free" -lt "$BACKUP_MIN_KB" ]; then
      fail "$((backup_free / 1024 / 1024)) GiB free for backups at ${ANS[BACKUP_DIR]}; at least 20 GiB is required"; bad=1
    else
      info "$((backup_free / 1024 / 1024)) GiB free for backups at ${ANS[BACKUP_DIR]}"
    fi
  fi
  local root_dev backup_dev
  root_dev=$(stat -c %d "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" 2>/dev/null || true)
  backup_dev=$(stat -c %d "$(dirname "${ANS[BACKUP_DIR]}")" 2>/dev/null || true)
  if [ -n "$root_dev" ] && [ "$root_dev" = "$backup_dev" ]; then
    warn "the backup directory and the Docker data root share a device; a dead disk loses both"
  fi
  if [ "$FLAG_SKIP_QRADAR" = "yes" ]; then
    warn "QRadar TLS check skipped (--skip-qradar-check)"
  elif ! command -v openssl >/dev/null 2>&1; then
    warn "openssl missing; QRadar TLS check skipped"
  else
    url=${ANS[QRADAR_URL]#https://}
    url=${url%%/*}
    host=${url%%:*}
    port=443
    if [[ $url == *:* ]]; then port=${url##*:}; fi
    # A handshake only: no token and no AQL are sent.
    out=$(timeout 15 openssl s_client -connect "$host:$port" -servername "$host" \
      -CAfile "${ANS[QRADAR_CA_FILE]}" -verify_return_error </dev/null 2>&1 || true)
    if grep -q 'Verify return code: 0' <<<"$out"; then
      info "QRadar $host:$port presents a certificate the CA bundle verifies"
    elif grep -q 'Authority Key Identifier' <<<"$out"; then
      warn "QRadar $host:$port certificate has no Authority Key Identifier; see runbook symptom 3 (QRADAR_ALLOW_MISSING_AKI)"
    elif grep -q 'verify error' <<<"$out"; then
      fail "QRadar $host:$port certificate does not verify against ${ANS[QRADAR_CA_FILE]}: $(grep -m1 'verify error' <<<"$out")"
      bad=1
    else
      warn "QRadar $host:$port is not reachable from this host; the install continues and records the check as FAIL"
    fi
  fi
  [ "$bad" -eq 0 ] || { fail "preflight failed; nothing was written."; exit 1; }
}

# ---------------------------------------------------------------- compose helpers

PROJECT=qradar-observability

set_compose_args() {
  COMPOSE_ARGS=(-f docker-compose.yml -f docker-compose.prod.yml)
  if [ -f docker-compose.override.yml ]; then
    COMPOSE_ARGS+=(-f docker-compose.override.yml)
  fi
}

dc() {
  local -a COMPOSE_ARGS=()
  set_compose_args
  docker compose -p "$PROJECT" "${COMPOSE_ARGS[@]}" "$@"
}

compose_command() {
  local -a COMPOSE_ARGS=()
  set_compose_args
  printf 'docker compose -p %s' "$PROJECT"
  printf ' %s' "${COMPOSE_ARGS[@]}"
}

compose_file_value() {
  printf 'docker-compose.yml:docker-compose.prod.yml'
  [ ! -f docker-compose.override.yml ] || printf ':docker-compose.override.yml'
}

report_compose_override() {
  [ ! -f docker-compose.override.yml ] \
    || info "docker-compose.override.yml is in use; run ./qradar-dash doctor to verify the stack"
}

env_get() { # env_get KEY -> value from .env, or empty
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | head -n1
}

env_has_key() { # env_has_key KEY
  [ -f "$ENV_FILE" ] && grep -q "^$1=" "$ENV_FILE"
}

read_checkout_version() {
  local retry=${1:-install} version
  if [ ! -r VERSION ]; then
    die "VERSION is missing or unreadable; this checkout is incomplete; restore VERSION and run ./qradar-dash $retry again"
  fi
  version=$(tr -d '[:space:]' <VERSION)
  [ -n "$version" ] \
    || die "VERSION is empty; this checkout is incomplete; restore VERSION and run ./qradar-dash $retry again"
  printf '%s\n' "$version"
}

load_project_from_env() {
  local p=${QRADAR_DASH_PROJECT:-}
  [ -n "$p" ] || p=$(env_get COMPOSE_PROJECT_NAME)
  [ -z "$p" ] || PROJECT=$p
}

# ---------------------------------------------------------------- install steps

write_secrets_dir() {
  umask 077
  mkdir -p .secrets
  chmod 700 .secrets
  copy_secret "${ANS[QRADAR_TOKEN_FILE]}" .secrets/qradar.sec
  copy_secret "${ANS[QRADAR_CA_FILE]}" .secrets/qradar-ca.pem
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    copy_secret "${ANS[TLS_CERT_FILE]}" .secrets/tls.crt
    copy_secret "${ANS[TLS_KEY_FILE]}" .secrets/tls.key
  fi
  if [ -n "${ANS[GHCR_TOKEN_FILE]:-}" ]; then copy_secret "${ANS[GHCR_TOKEN_FILE]}" .secrets/ghcr.token; fi
}

copy_secret() { # copy_secret SRC DST, mode 0600, skipped when they are the same file
  if [ -e "$2" ] && [ "$1" -ef "$2" ]; then chmod 600 "$2"; return 0; fi
  install -m 600 "$1" "$2"
}

save_answers() {
  local key f=$SAVED_ANSWERS.tmp
  umask 077
  {
    say "# Written by ./qradar-dash install. Paths and names only; no secret is stored here."
    for key in $ANSWER_KEYS; do
      [ -n "${ANS[$key]:-}" ] && printf '%s=%s\n' "$key" "${ANS[$key]}"
    done
  } >"$f"
  chmod 600 "$f"
  mv "$f" "$SAVED_ANSWERS"
}

next_address() { # next_address A.B.C.D -> A.B.C.(D+1); the input again when D is 254 or more
  local ip=$1 last
  [[ $ip =~ ^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3})\.([0-9]{1,3})$ ]] || { printf '%s\n' "$ip"; return 0; }
  last=$((10#${BASH_REMATCH[2]}))
  if [ "$last" -ge 254 ]; then printf '%s\n' "$ip"; return 0; fi
  printf '%s.%s\n' "${BASH_REMATCH[1]}" "$((last + 1))"
}

forwarded_with_frontend() { # forwarded_with_frontend LIST ADDRESS -> LIST with ADDRESS once; "*" and empty stay
  local list=$1 address=$2 item
  [ -n "$list" ] && [ "$list" != "*" ] || { printf '%s\n' "$list"; return 0; }
  for item in ${list//,/ }; do
    if [ "$item" = "$address" ]; then printf '%s\n' "$list"; return 0; fi
  done
  printf '%s,%s\n' "$list" "$address"
}

installer_env_key() {
  case "$1" in
    ENVIRONMENT | DEBUG | LOG_LEVEL | AUTH_PROVIDER | PUBLIC_ORIGIN | SECRET_KEY | \
      ENCRYPTION_KEY | ENCRYPTION_KEY_VERSION | ENCRYPTION_KEYS_JSON | POSTGRES_USER | \
      POSTGRES_PASSWORD | POSTGRES_DB | POSTGRES_HOST | QRADAR_PROVIDER | QRADAR_BASE_URL | \
      QRADAR_CONSOLE_FQDN | QRADAR_API_VERSION | QRADAR_VERIFY_SSL | QRADAR_API_TOKEN_FILE | \
      QRADAR_CA_BUNDLE | QRADAR_TLS_ALLOW_MISSING_AKI | NEXT_PUBLIC_API_BASE_URL | \
      INTERNAL_API_BASE_URL | RETENTION_ENABLED | RETENTION_LOG_SOURCE_METRIC_DAYS | \
      RETENTION_SEARCH_RESULT_METRIC_DAYS | RETENTION_RULE_METRIC_DAYS | \
      RETENTION_OFFENSE_SNAPSHOT_DAYS | COMPRESSION_AFTER_DAYS | FORWARDED_ALLOW_IPS | \
      LLM_ENABLED | LLM_ALLOW_AUTONOMOUS_ACTIONS | MCP_ENABLED | COMPOSE_PROJECT_NAME | \
      COMPOSE_FILE | COMPOSE_PROFILES | QRADAR_DASH_VERSION | QRADAR_DASH_IMAGE_PREFIX | \
      QRADAR_DASH_BACKUP_DIR | SECRETS_VOLUME | PROXY_CERTS_VOLUME | HTTPS_PORT | \
      API_LOOPBACK_PORT | UI_LOOPBACK_PORT | EDGE_SUBNET | PROXY_EDGE_IP | FRONTEND_EDGE_IP) return 0 ;;
    *) return 1 ;;
  esac
}

env_or_default() { # env_or_default KEY DEFAULT
  if env_has_key "$1"; then env_get "$1"; else printf '%s\n' "$2"; fi
}

warn_invariant_change() { # warn_invariant_change KEY REQUIRED_VALUE
  local old
  env_has_key "$1" || return 0
  old=$(env_get "$1")
  [ "$old" = "$2" ] || warn "$1 was '$old' and is enforced as '$2'; run ./qradar-dash doctor after install"
}

join_names() {
  local joined="" name
  for name in "$@"; do
    if [ -n "$joined" ]; then joined="$joined, $name"; else joined=$name; fi
  done
  printf '%s\n' "$joined"
}

write_env() { # write_env ENCRYPTION_KEY
  local enc=$1 secret_key pg_pass fwd origin profiles version compose_files old_exists=no
  local encryption_keys encryption_version log_level auth_provider retention_enabled
  local retention_log retention_search retention_rule retention_offense compression llm_enabled
  local mcp_enabled line key name old_profiles extra_profiles="" old_had_proxy=no
  local -a kept_operator=() kept_secrets=() extra_lines=()
  local -A seen_extra=()
  [ ! -f "$ENV_FILE" ] || old_exists=yes

  if env_has_key SECRET_KEY && [ -n "$(env_get SECRET_KEY)" ]; then
    secret_key=$(env_get SECRET_KEY)
    kept_secrets+=(SECRET_KEY)
  else
    secret_key=$(openssl rand -base64 48 | tr -d '\n')
  fi
  # hex, not base64: the password is spliced into a database URL unescaped, and a
  # '/' or '+' from base64 would break it (backend/app/core/config.py database_url).
  if env_has_key POSTGRES_PASSWORD && [ -n "$(env_get POSTGRES_PASSWORD)" ]; then
    pg_pass=$(env_get POSTGRES_PASSWORD)
    kept_secrets+=(POSTGRES_PASSWORD)
  else
    pg_pass=$(openssl rand -hex 24)
  fi
  if env_has_key ENCRYPTION_KEY && [ -n "$(env_get ENCRYPTION_KEY)" ]; then
    enc=$(env_get ENCRYPTION_KEY)
    kept_secrets+=(ENCRYPTION_KEY)
  fi
  if env_has_key ENCRYPTION_KEYS_JSON; then
    encryption_keys=$(env_get ENCRYPTION_KEYS_JSON)
    kept_secrets+=(ENCRYPTION_KEYS_JSON)
  else
    encryption_keys=""
  fi
  if env_has_key ENCRYPTION_KEY_VERSION; then
    encryption_version=$(env_get ENCRYPTION_KEY_VERSION)
    kept_secrets+=(ENCRYPTION_KEY_VERSION)
  else
    encryption_version=1
  fi

  log_level=$(env_or_default LOG_LEVEL INFO)
  auth_provider=$(env_or_default AUTH_PROVIDER session)
  retention_enabled=$(env_or_default RETENTION_ENABLED true)
  retention_log=$(env_or_default RETENTION_LOG_SOURCE_METRIC_DAYS 90)
  retention_search=$(env_or_default RETENTION_SEARCH_RESULT_METRIC_DAYS 90)
  retention_rule=$(env_or_default RETENTION_RULE_METRIC_DAYS 90)
  retention_offense=$(env_or_default RETENTION_OFFENSE_SNAPSHOT_DAYS 90)
  compression=$(env_or_default COMPRESSION_AFTER_DAYS 7)
  llm_enabled=$(env_or_default LLM_ENABLED false)
  mcp_enabled=$(env_or_default MCP_ENABLED false)
  for key in LOG_LEVEL AUTH_PROVIDER RETENTION_ENABLED RETENTION_LOG_SOURCE_METRIC_DAYS \
    RETENTION_SEARCH_RESULT_METRIC_DAYS RETENTION_RULE_METRIC_DAYS \
    RETENTION_OFFENSE_SNAPSHOT_DAYS COMPRESSION_AFTER_DAYS LLM_ENABLED MCP_ENABLED; do
    env_has_key "$key" && kept_operator+=("$key")
  done

  if [ -f "$ENV_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      [[ $line =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]] || continue
      key=${BASH_REMATCH[1]}
      if ! installer_env_key "$key" && [ -z "${seen_extra[$key]:-}" ]; then
        extra_lines+=("$line")
        kept_operator+=("$key")
        seen_extra[$key]=yes
      fi
    done <"$ENV_FILE"
  fi

  # The wizard owns 'proxy'. Any other profile an operator added (mcp in practice) is kept.
  old_profiles=$(env_get COMPOSE_PROFILES)
  for name in ${old_profiles//,/ }; do
    [ "$name" != proxy ] || { old_had_proxy=yes; continue; }
    case ",$extra_profiles," in *",$name,"*) continue ;; esac
    extra_profiles=${extra_profiles:+$extra_profiles,}$name
  done

  fwd=${ANS[FORWARDED_ALLOW_IPS]:-}
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    fwd=${ANS[PROXY_EDGE_IP]}
    profiles=proxy${extra_profiles:+,$extra_profiles}
    origin="https://${ANS[PUBLIC_HOSTNAME]}"
    if [ "${ANS[HTTPS_PORT]}" != "443" ]; then origin="$origin:${ANS[HTTPS_PORT]}"; fi
  else
    profiles=$extra_profiles
    origin="https://${ANS[PUBLIC_HOSTNAME]}"
    # Keep an earlier external-proxy value, never the bundled proxy address of a previous mode.
    if [ -z "$fwd" ] && [ "$old_had_proxy" = no ]; then fwd=$(env_get FORWARDED_ALLOW_IPS); fi
  fi
  # The frontend is the second trusted forwarder: its server-rendered reads carry the analyst's
  # address (frontend/src/lib/api.ts). An empty value stays empty so step 10 can refuse it.
  fwd=$(forwarded_with_frontend "$fwd" "${ANS[FRONTEND_EDGE_IP]}")
  version=$(read_checkout_version)
  compose_files=$(compose_file_value)
  warn_invariant_change ENVIRONMENT production
  warn_invariant_change DEBUG false
  warn_invariant_change QRADAR_PROVIDER rest
  warn_invariant_change QRADAR_VERIFY_SSL true
  warn_invariant_change QRADAR_API_TOKEN_FILE /run/secrets/qradar_sec_token
  warn_invariant_change QRADAR_CA_BUNDLE /run/secrets/qradar_ca.pem
  warn_invariant_change POSTGRES_USER qradar_obs
  warn_invariant_change POSTGRES_DB qradar_obs
  warn_invariant_change POSTGRES_HOST postgres
  warn_invariant_change NEXT_PUBLIC_API_BASE_URL /api/v1
  warn_invariant_change INTERNAL_API_BASE_URL http://backend:8000/api/v1
  warn_invariant_change LLM_ALLOW_AUTONOMOUS_ACTIONS false
  umask 077
  cat >"$ENV_FILE.tmp" <<EOF
# Written by ./qradar-dash install. Mode 0600. Secret keys are kept on re-runs.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=$log_level
AUTH_PROVIDER=$auth_provider
PUBLIC_ORIGIN=$origin
SECRET_KEY=$secret_key
ENCRYPTION_KEY=$enc
ENCRYPTION_KEY_VERSION=$encryption_version
ENCRYPTION_KEYS_JSON=$encryption_keys
POSTGRES_USER=qradar_obs
POSTGRES_PASSWORD=$pg_pass
POSTGRES_DB=qradar_obs
POSTGRES_HOST=postgres
QRADAR_PROVIDER=rest
QRADAR_BASE_URL=${ANS[QRADAR_URL]%/}
QRADAR_CONSOLE_FQDN=${ANS[QRADAR_CONSOLE_FQDN]}
QRADAR_API_VERSION=${ANS[QRADAR_API_VERSION]}
QRADAR_VERIFY_SSL=true
QRADAR_API_TOKEN_FILE=/run/secrets/qradar_sec_token
QRADAR_CA_BUNDLE=/run/secrets/qradar_ca.pem
QRADAR_TLS_ALLOW_MISSING_AKI=$([ "${ANS[QRADAR_ALLOW_MISSING_AKI]}" = yes ] && echo true || echo false)
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
RETENTION_ENABLED=$retention_enabled
RETENTION_LOG_SOURCE_METRIC_DAYS=$retention_log
RETENTION_SEARCH_RESULT_METRIC_DAYS=$retention_search
RETENTION_RULE_METRIC_DAYS=$retention_rule
RETENTION_OFFENSE_SNAPSHOT_DAYS=$retention_offense
COMPRESSION_AFTER_DAYS=$compression
FORWARDED_ALLOW_IPS=$fwd
LLM_ENABLED=$llm_enabled
LLM_ALLOW_AUTONOMOUS_ACTIONS=false
MCP_ENABLED=$mcp_enabled
COMPOSE_PROJECT_NAME=${ANS[PROJECT_NAME]}
# So a bare 'docker compose' in this directory uses the production overlay too (./qradar-dash passes -f itself).
COMPOSE_FILE=$compose_files
COMPOSE_PROFILES=$profiles
QRADAR_DASH_VERSION=$version
QRADAR_DASH_IMAGE_PREFIX=${ANS[IMAGE_PREFIX]}
QRADAR_DASH_BACKUP_DIR=${ANS[BACKUP_DIR]}
SECRETS_VOLUME=${ANS[SECRETS_VOLUME]}
PROXY_CERTS_VOLUME=${ANS[PROXY_CERTS_VOLUME]}
HTTPS_PORT=${ANS[HTTPS_PORT]}
API_LOOPBACK_PORT=${ANS[API_LOOPBACK_PORT]}
UI_LOOPBACK_PORT=${ANS[UI_LOOPBACK_PORT]}
EDGE_SUBNET=${ANS[EDGE_SUBNET]}
PROXY_EDGE_IP=${ANS[PROXY_EDGE_IP]}
FRONTEND_EDGE_IP=${ANS[FRONTEND_EDGE_IP]}
EOF
  if [ "${#extra_lines[@]}" -gt 0 ]; then
    say "# Kept from the previous .env (not written by ./qradar-dash install)" >>"$ENV_FILE.tmp"
    printf '%s\n' "${extra_lines[@]}" >>"$ENV_FILE.tmp"
  fi
  chmod 600 "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
  if [ "$old_exists" = no ]; then
    ENV_WRITE_STATUS="first install: new .env"
  else
    ENV_WRITE_STATUS="kept operator keys: $(join_names "${kept_operator[@]}"); kept secrets: $(join_names "${kept_secrets[@]}")"
    [ -z "$extra_profiles" ] || ENV_WRITE_STATUS="$ENV_WRITE_STATUS; kept profiles: ${extra_profiles//,/, }"
  fi
}

get_images() { # get_images MODE OFFLINE_BUNDLE
  local mode=$1 bundle=${2:-} svc="postgres redis backend frontend"
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then svc="$svc proxy"; fi
  case "$mode" in
    build)
      say "Building the images from this checkout (the first build takes several minutes)..."
      # Stamp the build with the commit; unset (not an error) outside a git checkout. Never in .env.
      if GIT_SHA=$(git rev-parse HEAD 2>/dev/null) && [ -n "$GIT_SHA" ]; then export GIT_SHA; else unset GIT_SHA; fi
      # shellcheck disable=SC2086 # word splitting of the service list is intended
      dc build ${svc/redis /} || die "docker compose build failed"
      # redis is not built; the plain image is pulled when it is not present.
      dc pull redis || warn "could not pull redis; compose will try again at start"
      ;;
    offline)
      bundle_load "$bundle"
      ;;
    pull)
      if [ -s .secrets/ghcr.token ] && [ -n "${ANS[GHCR_USER]:-}" ]; then
        docker login ghcr.io --username "${ANS[GHCR_USER]}" --password-stdin <.secrets/ghcr.token \
          || die "docker login ghcr.io failed"
      fi
      # shellcheck disable=SC2086
      if ! dc pull $svc; then
        die "docker compose pull failed. A private registry needs a read:packages token: set GHCR_USER and GHCR_TOKEN_FILE (it is stored as .secrets/ghcr.token)."
      fi
      ;;
  esac
}

# ---------------------------------------------------------------- offline bundle

# The redis reference is read from the production compose file, never written down a second time.
redis_ref() {
  local ref
  ref=$(sed -n 's/^[[:space:]]*image:[[:space:]]*\(redis:[^[:space:]@]*@sha256:[0-9a-f]\{64\}\)[[:space:]]*$/\1/p' \
    docker-compose.prod.yml 2>/dev/null | head -n1 || true)
  [ -n "$ref" ] || return 1
  printf '%s\n' "$ref"
}

# The image that reads the secrets volumes for the backup: the same digest-pinned
# alpine that loads them. Written once in deploy/load-secrets.sh and read from
# there, the way redis_ref reads the production compose file.
secrets_helper_image() {
  local ref
  ref=$(sed -n 's/^[[:space:]]*SECRETS_HELPER_IMAGE=\(alpine:[^[:space:]@]*@sha256:[0-9a-f]\{64\}\)[[:space:]]*$/\1/p' \
    deploy/load-secrets.sh 2>/dev/null | head -n1 || true)
  [ -n "$ref" ] || return 1
  printf '%s\n' "$ref"
}

# The compose services the bundle carries as version-tagged images. Redis and the
# secrets helper are digest-pinned references, not services, and follow below.
BUNDLE_SERVICES=(postgres backend frontend proxy qradar-mcp)

bundle_image_refs() { # bundle_image_refs PREFIX VERSION -> the image references, one per line
  local prefix=$1 version=$2 service ref
  for service in "${BUNDLE_SERVICES[@]}"; do
    printf '%s/%s:%s\n' "$prefix" "$service" "$version"
  done
  ref=$(redis_ref) \
    || die "docker-compose.prod.yml has no redis image pinned by digest (redis:TAG@sha256:...); this checkout is incomplete; restore docker-compose.prod.yml and run ./qradar-dash bundle again"
  printf '%s\n' "$ref"
  # The offline host runs load-secrets.sh and the backup's secrets tar with this
  # image and cannot pull it, so the bundle carries it too.
  ref=$(secrets_helper_image) \
    || die "deploy/load-secrets.sh has no SECRETS_HELPER_IMAGE pinned by digest (alpine:TAG@sha256:...); this checkout is incomplete; restore deploy/load-secrets.sh and run ./qradar-dash bundle again"
  printf '%s\n' "$ref"
}

user_path() { # user_path PATH -> absolute, a relative PATH being relative to where the operator ran the script
  case "$1" in /*) printf '%s\n' "$1" ;; *) printf '%s/%s\n' "$ORIG_PWD" "$1" ;; esac
}

BUNDLE_STAGE=""
BUNDLE_PARTIAL=""
BUNDLE_DONE=no
BUNDLE_OUT=""

bundle_cleanup() {
  [ -z "$BUNDLE_STAGE" ] || rm -rf -- "$BUNDLE_STAGE"
  [ -z "$BUNDLE_PARTIAL" ] || rm -f -- "$BUNDLE_PARTIAL"
  if [ "$BUNDLE_DONE" != yes ]; then
    warn "bundle not written: no partial bundle was left in $BUNDLE_OUT; fix the cause above and run ./qradar-dash bundle again"
  fi
}

cmd_bundle() {
  local version="" out="" checkout prefix source ref id bytes target name member
  while [ $# -gt 0 ]; do
    case "$1" in
      --version) [ $# -ge 2 ] || { fail "--version needs a release such as 0.2.0"; return 2; }; version=$2; shift ;;
      --output) [ $# -ge 2 ] || { fail "--output needs a directory"; return 2; }; out=$2; shift ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown bundle option: $1; usage: ./qradar-dash bundle [--version X.Y.Z] [--output DIR]"; return 2 ;;
    esac
    shift
  done
  need_docker || exit 1
  checkout=$(read_checkout_version bundle)
  if [ -n "$version" ]; then
    valid_release_version "$version" || {
      fail "bundle version must be plain SemVer (MAJOR.MINOR.PATCH), not $version"
      return 2
    }
    if [ "$version" != "$checkout" ]; then
      fail "bundle refused: this checkout is version $checkout, not $version; run git fetch --tags && git checkout v$version first, then ./qradar-dash bundle again"
      return 1
    fi
  fi
  version=$checkout
  valid_release_version "$version" || die "VERSION holds '$version', not plain SemVer (MAJOR.MINOR.PATCH); this checkout is incomplete; restore VERSION and run ./qradar-dash bundle again"
  out=$(user_path "${out:-.}")
  BUNDLE_OUT=$out
  [ -d "$out" ] && [ -w "$out" ] \
    || die "bundle output directory $out does not exist or is not writable; run mkdir -p $out, or pass --output DIR"
  name=qradar-dash-$version-bundle.tar
  target=$out/$name
  if [ -e "$target" ] || [ -L "$target" ]; then
    die "bundle refused: $target already exists and is not overwritten; move or delete it, or pass --output DIR"
  fi
  for member in qradar-dash docker-compose.yml docker-compose.prod.yml "docs/releases/$version.md"; do
    [ -f "$member" ] || die "bundle refused: $member is missing from this checkout; restore it (git checkout v$version) and run ./qradar-dash bundle again"
  done
  [ -d deploy ] || die "bundle refused: deploy/ is missing from this checkout; restore it (git checkout v$version) and run ./qradar-dash bundle again"

  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  if [ -n "$prefix" ]; then source="QRADAR_DASH_IMAGE_PREFIX in .env"; else prefix=$DEFAULT_IMAGE_PREFIX; source="the default; no QRADAR_DASH_IMAGE_PREFIX in .env"; fi
  say "Bundle $version, image prefix $prefix ($source)"
  local -a refs=()
  mapfile -t refs < <(bundle_image_refs "$prefix" "$version")
  # the BUNDLE_SERVICES images plus the two digest pins bundle_image_refs appends
  # (redis and the secrets helper); derived from the list, so the next service
  # needs no edit here
  [ "${#refs[@]}" -eq $((${#BUNDLE_SERVICES[@]} + 2)) ] \
    || die "could not work out the image references; run ./qradar-dash bundle again"

  BUNDLE_DONE=no
  trap bundle_cleanup EXIT
  install_signal_traps
  for ref in "${refs[@]}"; do
    say "Pulling $ref"
    docker pull "$ref" >/dev/null \
      || die "could not pull $ref; a private registry needs docker login ghcr.io with a read:packages token; then run ./qradar-dash bundle again"
  done
  BUNDLE_STAGE=$(mktemp -d "$out/.qradar-dash-bundle.XXXXXX") \
    || die "cannot create a working directory in $out; free space there or pass --output DIR"
  BUNDLE_PARTIAL=$BUNDLE_STAGE.partial
  say "Saving the ${#refs[@]} images (this takes a while)"
  docker save -o "$BUNDLE_STAGE/images.tar" "${refs[@]}" \
    || die "docker save failed (is there room in $out?); free space or pass --output DIR"
  {
    printf '# qradar-dash offline bundle manifest; ./qradar-dash checks every image line after docker load\n'
    printf 'version %s\n' "$version"
    printf 'image_prefix %s\n' "$prefix"
    printf 'image_store %s\n' "$(docker_image_store)"
    for ref in "${refs[@]}"; do
      id=$(docker image inspect --format '{{.Id}}' "$ref") && [ -n "$id" ] \
        || die "cannot read the local image ID of $ref; run docker pull $ref and ./qradar-dash bundle again"
      printf 'image %s %s\n' "$ref" "$id"
    done
  } >"$BUNDLE_STAGE/MANIFEST"
  printf '%s\n' "$version" >"$BUNDLE_STAGE/VERSION"
  cp -p qradar-dash docker-compose.yml docker-compose.prod.yml "$BUNDLE_STAGE/" \
    || die "cannot copy the checkout files into the bundle"
  mkdir -p "$BUNDLE_STAGE/docs/releases"
  cp -p "docs/releases/$version.md" "$BUNDLE_STAGE/docs/releases/" || die "cannot copy docs/releases/$version.md"
  cp -pR deploy "$BUNDLE_STAGE/deploy" || die "cannot copy deploy/"
  member=$(find "$BUNDLE_STAGE" \( -name .env -o -name .secrets -o -name docker-compose.override.yml \) -print -quit)
  [ -z "$member" ] || die "bundle refused: ${member#"$BUNDLE_STAGE"/} would go into the bundle and holds this site's configuration; remove it from deploy/ and run ./qradar-dash bundle again"
  (
    cd "$BUNDLE_STAGE"
    find . -type f ! -name SHA256SUMS -printf '%P\n' | LC_ALL=C sort | while IFS= read -r member; do
      sha256sum -- "$member"
    done >SHA256SUMS
  ) || die "cannot write SHA256SUMS"
  tar --owner=0 --group=0 --numeric-owner -cf "$BUNDLE_PARTIAL" -C "$BUNDLE_STAGE" \
    SHA256SUMS MANIFEST VERSION qradar-dash docker-compose.yml docker-compose.prod.yml deploy docs images.tar \
    || die "cannot write the bundle archive (is there room in $out?); free space or pass --output DIR"
  if [ -e "$target" ] || [ -L "$target" ]; then
    die "bundle refused: $target appeared while the bundle was being made and is not overwritten"
  fi
  mv -- "$BUNDLE_PARTIAL" "$target" || die "cannot move the finished bundle to $target"
  BUNDLE_DONE=yes
  trap - EXIT HUP INT TERM
  rm -rf -- "$BUNDLE_STAGE"
  bytes=$(wc -c <"$target" | tr -d '[:space:]')
  say ""
  info "bundle written: $target ($(awk -v b="$bytes" 'BEGIN {printf "%.1f MiB", b / 1048576}'), $bytes bytes)"
  say "Copy it to the production host. There:"
  say ""
  say "First install"
  say "  mkdir qradar-dash-$version"
  say "  tar -xf /path/to/$name -C qradar-dash-$version --exclude=images.tar"
  say "  cd qradar-dash-$version"
  say "  ./qradar-dash install --offline /path/to/$name"
  say ""
  say "Upgrade of an installed site"
  say "  cd <installation directory>"
  say "  tar -xf /path/to/$name --exclude=images.tar"
  say "  ./qradar-dash upgrade $version --offline /path/to/$name"
}

# bundle_member BUNDLE MEMBER -> the member's text; fails when it is not in the tar.
bundle_member() {
  local text
  text=$(tar -xOf "$1" --occurrence=1 "$2" 2>/dev/null) || return 1
  printf '%s\n' "$text"
}

# bundle_precheck BUNDLE EXPECTED_VERSION WHAT PREFIX
# Reads only the small members. Refuses, before anything is loaded, a file that is not a bundle,
# a bundle of another version, and a bundle whose images sit under another image prefix.
bundle_precheck() {
  local bundle=$1 expected=$2 what=$3 prefix=$4 listing found manifest bundle_prefix
  listing=$(tar -tvf "$bundle" 2>/dev/null) \
    || die "cannot read $bundle as a tar file; copy it again from the connected host (made by ./qradar-dash bundle); nothing was loaded"
  if printf '%s\n' "$listing" | grep -Eq '^[lh]'; then
    die "$bundle holds links, which a ./qradar-dash bundle never does; nothing was loaded; copy it again from the connected host"
  fi
  if printf '%s\n' "$listing" | awk '{print $NF}' | grep -Eq '^/|(^|/)\.\.(/|$)'; then
    die "$bundle holds absolute or parent-directory paths, which a ./qradar-dash bundle never does; nothing was loaded; copy it again from the connected host"
  fi
  found=$(bundle_member "$bundle" VERSION | tr -d '[:space:]') || found=""
  [ -n "$found" ] \
    || die "$bundle has no VERSION member, so it is not a ./qradar-dash bundle; make one with ./qradar-dash bundle on a connected host; nothing was loaded"
  if [ "$found" != "$expected" ]; then
    die "bundle refused: $bundle is version $found but $what is $expected; nothing was loaded; use the bundle of version $expected (./qradar-dash bundle --version $expected on a connected host)"
  fi
  manifest=$(bundle_member "$bundle" MANIFEST) \
    || die "$bundle has no MANIFEST member, so it is not a ./qradar-dash bundle; make one with ./qradar-dash bundle on a connected host; nothing was loaded"
  bundle_prefix=$(printf '%s\n' "$manifest" | sed -n 's/^image_prefix //p' | head -n1)
  if [ "$bundle_prefix" != "$prefix" ]; then
    die "bundle refused: its images are under ${bundle_prefix:-an unknown prefix} but this site uses $prefix; nothing was loaded; make the bundle on a host whose .env has QRADAR_DASH_IMAGE_PREFIX=$prefix, or set that value here"
  fi
}

bundle_clean_tmp() { rm -rf -- "$TMP_DIR"; }

# docker_image_store -> containerd, classic or unknown. The two stores give a different meaning to
# an image's .Id, so IDs are compared only between hosts with the same store.
docker_image_store() {
  local status
  status=$(docker info --format '{{.DriverStatus}}' 2>/dev/null) || status=""
  case "$status" in
    "") printf 'unknown\n' ;;
    *io.containerd.snapshotter*) printf 'containerd\n' ;;
    *) printf 'classic\n' ;;
  esac
}

# bundle_verify_manifest MANIFEST -> every image line resolves, and has the ID the bundle was made
# from when both hosts use the same image store. docker save does not record a digest-pinned name
# (redis:TAG@sha256:... and the secrets helper alpine:TAG@sha256:...), so after docker load that
# image exists by ID only. Docker refuses to tag a digest reference, but once the plain name:tag
# is set the pinned reference resolves. Redis and the helper take this one path; there is no
# per-image branch.
bundle_verify_manifest() {
  local manifest=$1 kind ref id actual plain bad=0 compare=yes there here
  there=$(sed -n 's/^image_store //p' "$manifest" | head -n1)
  here=$(docker_image_store)
  if [ -n "$there" ]; then
    if [ "$there" != "$here" ] || [ "$here" = unknown ]; then
      compare=no
      say "Image IDs were not compared: the bundle host's image store is $there and this host's is $here; integrity rests on the SHA256SUMS check of images.tar. Every image reference is still checked."
    fi
  fi
  while read -r kind ref id; do
    [ "$kind" = image ] || continue
    actual=$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null) || actual=""
    if [ -z "$actual" ]; then
      plain=${ref%%@*}
      if [ "$plain" != "$ref" ]; then
        if docker image inspect "$id" >/dev/null 2>&1 && docker tag "$id" "$plain" 2>/dev/null \
          && actual=$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null) && [ -n "$actual" ]; then
          info "docker load kept $ref only by its ID; set the tag $plain on it (this moves an existing $plain on this host)"
        else
          fail "after docker load, $ref does not resolve: the loaded image ($id) does not carry the pinned digest on this Docker, even with the tag $plain set. Make the bundle again with ./qradar-dash bundle on a connected host whose Docker image store is the same as this host's ($here; the bundle host's was ${there:-not recorded}); see docs/OPERATIONS.md (Çevrimdışı paket)"
          bad=1
          continue
        fi
      elif docker image inspect "$id" >/dev/null 2>&1 && docker tag "$id" "$ref" 2>/dev/null \
        && actual=$(docker image inspect --format '{{.Id}}' "$ref" 2>/dev/null) && [ -n "$actual" ]; then
        info "docker load kept $ref only by its ID; tagged it as $ref"
      else
        fail "after docker load, $ref is not present (the bundle lists it as $id); copy the bundle again from the connected host and run the command again"
        bad=1
        continue
      fi
    fi
    if [ "$compare" = yes ] && [ "$actual" != "$id" ]; then
      fail "after docker load, $ref is image $actual but the bundle was made from $id; remove it (docker rmi $ref) and load the bundle again, or copy the bundle again from the connected host"
      bad=1
    fi
  done <"$manifest"
  [ "$bad" -eq 0 ]
}

# bundle_load BUNDLE: extract, check the sums, docker load, check the MANIFEST. Nothing is loaded
# unless every member matches SHA256SUMS exactly.
bundle_load() {
  local bundle=$1 dir=$TMP_DIR/bundle member listed members
  bundle_clean_tmp
  mkdir -p "$dir"
  tar -xf "$bundle" -C "$dir" \
    || { bundle_clean_tmp; die "cannot extract the bundle $bundle (is there room under $ROOT?); nothing was loaded"; }
  [ -f "$dir/SHA256SUMS" ] && [ -f "$dir/MANIFEST" ] && [ -f "$dir/images.tar" ] \
    || { bundle_clean_tmp; die "the bundle $bundle lacks SHA256SUMS, MANIFEST or images.tar; copy it again from the connected host; nothing was loaded"; }
  (cd "$dir" && sha256sum -c --quiet SHA256SUMS) \
    || { bundle_clean_tmp; die "the bundle checksums do not match; nothing was loaded; copy the bundle again from the connected host and compare sha256sum on both hosts"; }
  listed=$(sed -n 's/^[0-9a-f]\{64\} [ *]//p' "$dir/SHA256SUMS")
  members=$(cd "$dir" && find . -type f ! -name SHA256SUMS -printf '%P\n') \
    || { bundle_clean_tmp; die "cannot list the members of the bundle (is find installed?); nothing was loaded"; }
  while IFS= read -r member; do
    printf '%s\n' "$listed" | grep -qxF -- "$member" \
      || { bundle_clean_tmp; die "the bundle holds $member, which SHA256SUMS does not cover; nothing was loaded; copy the bundle again from the connected host"; }
  done <<<"$members"
  say "Bundle checksums match; loading the images (this takes a while)"
  docker load -i "$dir/images.tar" \
    || { bundle_clean_tmp; die "docker load failed; free space in Docker's data directory (docker info shows it) and run the command again"; }
  bundle_verify_manifest "$dir/MANIFEST" || { bundle_clean_tmp; exit 1; }
  bundle_clean_tmp
  info "bundle images loaded and checked against MANIFEST"
}

fernet_key() {
  docker run --rm --entrypoint python "${ANS[IMAGE_PREFIX]}/backend:$(env_get QRADAR_DASH_VERSION)" \
    -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())' \
    | tr -d '[:space:]'
}

wait_ready() { # wait_ready URL SECONDS
  local url=$1 left=$2
  while [ "$left" -gt 0 ]; do
    if curl -fsS --max-time 5 -o /dev/null "$url" 2>/dev/null; then return 0; fi
    sleep 3
    left=$((left - 3))
  done
  return 1
}

admin_exists() { # prints yes or no; no user field is printed
  local n
  n=$(printf '%s\n' "SELECT count(*) FROM app_user u JOIN user_role_link l ON l.user_id = u.id JOIN role r ON r.id = l.role_id WHERE u.username = lower(:'u') AND r.name = 'admin';" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -v "u=${ANS[ADMIN_USERNAME]}" -Atq) || die "could not query for the break-glass admin"
  if [ "$n" -gt 0 ] 2>/dev/null; then echo yes; else echo no; fi
}

install_cleanup() {
  # load-secrets and the public URL check keep their stderr in .install-tmp. The same text is
  # already on the operator's screen, so every exit removes the directory, including a die
  # before the state file is written. No other command uses this name.
  if [ "$TMP_DIR" = .install-tmp ]; then rm -rf -- "$TMP_DIR"; fi
}

cmd_install() {
  local mode=pull bundle="" answers="" dry=no reconfigure=no checkout
  trap install_cleanup EXIT
  FLAG_EXTERNAL_PROXY=no
  FLAG_SKIP_QRADAR=no
  PREFLIGHT_HOST_DONE=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) [ $# -ge 2 ] || { fail "--non-interactive needs a file"; exit 2; }; answers=$2; shift ;;
      --build) mode=build ;;
      --offline) [ $# -ge 2 ] || { fail "--offline needs a bundle file"; exit 2; }; mode=offline; bundle=$(user_path "$2"); shift ;;
      --external-proxy) FLAG_EXTERNAL_PROXY=yes ;;
      --reconfigure) reconfigure=yes ;;
      --dry-run) dry=yes ;;
      --skip-qradar-check) FLAG_SKIP_QRADAR=yes ;;
      -h | --help) usage; exit 0 ;;
      *) fail "unknown install option: $1"; usage >&2; exit 2 ;;
    esac
    shift
  done
  if [ "$mode" = "offline" ]; then
    [ -r "$bundle" ] || { fail "bundle not readable: $bundle"; exit 2; }
  fi
  checkout=$(read_checkout_version)

  # 0. A site that records a version keeps it: changing versions is `upgrade`, which backs up first.
  if [ -e .qradar-dash/state.json ] || [ -L .qradar-dash/state.json ]; then
    state_read .qradar-dash/state.json || {
      fail "install refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid; see ./qradar-dash status"
      exit 1
    }
    refuse_if_last_upgrade_failed install || exit 1
    if [ "$STATE_INSTALLED_VERSION" != "$checkout" ]; then
      fail "install refused: this site runs $STATE_INSTALLED_VERSION and this checkout is $checkout; use ./qradar-dash upgrade $checkout to change versions, or check out v$STATE_INSTALLED_VERSION to re-run install (see docs/OPERATIONS.md, Yükseltme)"
      exit 1
    fi
  fi

  # 1. Answers. Pure: nothing is written until every check has passed.
  if [ -n "$answers" ]; then
    parse_answers "$answers"
  elif [ -s "$SAVED_ANSWERS" ] && [ "$reconfigure" = "no" ] && [ -f "$ENV_FILE" ]; then
    say "Re-run: reusing the saved answers in $SAVED_ANSWERS (use --reconfigure to be asked again)."
    parse_answers "$SAVED_ANSWERS"
  elif [ -t 0 ]; then
    if [ -s "$SAVED_ANSWERS" ]; then parse_answers "$SAVED_ANSWERS"; fi
  else
    fail "no terminal and no --non-interactive FILE; nothing was written."
    exit 2
  fi
  [ "$FLAG_EXTERNAL_PROXY" = "no" ] || ANS[EXTERNAL_PROXY]=yes
  report_errors_and_exit # syntax errors in the file

  if [ -z "$answers" ] && [ -t 0 ] && { [ "$reconfigure" = "yes" ] || [ ! -s "$SAVED_ANSWERS" ] || [ ! -f "$ENV_FILE" ]; }; then
    preflight_host
    PREFLIGHT_HOST_DONE=yes
    apply_defaults
    wizard "$mode"
  fi
  apply_defaults
  validate_answers "$mode"
  report_errors_and_exit
  if [ "$mode" = "offline" ]; then
    bundle_precheck "$bundle" "$checkout" "this checkout" "${ANS[IMAGE_PREFIX]}"
  fi

  # 2. Preflight. Changes nothing.
  say "Preflight"
  if [ "$PREFLIGHT_HOST_DONE" = "no" ]; then preflight_host; fi
  PROJECT=${ANS[PROJECT_NAME]}
  report_compose_override
  preflight_network
  if [ "$dry" = "yes" ]; then say "Dry run: every check passed; nothing was written."; exit 0; fi

  # 3. First writes: secrets directory, answers, a .env with no Fernet key yet.
  # compose reads .env for env_file, so it must exist before build or pull.
  local enc
  enc=$(env_get ENCRYPTION_KEY)
  write_secrets_dir
  save_answers
  write_env "$enc"
  info ".env written (mode 0600); $ENV_WRITE_STATUS"

  # 4. Images.
  get_images "$mode" "$bundle"

  # 5. The Fernet key, made inside the backend image. Never replaced once set.
  if [ -z "$enc" ]; then
    enc=$(fernet_key)
    [ -n "$enc" ] || die "could not generate the encryption key inside the backend image"
    write_env "$enc"
    info "ENCRYPTION_KEY generated inside the backend image"
  else
    info "ENCRYPTION_KEY kept (never rotated)"
  fi

  # 6. Secret volumes, then data services.
  export SECRETS_VOLUME=${ANS[SECRETS_VOLUME]} PROXY_CERTS_VOLUME=${ANS[PROXY_CERTS_VOLUME]}
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    load_secrets_into_volumes all
  else
    load_secrets_into_volumes qradar
  fi
  info "secrets loaded into the volumes ${ANS[SECRETS_VOLUME]}$([ "${ANS[EXTERNAL_PROXY]}" = no ] && echo " and ${ANS[PROXY_CERTS_VOLUME]}")"
  mkdir -p "${ANS[BACKUP_DIR]}" || die "cannot create the backup directory ${ANS[BACKUP_DIR]}"
  chmod 700 "${ANS[BACKUP_DIR]}" || die "cannot set mode 0700 on the backup directory ${ANS[BACKUP_DIR]}"
  if ! dc up -d --wait --wait-timeout 180 postgres redis; then
    read_unhealthy_services
    die "postgres or redis did not become healthy within 180 s: ${UNHEALTHY_DESC}. Next: ${UNHEALTHY_NEXT:-./qradar-dash logs postgres} and ./qradar-dash doctor"
  fi
  info "postgres and redis are healthy"

  # 7. Migrate. A failure stops the install before the application starts.
  run_install_migrate
  info "migrations are at head"

  # 8. Break-glass admin. seed is not run: it would insert a mock QRadar instance.
  local have_admin
  have_admin=$(admin_exists)
  if [ "$have_admin" = "yes" ]; then
    info "break-glass admin '${ANS[ADMIN_USERNAME]}' exists; create-admin is not run again"
  else
    say ""
    say "==================== BREAK-GLASS ADMIN: password shown ONCE ===================="
    dc run --rm --no-deps -T backend python -m app.cli.users create-admin \
      --username "${ANS[ADMIN_USERNAME]}" || die "create-admin failed"
    say "================================================================================"
    say ""
  fi

  # 9. Register the console inside the container, so the stored CA path is the container path.
  local qr_rc=0
  dc run --rm --no-deps -T backend python -m app.cli.qradar add \
    --name "${ANS[INSTANCE_NAME]}" --url "${ANS[QRADAR_URL]%/}" \
    --token-file /run/secrets/qradar_sec_token --ca-file /run/secrets/qradar_ca.pem \
    --api-version "${ANS[QRADAR_API_VERSION]}" || qr_rc=$?

  # 9b. Record the answer to "read QRadar's past?" before the first collection (step 10). It runs
  # whatever step 9 returned: the instance row may exist after a failed QRadar check. A failure
  # never stops the install; the console stays undecided and the first administrator sign-in asks.
  HB_RC=""
  HB_OUT=""
  if [ -n "${ANS[HISTORY_BACKFILL]:-}" ]; then
    HB_RC=0
    HB_OUT=$(dc run --rm --no-deps -T backend python -m app.cli.history_backfill decide \
      --instance "${ANS[INSTANCE_NAME]}" --answer "${ANS[HISTORY_BACKFILL]}" \
      --source installer) || HB_RC=$?
    if [ "$HB_RC" -eq 0 ]; then
      info "history backfill: $HB_OUT"
    else
      warn "history backfill: the answer was not recorded (exit $HB_RC); the console stays undecided and the first administrator sign-in will ask"
    fi
  fi

  # 10. Start.
  if [ "${ANS[EXTERNAL_PROXY]}" = "yes" ]; then
    local f
    f=$(env_get FORWARDED_ALLOW_IPS)
    if [ -z "$f" ] || [ "$f" = "*" ]; then
      fail "external proxy: FORWARDED_ALLOW_IPS in $ENV_FILE is empty. The backend is not started."
      say "Set it to the peer address uvicorn sees from your proxy (README, 'Proxy headers and the"
      say "rate limiter'), then run ./qradar-dash install again. Any admin password printed above stays valid."
      exit 3
    fi
  fi
  local svc="backend celery-worker celery-beat frontend"
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then svc="$svc proxy"; fi
  # shellcheck disable=SC2086
  if ! dc up -d --wait --wait-timeout 180 $svc; then
    read_unhealthy_services
    fail "a service did not become healthy within 180 s: ${UNHEALTHY_DESC}. Next: ${UNHEALTHY_NEXT:-./qradar-dash logs backend} and ./qradar-dash doctor"
    exit 1
  fi
  info "backend, worker, beat, frontend$([ "${ANS[EXTERNAL_PROXY]}" = no ] && echo ", proxy") are healthy"
  local api="http://127.0.0.1:${ANS[API_LOOPBACK_PORT]}/api/v1"
  local api_ready=yes code public_ok=yes
  if ! wait_ready "$api/health/ready" 60; then
    warn "$api/health/ready did not answer 200 within 60 s; run ./qradar-dash doctor and ./qradar-dash logs backend"
    api_ready=no
  fi
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$api/version" || true)
  if [ "$code" = "200" ]; then
    info "version: $(curl -s --max-time 5 "$api/version")"
  else
    warn "GET /api/v1/version did not answer 200 (got '${code:-no answer}'); run ./qradar-dash doctor and ./qradar-dash logs backend"
    api_ready=no
  fi
  # The bundled proxy is the only path that publishes PUBLIC_HOSTNAME. An external proxy is the
  # operator's, so this check would not be asking the stack we started.
  if [ "${ANS[EXTERNAL_PROXY]}" != yes ]; then
    check_published_url || public_ok=no
  fi

  summary "$qr_rc" "$have_admin" "$api_ready"
  # The state file records the version and image digests, which do not depend on QRadar.
  write_install_state || die "the install state file could not be written; run ./qradar-dash status"
  [ "$qr_rc" -eq 0 ] && [ "$api_ready" = yes ] && [ "$public_ok" = yes ] || exit 1
}

# stdout of load-secrets.sh is the volume noise; stderr is the operator's error. Keep it under
# .install-tmp so a failure can be shown without using the host's /tmp.
load_secrets_into_volumes() { # all|qradar
  local which=$1 err="$TMP_DIR/load-secrets.err"
  mkdir -p "$TMP_DIR"
  if ./deploy/load-secrets.sh "$which" >/dev/null 2>"$err"; then
    return 0
  fi
  cat "$err" >&2 || true
  die "deploy/load-secrets.sh $which failed. The error from deploy/load-secrets.sh is above. Run ./qradar-dash install again."
}

database_alembic_revision() { # revision on stdout; empty or a failed query returns 1
  local rev
  rev=$(postgres_sql "$(env_get POSTGRES_DB)" "SELECT version_num FROM alembic_version;") || return 1
  rev=$(printf '%s' "$rev" | tr -d '[:space:]')
  [ -n "$rev" ] || return 1
  printf '%s\n' "$rev"
}

run_install_migrate() {
  local rev=""
  if dc run --rm -T migrate; then
    return 0
  fi
  dc logs --no-color --tail 40 migrate || true
  rev=$(database_alembic_revision || true)
  if [ -z "$rev" ]; then
    die "alembic upgrade head failed. The database looks new (alembic_version is empty or missing). Run ./qradar-dash install again. The migrate logs are above."
  fi
  die "alembic upgrade head failed. The database is not new (alembic_version is $rev). Run ./qradar-dash doctor. The migrate logs are above."
}

# Prints two lines: the description, then the logs commands (empty when none).
# Returns 1 when compose names nobody. Callers must use read_unhealthy_services:
# a $(...) capture would drop a global, and tab is whitespace so an empty Health
# field has to be split on a non-whitespace separator.
compose_unhealthy_services() {
  local rows row service state health state_l health_l joined="" logs=""
  if ! rows=$(dc ps --all --format '{{.Service}}\t{{.State}}\t{{.Health}}\t{{.ExitCode}}' 2>/dev/null); then
    printf '%s\nlogs:\n' "docker compose ps --all failed, so no service name is available"
    return 1
  fi
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    row=${row//$'\t'/$'\x1f'}
    IFS=$'\x1f' read -r service state health _ <<<"$row"
    [ -n "$service" ] || continue
    state_l=${state,,}
    health_l=${health,,}
    if [ "$state_l" = running ] && { [ -z "$health_l" ] || [ "$health_l" = healthy ]; }; then
      continue
    fi
    if [ -n "$joined" ]; then joined="$joined, "; fi
    joined="$joined$service is ${state_l:-unknown}"
    [ -z "$health_l" ] || joined="$joined (health: $health_l)"
    if [ -n "$logs" ]; then logs="$logs and "; fi
    logs="$logs./qradar-dash logs $service"
  done <<<"$rows"
  if [ -z "$joined" ]; then
    printf '%s\nlogs:\n' "docker compose ps --all named no unhealthy service"
    return 1
  fi
  # The logs: prefix stays on the second line so a command substitution, which
  # strips trailing newlines, cannot drop an empty next-step line.
  printf '%s\nlogs:%s\n' "$joined" "$logs"
}

read_unhealthy_services() {
  local output
  output=$(compose_unhealthy_services || true)
  UNHEALTHY_DESC=${output%$'\n'*}
  UNHEALTHY_NEXT=${output##*$'\n'}
  UNHEALTHY_NEXT=${UNHEALTHY_NEXT#logs:}
}

# 1|true|yes|on (any case) is on. An unset key uses the config.py default (on or off).
env_flag_on() { # KEY default
  local raw
  if env_has_key "$1"; then
    raw=$(env_get "$1")
    case "${raw,,}" in
      1 | true | yes | on) return 0 ;;
      *) return 1 ;;
    esac
  fi
  [ "$2" = on ]
}

csv_join() {
  local out="" item
  for item in "$@"; do
    if [ -n "$out" ]; then out="$out, $item"; else out=$item; fi
  done
  printf '%s\n' "$out"
}

# Defaults match backend/app/core/config.py. The "every 5 min" sentence is the
# SearchCadence.FIVE_MINUTES default; WAF and IPS are the fifteen-minute families.
summary_search_lines() {
  local -a on=( "Phase A" ) off=() slow=()
  local label key default slow_family on_text off_text note slow_text
  while IFS=$'\t' read -r label key default slow_family; do
    [ -n "$label" ] || continue
    if env_flag_on "$key" "$default"; then
      on+=( "$label" )
      [ "$slow_family" = yes ] && slow+=( "$label" )
    else
      off+=( "$label" )
    fi
  done <<'EOF'
catch-all	CATCHALL_COLLECTION_ENABLED	on	no
geo	GEO_COLLECTION_ENABLED	on	no
explanations	ANOMALY_EXPLANATION_ENABLED	on	no
WAF	WAF_COLLECTION_ENABLED	off	yes
IPS	IPS_COLLECTION_ENABLED	off	yes
rule-match collection	RULE_MATCH_COLLECTION_ENABLED	off	no
custom rules	CUSTOM_RULES_ENABLED	off	no
property watch	PW_COLLECTION_ENABLED	off	no
EOF
  on_text=$(csv_join "${on[@]}")
  note="every 5 min unless changed under Administration → Search cadence"
  if [ "${#slow[@]}" -gt 0 ]; then
    slow_text=$(csv_join "${slow[@]}")
    note="$note; $slow_text uses 15 min until changed on that page"
  fi
  say "Searching QRadar   $on_text ($note)"
  if [ "${#off[@]}" -eq 0 ]; then
    say "Left off           none"
  else
    off_text=$(csv_join "${off[@]}")
    say "Left off           $off_text (turn them on later)"
  fi
}

# --install-timer writes a system unit for root and a --user unit otherwise. A unit file can be
# present and disabled, so systemd is the signal whenever systemctl exists: the first scope that
# knows the unit answers. Only a host without systemctl falls back to the two unit-file paths.
# Prints "SCOPE STATE" on stdout. Returns 0 when the timer is enabled (or, without systemctl,
# when its unit file is present).
backup_timer_state() {
  local scope out system_unit=/etc/systemd/system/qradar-dash-backup.timer
  local user_unit="${HOME:-}/.config/systemd/user/qradar-dash-backup.timer"
  if command -v systemctl >/dev/null 2>&1; then
    for scope in system user; do
      if [ "$scope" = user ]; then
        out=$(systemctl --user is-enabled qradar-dash-backup.timer 2>/dev/null || true)
      else
        out=$(systemctl is-enabled qradar-dash-backup.timer 2>/dev/null || true)
      fi
      out=${out%%$'\n'*}
      # Real systemd prints not-found (exit 4) for a unit that is not in this scope, and
      # nothing at all on older versions or a --user call without a user bus: ask the next scope.
      case "$out" in '' | not-found) continue ;; esac
      case "$out" in
        enabled | enabled-runtime) printf '%s %s\n' "$scope" "$out"; return 0 ;;
        *) printf '%s %s\n' "$scope" "$out"; return 1 ;;
      esac
    done
    printf 'none missing\n'
    return 1
  fi
  if [ -f "$system_unit" ] && [ ! -L "$system_unit" ]; then
    printf 'system unit-file\n'
    return 0
  fi
  if [ -n "${HOME:-}" ] && [ -f "$user_unit" ] && [ ! -L "$user_unit" ]; then
    printf 'user unit-file\n'
    return 0
  fi
  printf 'none missing\n'
  return 1
}

backup_timer_enable_command() { # system|user
  if [ "$1" = user ]; then
    printf 'systemctl --user enable --now qradar-dash-backup.timer\n'
  else
    printf 'systemctl enable --now qradar-dash-backup.timer\n'
  fi
}

summary_backup_timer() {
  local scope state
  read -r scope state <<<"$(backup_timer_state || true)"
  case "$state" in
    enabled | enabled-runtime) say "Backup timer: installed" ;;
    unit-file) say "Backup timer: unit file present (systemctl is not available)" ;;
    disabled) say "Backup timer       installed but disabled. Run: ./qradar-dash backup --install-timer" ;;
    *) say "Backup timer       not installed. Run: ./qradar-dash backup --install-timer" ;;
  esac
}

check_published_url() {
  local host port url resolve err code rc err_line
  host=${ANS[PUBLIC_HOSTNAME]}
  port=${ANS[HTTPS_PORT]:-443}
  if [ "$port" = 443 ]; then
    url="https://${host}/api/v1/health/ready"
  else
    url="https://${host}:${port}/api/v1/health/ready"
  fi
  resolve="${host}:${port}:127.0.0.1"
  mkdir -p "$TMP_DIR"
  err="$TMP_DIR/public-ready.err"
  : >"$err"
  if code=$(curl -sS --max-time 15 --resolve "$resolve" -o /dev/null -w '%{http_code}' "$url" 2>"$err"); then
    rc=0
  else
    rc=$?
  fi
  if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then
    info "public URL $url answered HTTP 200 through the local proxy"
    return 0
  fi
  if [ "$rc" -eq 60 ] || [ "$rc" -eq 51 ]; then
    : >"$err"
    if code=$(curl -k -sS --max-time 15 --resolve "$resolve" -o /dev/null -w '%{http_code}' "$url" 2>"$err"); then
      rc=0
    else
      rc=$?
    fi
    if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then
      warn "public URL $url answered HTTP 200 only with certificate checks disabled (curl exit 60 or 51). Browsers will warn unless the site CA is trusted. Continuing."
      return 0
    fi
  fi
  err_line=$(head -n1 "$err" 2>/dev/null || true)
  fail "public URL $url failed (curl exit $rc, HTTP ${code:-none}${err_line:+: $err_line}). Next: ./qradar-dash logs proxy and ./qradar-dash doctor."
  return 1
}

summary() {
  local qr_rc=$1 had=$2 api_ready=$3 origin hb_line
  local ts_on ts_ls ts_sr ts_rm ts_os
  local sr_days ca_days geo_days waf_m waf_a ips_m ips_a pw_m pw_a
  local fault_days cr_days lsa_days rhs_days dcs_days
  origin=$(env_get PUBLIC_ORIGIN)
  say ""
  say "=============================== Install summary ==============================="
  say "URL                 $origin/"
  say "Sign-in             $origin/login"
  if [ "$had" = "yes" ]; then
    say "Admin               ${ANS[ADMIN_USERNAME]} (already existed; its password was not touched)"
  else
    say "Admin               ${ANS[ADMIN_USERNAME]} (the password was printed above and is not stored)"
    say "                    The first sign-in must change that password."
  fi
  if [ "$qr_rc" -eq 0 ]; then
    say "QRadar connection  ok (instance '${ANS[INSTANCE_NAME]}')"
  else
    say "QRadar connection  FAILED (exit $qr_rc). The instance row is stored; fix the console, token or"
    say "                    CA and run ./qradar-dash install again (qradar add updates the row)."
  fi
  if [ "$api_ready" != yes ]; then
    say "API readiness      NOT READY — run ./qradar-dash doctor and ./qradar-dash logs backend"
  fi
  if [ -z "${HB_RC:-}" ]; then
    say "History backfill   not decided; the first administrator sign-in will ask (WAF and IPS read"
    say "                    history for sources enabled after the answer)"
  elif [ "$HB_RC" -eq 0 ]; then
    hb_line=${HB_OUT##*$'\n'} # the CLI's last line, "NAME: recorded YES (28 days) ..."
    say "History backfill   ${hb_line#*: }"
  else
    say "History backfill   not recorded (exit $HB_RC); the first administrator sign-in will ask"
  fi
  # Daily deleters run whether or not RETENTION_ENABLED is set. Timescale days
  # come from .env (the installer writes 90). The other days are the code
  # defaults unless that key is set in .env. One line, summary only.
  ts_on=$(env_get RETENTION_ENABLED)
  ts_ls=$(env_get RETENTION_LOG_SOURCE_METRIC_DAYS)
  ts_sr=$(env_get RETENTION_SEARCH_RESULT_METRIC_DAYS)
  ts_rm=$(env_get RETENTION_RULE_METRIC_DAYS)
  ts_os=$(env_get RETENTION_OFFENSE_SNAPSHOT_DAYS)
  sr_days=$(env_get SEARCH_RESULT_METRIC_RETENTION_DAYS); sr_days=${sr_days:-90}
  ca_days=$(env_get CATCHALL_RETENTION_DAYS); ca_days=${ca_days:-35}
  geo_days=$(env_get GEO_RETENTION_DAYS); geo_days=${geo_days:-35}
  waf_m=$(env_get WAF_METRIC_RETENTION_DAYS); waf_m=${waf_m:-35}
  waf_a=$(env_get WAF_ANOMALY_RETENTION_DAYS); waf_a=${waf_a:-180}
  ips_m=$(env_get IPS_METRIC_RETENTION_DAYS); ips_m=${ips_m:-35}
  ips_a=$(env_get IPS_ANOMALY_RETENTION_DAYS); ips_a=${ips_a:-365}
  pw_m=$(env_get PW_METRIC_RETENTION_DAYS); pw_m=${pw_m:-35}
  pw_a=$(env_get PW_ANOMALY_RETENTION_DAYS); pw_a=${pw_a:-180}
  fault_days=$(env_get ANOMALY_FAULT_RETENTION_DAYS); fault_days=${fault_days:-30}
  cr_days=$(env_get CUSTOM_RULE_BREACH_RETENTION_DAYS); cr_days=${cr_days:-180}
  lsa_days=$(env_get LOG_SOURCE_ANOMALY_RETENTION_DAYS); lsa_days=${lsa_days:-365}
  rhs_days=$(env_get RULE_HEALTH_SNAPSHOT_RETENTION_DAYS); rhs_days=${rhs_days:-90}
  dcs_days=$(env_get DETECTION_COVERAGE_SNAPSHOT_RETENTION_DAYS); dcs_days=${dcs_days:-90}
  rm_days=$(env_get RULE_MATCH_RETENTION_DAYS); rm_days=${rm_days:-90}
  say "Retention           Timescale RETENTION_ENABLED=${ts_on:-false} log_source_metric ${ts_ls:-unset}d search_result_metric ${ts_sr:-unset}d rule_metric ${ts_rm:-unset}d offense_snapshot ${ts_os:-unset}d; daily deleters (not gated by RETENTION_ENABLED): search results ${sr_days}d, catch-all ${ca_days}d, geo ${geo_days}d, WAF metrics ${waf_m}d, WAF incidents ${waf_a}d, IPS metrics ${ips_m}d, IPS incidents ${ips_a}d, property-watch metrics ${pw_m}d, property-watch incidents ${pw_a}d, anomaly faults ${fault_days}d, custom-rule breaches ${cr_days}d, Phase A incidents ${lsa_days}d, rule-health snapshots ${rhs_days}d, coverage snapshots ${dcs_days}d, rule-match rows ${rm_days}d"
  summary_search_lines
  say "Next               Sign in, then Directory ($origin/admin/directory) if AD is used,"
  say "                    and Users ($origin/admin/users) to assign roles."
  say "Runbook            docs/OPERATIONS.md; ./qradar-dash doctor"
  say "Backup directory   ${ANS[BACKUP_DIR]}"
  summary_backup_timer
  say "Install time       $(((SECONDS - START_SECONDS) / 60)) min $(((SECONDS - START_SECONDS) % 60)) s"
  say "================================================================================"
}

# ---------------------------------------------------------------- status, logs

need_installed() {
  [ -f "$ENV_FILE" ] || die "not installed here: $ENV_FILE is missing. Run ./qradar-dash install."
  load_project_from_env
}

cmd_status() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage; return 0 ;;
      *) fail "unknown status argument: $1; usage: ./qradar-dash status"; return 2 ;;
    esac
    shift
  done
  need_installed
  need_docker || exit 1
  dc ps
  local port code service digest item age="unknown"
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/api/v1/health/ready" || true)
  say "API ready: HTTP ${code:-none} (http://127.0.0.1:$port/api/v1/health/ready)"
  if ! state_read .qradar-dash/state.json; then
    fail "status: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    say "Installed version: unknown"
    return 1
  fi
  say "Installed version: $STATE_INSTALLED_VERSION"
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    service=${item%%:*}
    digest=${item#*:}
    say "Image $service: $digest"
  done < <(printf '%s\n' "${STATE_IMAGES//,/$'\n'}")
  if [ "$STATE_LAST_PRESENT" = yes ]; then
    # The age is the backup's own: `last_upgrade.at` is the time of the last event, and a
    # rollback rewrites it, which made a backup taken minutes earlier look 0 min old.
    if age=$(backup_stamp_age "$STATE_LAST_BACKUP" 2>/dev/null); then :; else age=unknown; fi
    say "Last upgrade: $STATE_LAST_OUTCOME, $STATE_LAST_FROM -> $STATE_LAST_TO at $STATE_LAST_AT"
    say "Last upgrade backup: $STATE_LAST_BACKUP (age $age)"
  else
    say "Last upgrade: none"
  fi
  [ "$code" = "200" ]
}

cmd_logs() {
  need_installed
  dc logs "$@"
}

# ---------------------------------------------------------------- backup and restore primitives

database_size_bytes() { # bytes on stdout; failure means unavailable
  local size
  size=$(printf '%s\n' "SELECT pg_database_size(current_database());" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -Atq 2>/dev/null) || return 1
  case "$size" in '' | *[!0-9]*) return 1 ;; esac
  printf '%s\n' "$size"
}

backup_guard_values() { # backup_guard_values PATH DATABASE_BYTES COPIES -> "FREE_KIB REQUIRED_KIB"
  local metrics free used required_kib
  metrics=$(doctor_df "$1" || true)
  [ -n "$metrics" ] || return 1
  read -r free used <<<"$metrics"
  required_kib=$((($3 * $2 + 2 * 1024 * 1024 * 1024 + 1023) / 1024))
  printf '%s %s\n' "$free" "$required_kib"
}

backup_disk_guard() { # backup_disk_guard PATH DATABASE_BYTES COPIES [DISPLAY_PATHS]
  local path=$1 display=${4:-$1} values free required free_gib required_gib
  values=$(backup_guard_values "$path" "$2" "$3") || {
    fail "free space is unavailable for backup path $display"
    return 1
  }
  read -r free required <<<"$values"
  free_gib=$(doctor_free_gib "$free")
  required_gib=$(doctor_free_gib "$required")
  say "Backup disk: $free_gib GiB free; $required_gib GiB required at $display."
  if [ "$free" -lt "$required" ]; then
    fail "backup disk guard refused: $free_gib GiB free, $required_gib GiB required at $display"
    return 1
  fi
}

docker_root_path() {
  local path
  path=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null) || return 1
  [ -n "$path" ] || return 1
  printf '%s\n' "$path"
}

backup_storage_guards() { # backup_storage_guards BACKUP_ROOT DATABASE_BYTES VERIFY
  local backup_root=$1 db_size=$2 verify=$3 docker_root backup_device docker_device copies
  docker_root=$(docker_root_path) || {
    fail "Docker root directory is unavailable; no backup was written."
    return 1
  }
  backup_device=$(stat -c %d -- "$backup_root" 2>/dev/null) || {
    fail "backup filesystem is unavailable at $backup_root"
    return 1
  }
  docker_device=$(stat -c %d -- "$docker_root" 2>/dev/null) || {
    fail "Docker filesystem is unavailable at $docker_root"
    return 1
  }
  if [ "$backup_device" = "$docker_device" ]; then
    if [ "$verify" = yes ]; then copies=3; else copies=2; fi
    say "Backup and Docker paths share one filesystem: $backup_root and $docker_root."
    backup_disk_guard "$backup_root" "$db_size" "$copies" \
      "$backup_root and $docker_root"
    return
  fi
  backup_disk_guard "$backup_root" "$db_size" 2 || return 1
  if [ "$verify" = yes ]; then copies=2; else copies=1; fi
  backup_disk_guard "$docker_root" "$db_size" "$copies"
}

validate_database_identifier() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]] || {
    fail "unsafe database name refused"
    return 1
  }
}

guard_drop_database() { # guard_drop_database NAME
  local live
  live=$(env_get POSTGRES_DB)
  validate_database_identifier "$1" || return 1
  if [ "$1" = "$live" ]; then
    fail "refusing to drop the live POSTGRES_DB database"
    return 1
  fi
}

is_restore_database_name() {
  [[ $1 == qradar_obs_restore_test || $1 =~ ^qradar_obs_restore_[0-9]{8}t[0-9]{6}z$ ]]
}

postgres_sql() { # postgres_sql DATABASE SQL
  printf '%s\n' "$2" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$1" \
      -v ON_ERROR_STOP=1 -Atq
}

drop_database() { # drop_database NAME
  guard_drop_database "$1" || return 1
  postgres_sql postgres "DROP DATABASE IF EXISTS $1;"
}

RESTORE_CONTAINER_DUMP=""

restore_container_dump_cleanup() {
  [ -z "$RESTORE_CONTAINER_DUMP" ] \
    || dc exec -T postgres rm -f -- "$RESTORE_CONTAINER_DUMP" >/dev/null 2>&1 \
    || true
  RESTORE_CONTAINER_DUMP=""
}

restore_dump_into_database() { # restore_dump_into_database DUMP NAME
  local dump=$1 database=$2
  is_restore_database_name "$database" || {
    fail "unsafe restore database name refused"
    return 1
  }
  guard_drop_database "$database" || return 1
  RESTORE_CONTAINER_DUMP="/tmp/qradar-dash-${database}.dump"
  dc cp "$dump" "postgres:$RESTORE_CONTAINER_DUMP" || {
    restore_container_dump_cleanup
    return 1
  }
  if ! postgres_sql postgres "CREATE DATABASE $database;"; then
    restore_container_dump_cleanup
    return 1
  fi
  if ! postgres_sql "$database" \
      'CREATE EXTENSION IF NOT EXISTS timescaledb; CREATE EXTENSION IF NOT EXISTS pgcrypto;' \
    || ! postgres_sql "$database" 'SELECT timescaledb_pre_restore();' \
    || ! dc exec -T postgres pg_restore -U "$(env_get POSTGRES_USER)" \
      -d "$database" --no-owner "$RESTORE_CONTAINER_DUMP" \
    || ! postgres_sql "$database" 'SELECT timescaledb_post_restore();'; then
    restore_container_dump_cleanup
    return 1
  fi
  restore_container_dump_cleanup
}

manifest_get() { # manifest_get BACKUP_DIRECTORY KEY
  sed -n "s/^$2=//p" "$1/MANIFEST" | head -n1
}

verify_restored_database() { # verify_restored_database NAME EXPECTED_ALEMBIC [COUNTS]
  local database=$1 expected=$2 counts=${3:-no} actual
  actual=$(postgres_sql "$database" 'SELECT version_num FROM alembic_version;' \
    | tr -d '[:space:]') || return 1
  [ "$actual" = "$expected" ] || {
    fail "restored alembic_version does not match the backup manifest"
    return 1
  }
  if [ "$counts" = yes ]; then
    postgres_sql "$database" 'SELECT count(*) FROM alembic_version;' >/dev/null || return 1
    postgres_sql "$database" 'SELECT count(*) FROM role;' >/dev/null || return 1
  fi
}

BACKUP_STAGE=""
BACKUP_SCRATCH_CREATED=no
BACKUP_CONTAINER_DUMP=""

backup_cleanup() {
  if [ "$BACKUP_SCRATCH_CREATED" = yes ]; then
    drop_database qradar_obs_restore_test >/dev/null 2>&1 || true
    BACKUP_SCRATCH_CREATED=no
  fi
  if [ -n "$BACKUP_CONTAINER_DUMP" ]; then
    dc exec -T postgres rm -f -- "$BACKUP_CONTAINER_DUMP" >/dev/null 2>&1 || true
    BACKUP_CONTAINER_DUMP=""
  fi
  [ -z "$BACKUP_STAGE" ] || rm -rf -- "$BACKUP_STAGE"
  BACKUP_STAGE=""
}

backup_image_digests() {
  local containers container row service oneoff digest joined="" has_postgres=no
  containers=$(dc ps -a -q) || return 1
  while IFS= read -r container; do
    [ -n "$container" ] || continue
    case "$container" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
    row=$(docker inspect --format \
      '{{printf "%s\t%s\t%s" (index .Config.Labels "com.docker.compose.service") (index .Config.Labels "com.docker.compose.oneoff") .Image}}' \
      "$container") || return 1
    IFS=$'\t' read -r service oneoff digest <<<"$row"
    [ "${oneoff,,}" = true ] && continue
    case "$service" in '' | *[!A-Za-z0-9_.-]*) return 1 ;; esac
    if [[ $digest =~ ^[0-9a-f]{64}$ ]]; then digest="sha256:$digest"; fi
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    [ "$service" != postgres ] || has_postgres=yes
    if [ -n "$joined" ]; then joined="$joined,"; fi
    joined="$joined$service:$digest"
  done <<<"$containers"
  [ "$has_postgres" = yes ] || return 1
  printf '%s\n' "$joined"
}

