STATE_INSTALLED_VERSION=""
STATE_IMAGES=""
STATE_PREVIOUS_IMAGES=""
STATE_LAST_PRESENT=no
STATE_LAST_AT=""
STATE_LAST_FROM=""
STATE_LAST_TO=""
STATE_LAST_OUTCOME=""
STATE_LAST_BACKUP=""
STATE_LAST_RESTORED_FROM=""
STATE_ERROR_FIELD="json"

valid_release_version() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }

valid_state_time() {
  [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

state_now() {
  local value
  value=$(date -u +%Y-%m-%dT%H:%M:%SZ) || return 1
  if [[ $value =~ ^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$ ]]; then
    value="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}Z"
  fi
  valid_state_time "$value" || return 1
  printf '%s\n' "$value"
}

valid_state_path() {
  [[ $1 == /* ]] || return 1
  [[ $1 != *['"'\\]* ]] || return 1
  ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

validate_image_map() { # comma-separated service:sha256 image ids
  local map=$1 item service digest seen="|"
  [ -n "$map" ] || return 1
  while IFS= read -r item; do
    [ -n "$item" ] || return 1
    service=${item%%:*}
    digest=${item#*:}
    [[ $service =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    [[ $seen != *"|$service|"* ]] || return 1
    seen="$seen$service|"
  done < <(printf '%s\n' "${map//,/$'\n'}")
}

image_map_to_json() {
  local map=$1 item service digest joined=""
  validate_image_map "$map" || return 1
  while IFS= read -r item; do
    service=${item%%:*}
    digest=${item#*:}
    [ -z "$joined" ] || joined="$joined,"
    joined="$joined\"$service\":\"$digest\""
  done < <(printf '%s\n' "${map//,/$'\n'}")
  printf '{%s}' "$joined"
}

json_object_to_image_map() {
  local object=${1//[[:space:]]/} item service digest joined=""
  [ -n "$object" ] || return 1
  while IFS= read -r item; do
    if [[ ! $item =~ ^\"([A-Za-z0-9_.-]+)\":\"(sha256:[0-9a-f]{64})\"$ ]]; then
      return 1
    fi
    service=${BASH_REMATCH[1]}
    digest=${BASH_REMATCH[2]}
    [ -z "$joined" ] || joined="$joined,"
    joined="$joined$service:$digest"
  done < <(printf '%s\n' "${object//,/$'\n'}")
  validate_image_map "$joined" || return 1
  printf '%s\n' "$joined"
}

state_object_field() { # compact JSON, object name -> object body
  printf '%s\n' "$1" \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p"
}

state_string_field() { # compact JSON/object, field name -> string value
  printf '%s\n' "$1" \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

state_read() { # state_read FILE -> validated STATE_* globals
  local file=$1 compact images_object previous_object last_object
  STATE_ERROR_FIELD="file"
  [ -r "$file" ] && [ -f "$file" ] && [ ! -L "$file" ] || return 1
  STATE_ERROR_FIELD=json
  compact=$(tr -d '\n\r' <"$file") || return 1
  [[ $compact == \{*\} ]] || return 1
  STATE_INSTALLED_VERSION=$(state_string_field "$compact" installed_version)
  STATE_ERROR_FIELD=installed_version
  valid_release_version "$STATE_INSTALLED_VERSION" || return 1
  images_object=$(state_object_field "$compact" images)
  STATE_ERROR_FIELD=images
  STATE_IMAGES=$(json_object_to_image_map "$images_object") || return 1
  STATE_ERROR_FIELD=previous_images
  if [[ $compact =~ \"previous_images\"[[:space:]]*:[[:space:]]*null ]]; then
    STATE_PREVIOUS_IMAGES=""
  else
    previous_object=$(state_object_field "$compact" previous_images)
    STATE_PREVIOUS_IMAGES=$(json_object_to_image_map "$previous_object") || return 1
  fi
  STATE_LAST_PRESENT=no
  STATE_LAST_AT=""
  STATE_LAST_FROM=""
  STATE_LAST_TO=""
  STATE_LAST_OUTCOME=""
  STATE_LAST_BACKUP=""
  STATE_LAST_RESTORED_FROM=""
  if [[ $compact =~ \"last_upgrade\"[[:space:]]*:[[:space:]]*\{ ]]; then
    STATE_ERROR_FIELD=last_upgrade
    last_object=$(state_object_field "$compact" last_upgrade)
    [ -n "$last_object" ] || return 1
    STATE_LAST_AT=$(state_string_field "$last_object" at)
    STATE_LAST_FROM=$(state_string_field "$last_object" from)
    STATE_LAST_TO=$(state_string_field "$last_object" to)
    STATE_LAST_OUTCOME=$(state_string_field "$last_object" outcome)
    STATE_LAST_BACKUP=$(state_string_field "$last_object" backup)
    STATE_LAST_RESTORED_FROM=$(state_string_field "$last_object" restored_from)
    STATE_ERROR_FIELD=last_upgrade.at
    valid_state_time "$STATE_LAST_AT" || return 1
    STATE_ERROR_FIELD=last_upgrade.from
    valid_release_version "$STATE_LAST_FROM" || return 1
    STATE_ERROR_FIELD=last_upgrade.to
    valid_release_version "$STATE_LAST_TO" || return 1
    STATE_ERROR_FIELD=last_upgrade.outcome
    case "$STATE_LAST_OUTCOME" in success | rolled_back | failed) ;; *) return 1 ;; esac
    STATE_ERROR_FIELD=last_upgrade.backup
    valid_state_path "$STATE_LAST_BACKUP" || return 1
    if [ -n "$STATE_LAST_RESTORED_FROM" ]; then
      STATE_ERROR_FIELD=last_upgrade.restored_from
      valid_state_path "$STATE_LAST_RESTORED_FROM" || return 1
    fi
    STATE_LAST_PRESENT=yes
  elif [[ $compact =~ \"last_upgrade\"[[:space:]]*:[[:space:]]*null ]]; then
    :
  elif [[ $compact =~ \"last_upgrade\" ]]; then
    STATE_ERROR_FIELD=last_upgrade
    return 1
  fi
  STATE_ERROR_FIELD=""
}

write_state() { # installed images previous-or-empty [last fields and restored-from]
  local installed=$1 images=$2 previous=$3 at=${4:-} from=${5:-} to=${6:-}
  local outcome=${7:-} backup=${8:-} restored_from=${9:-}
  local images_json previous_json tmp last_json=""
  valid_release_version "$installed" || { fail "state write refused: invalid version"; return 1; }
  images_json=$(image_map_to_json "$images") \
    || { fail "state write refused: invalid image digest"; return 1; }
  if [ -n "$previous" ]; then
    previous_json=$(image_map_to_json "$previous") \
      || { fail "state write refused: invalid previous image digest"; return 1; }
  else
    previous_json=null
  fi
  if [ -n "$at$from$to$outcome$backup$restored_from" ]; then
    valid_state_time "$at" || { fail "state write refused: invalid UTC time"; return 1; }
    if ! valid_release_version "$from" || ! valid_release_version "$to"; then
      fail "state write refused: invalid upgrade version"
      return 1
    fi
    case "$outcome" in success | rolled_back | failed) ;; *)
      fail "state write refused: invalid outcome"; return 1 ;;
    esac
    valid_state_path "$backup" \
      || { fail "state write refused: invalid backup path"; return 1; }
    if [ -n "$restored_from" ]; then
      valid_state_path "$restored_from" \
        || { fail "state write refused: invalid restore path"; return 1; }
    fi
    last_json=",\"last_upgrade\":{\"at\":\"$at\",\"from\":\"$from\",\"to\":\"$to\",\"outcome\":\"$outcome\",\"backup\":\"$backup\""
    [ -z "$restored_from" ] || last_json="$last_json,\"restored_from\":\"$restored_from\""
    last_json="$last_json}"
  fi
  umask 077
  mkdir -p .qradar-dash || return 1
  chmod 700 .qradar-dash || return 1
  tmp=".qradar-dash/.state.json.$$"
  [ ! -e "$tmp" ] || { fail "state temporary file already exists"; return 1; }
  if ! printf '{\n  "installed_version":"%s",\n  "images":%s,\n  "previous_images":%s%s\n}\n' \
      "$installed" "$images_json" "$previous_json" "$last_json" >"$tmp" \
    || ! chmod 600 "$tmp" \
    || ! mv -- "$tmp" .qradar-dash/state.json; then
    rm -f -- "$tmp"
    fail "state file write failed; the previous state was kept"
    return 1
  fi
}

write_install_state() {
  local version images previous="" at="" from="" to="" outcome="" backup="" restored=""
  version=$(env_get QRADAR_DASH_VERSION)
  valid_release_version "$version" || return 1
  images=$(backup_image_digests) || return 1
  if [ -e .qradar-dash/state.json ]; then
    state_read .qradar-dash/state.json || return 1
    previous=$STATE_PREVIOUS_IMAGES
    if [ "$STATE_LAST_PRESENT" = yes ]; then
      at=$STATE_LAST_AT
      from=$STATE_LAST_FROM
      to=$STATE_LAST_TO
      outcome=$STATE_LAST_OUTCOME
      backup=$STATE_LAST_BACKUP
      restored=$STATE_LAST_RESTORED_FROM
    fi
  fi
  write_state "$version" "$images" "$previous" "$at" "$from" "$to" \
    "$outcome" "$backup" "$restored"
}

write_restore_state() { # write_restore_state BACKUP_DIRECTORY
  local backup=$1 version images previous="" at from to outcome recorded_backup
  version=$(manifest_get "$backup" VERSION)
  valid_release_version "$version" || return 1
  images=$(backup_image_digests) || return 1
  if [ -e .qradar-dash/state.json ] && state_read .qradar-dash/state.json; then
    previous=$STATE_PREVIOUS_IMAGES
  fi
  if [ "${STATE_LAST_PRESENT:-no}" = yes ]; then
    at=$STATE_LAST_AT
    from=$STATE_LAST_FROM
    to=$STATE_LAST_TO
    outcome=$STATE_LAST_OUTCOME
    recorded_backup=$STATE_LAST_BACKUP
  else
    at="" from="" to="" outcome="" recorded_backup="" backup=""
  fi
  write_state "$version" "$images" "$previous" "$at" "$from" "$to" \
    "$outcome" "$recorded_backup" "$backup"
}

backup_stamp_epoch() { # directory name qradar-dash-YYYYMMDDTHHMMSSZ-* -> epoch seconds
  local stamp=${1##*/}
  [[ $stamp =~ ^qradar-dash-([0-9]{8})T([0-9]{2})([0-9]{2})([0-9]{2})Z- ]] || return 1
  date -u -d "${BASH_REMATCH[1]:0:4}-${BASH_REMATCH[1]:4:2}-${BASH_REMATCH[1]:6:2}T${BASH_REMATCH[2]}:${BASH_REMATCH[3]}:${BASH_REMATCH[4]}Z" +%s
}

backup_age_seconds() { # directory -> age in seconds; negative or unreadable returns 1
  local stamp_epoch now seconds
  stamp_epoch=$(backup_stamp_epoch "$1") || return 1
  now=$(date -u +%s) || return 1
  seconds=$((now - stamp_epoch))
  [ "$seconds" -ge 0 ] || return 1
  printf '%s\n' "$seconds"
}

format_age() { # seconds -> the same text status already prints
  local seconds=$1
  if [ "$seconds" -lt 3600 ]; then
    printf '%s min\n' "$((seconds / 60))"
  elif [ "$seconds" -lt 86400 ]; then
    printf '%s h\n' "$((seconds / 3600))"
  else
    printf '%s d\n' "$((seconds / 86400))"
  fi
}

backup_stamp_age() { # backup_stamp_age DIR: age from the UTC stamp in the directory name
  local seconds
  seconds=$(backup_age_seconds "$1") || return 1
  format_age "$seconds"
}

state_age() { # ISO-8601 UTC timestamp -> the same text as format_age
  local timestamp now seconds
  timestamp=$(date -u -d "$1" +%s) || return 1
  now=$(date -u +%s) || return 1
  seconds=$((now - timestamp))
  [ "$seconds" -ge 0 ] || return 1
  format_age "$seconds"
}

write_backup_manifest() { # write_backup_manifest DIR DB_SIZE ALEMBIC STATE SECRET_VOLUMES
  local version images host
  version=$(env_get QRADAR_DASH_VERSION)
  if [ -z "$version" ] && [ -r VERSION ]; then version=$(tr -d '[:space:]' <VERSION); fi
  [ -n "$version" ] || return 1
  images=$(backup_image_digests) || return 1
  host=$(hostname) || return 1
  {
    printf 'VERSION=%s\n' "$version"
    printf 'IMAGE_DIGESTS=%s\n' "$images"
    printf 'ALEMBIC_VERSION=%s\n' "$3"
    printf 'DATABASE_SIZE_BYTES=%s\n' "$2"
    printf 'HOSTNAME=%s\n' "$host"
    printf 'STATE_JSON=%s\n' "$4"
    printf 'SECRETS_VOLUMES=%s\n' "$5"
  } >"$1/MANIFEST"
}

state_last_upgrade_fields() { # state_last_upgrade_fields FILE -> OUTCOME<TAB>BACKUP
  local compact object outcome backup
  compact=$(tr -d '\n\r' <"$1") || return 1
  object=$(printf '%s\n' "$compact" \
    | sed -n 's/.*"last_upgrade"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p')
  [ -n "$object" ] || return 1
  outcome=$(printf '%s\n' "$object" \
    | sed -n 's/.*"outcome"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  backup=$(printf '%s\n' "$object" \
    | sed -n 's/.*"backup"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  [ -n "$outcome" ] || return 1
  printf '%s\t%s\n' "$outcome" "$backup"
}

successful_upgrades_after() { # successful_upgrades_after STAMP STATE_FILE BACKUP_ROOT
  local stamp=$1 state=$2 root=$3 text at outcome path fields count=0 candidate_stamp seen="|"
  [ -r "$state" ] || return 1
  text=$(tr -d '\n\r' <"$state") || return 1
  while IFS= read -r fields; do
    at=$(printf '%s\n' "$fields" \
      | sed -n 's/.*"at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      | tr -d -- '-:')
    outcome=$(printf '%s\n' "$fields" \
      | sed -n 's/.*"outcome"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ "$outcome" = success ] && [[ $at > $stamp ]] && [[ $seen != *"|$at|"* ]]; then
      count=$((count + 1))
      seen="$seen$at|"
    fi
  done < <(printf '%s\n' "$text" | sed 's/}/}\n/g')
  for path in "$root"/qradar-dash-*-pre-upgrade; do
    [ -d "$path" ] || continue
    candidate_stamp=${path##*/qradar-dash-}
    candidate_stamp=${candidate_stamp%-pre-upgrade}
    [[ $candidate_stamp > $stamp ]] || continue
    [ -r "$path/state.json" ] || continue
    fields=$(state_last_upgrade_fields "$path/state.json" 2>/dev/null || true)
    outcome=${fields%%$'\t'*}
    at=$(tr -d '\n\r' <"$path/state.json" \
      | sed -n 's/.*"last_upgrade"[[:space:]]*:[[:space:]]*{[^}]*"at"[[:space:]]*:[[:space:]]*"\([^"]*\)"[^}]*}.*/\1/p' \
      | tr -d -- '-:')
    if [ "$outcome" = success ] && [ -n "$at" ] && [[ $seen != *"|$at|"* ]]; then
      count=$((count + 1))
      seen="$seen$at|"
    fi
  done
  printf '%s\n' "$count"
}

backup_path_is_managed() { # exact direct-child backup directory pattern
  local root=$1 path=$2 base
  [ -d "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(dirname -- "$path")" = "$root" ] || return 1
  base=${path##*/}
  [[ $base =~ ^qradar-dash-[0-9]{8}T[0-9]{6}Z-(manual|scheduled|pre-upgrade)$ ]]
}

retention_delete() { # retention_delete ROOT PATH DB_SIZE
  backup_path_is_managed "$1" "$2" || return 1
  if ! backup_disk_guard "$1" "$3" 2 >/dev/null; then
    warn "retention kept backup because the next-backup disk guard does not pass: $2"
    return 1
  fi
  rm -rf -- "$2"
}

apply_backup_retention() { # apply_backup_retention ROOT DB_SIZE
  local root=$1 db_size=$2 path base stamp state=.qradar-dash/state.json
  local fields outcome protected count
  local -a ordinary=()
  protected=""
  if [ -r "$state" ]; then
    fields=$(state_last_upgrade_fields "$state" 2>/dev/null || true)
    outcome=${fields%%$'\t'*}
    if [ "$outcome" = failed ] || [ "$outcome" = rolled_back ]; then
      protected=${fields#*$'\t'}
    fi
  fi
  for path in "$root"/qradar-dash-*-manual "$root"/qradar-dash-*-scheduled; do
    [ -d "$path" ] || continue
    backup_path_is_managed "$root" "$path" || continue
    ordinary+=("$path")
  done
  if [ "${#ordinary[@]}" -gt 7 ]; then
    mapfile -t ordinary < <(printf '%s\n' "${ordinary[@]}" | sort)
    count=$((${#ordinary[@]} - 7))
    for path in "${ordinary[@]:0:count}"; do
      [ "$path" = "$protected" ] || retention_delete "$root" "$path" "$db_size"
    done
  fi
  [ -r "$state" ] || return 0
  for path in "$root"/qradar-dash-*-pre-upgrade; do
    [ -d "$path" ] || continue
    backup_path_is_managed "$root" "$path" || continue
    [ "$path" = "$protected" ] && continue
    base=${path##*/qradar-dash-}
    stamp=${base%-pre-upgrade}
    count=$(successful_upgrades_after "$stamp" "$state" "$root" 2>/dev/null || true)
    case "$count" in '' | *[!0-9]*) continue ;; esac
    [ "$count" -ge 2 ] && retention_delete "$root" "$path" "$db_size"
  done
  return 0
}

BACKUP_SECRETS_VOLUMES=""

write_secrets_backup() { # write_secrets_backup TARGET
  local secrets proxy helper
  local -a mounts entries
  secrets=$(env_get SECRETS_VOLUME)
  proxy=$(env_get PROXY_CERTS_VOLUME)
  : "${secrets:=qradar-observability-secrets}"
  : "${proxy:=qradar-observability-proxy-certs}"
  case "$secrets:$proxy" in *[!A-Za-z0-9_.:-]*) return 1 ;; esac
  helper=$(secrets_helper_image) || {
    fail "deploy/load-secrets.sh has no SECRETS_HELPER_IMAGE pinned by digest (alpine:TAG@sha256:...); this checkout is incomplete; restore deploy/load-secrets.sh"
    return 1
  }
  docker volume inspect "$secrets" >/dev/null 2>&1 || {
    fail "required QRadar secrets volume is missing"
    return 1
  }
  mounts=(-v "$secrets:/volumes/qradar:ro")
  entries=(qradar)
  BACKUP_SECRETS_VOLUMES=qradar
  if docker volume inspect "$proxy" >/dev/null 2>&1; then
    mounts+=(-v "$proxy:/volumes/proxy:ro")
    entries+=(proxy)
    BACKUP_SECRETS_VOLUMES=qradar,proxy
  fi
  # The tar only reads, so both volumes are mounted read-only and the container
  # runs offline with every capability dropped except DAC_READ_SEARCH: the token
  # file is 0400 and owned by the backend account, which root without a DAC read
  # capability may not read.
  docker run --rm --network none --cap-drop ALL --cap-add DAC_READ_SEARCH \
    --security-opt no-new-privileges "${mounts[@]}" \
    "$helper" tar -C /volumes -cf - "${entries[@]}" >"$1"
}

# install.answers holds paths and names, never a secret (its header says so). install writes
# mode 0600; parse_answers also accepts 0400. Either is copied and the mode is kept. Anything
# else is not copied and is not read: upgrade must ignore a file parse_answers would refuse,
# and a symlink is not followed.
answers_file_is_private() { # answers_file_is_private PATH; 0 when regular and mode 0600 or 0400
  local mode
  [ -e "$1" ] || [ -L "$1" ] || return 1
  if [ -L "$1" ] || [ ! -f "$1" ]; then
    return 1
  fi
  mode=$(stat -c '%a' "$1" 2>/dev/null) || return 1
  [ "$mode" = 600 ] || [ "$mode" = 400 ]
}

cmd_backup_create() { # cmd_backup_create REASON VERIFY
  local reason=$1 verify=$2 root stamp name final db_size alembic state_json=absent
  local answers_mode=""
  need_installed
  need_docker || exit 1
  root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -n "$root" ] || die "backup root is not configured; set QRADAR_DASH_BACKUP_DIR."
  [ -d "$root" ] || die "backup root is not a directory: $root"
  db_size=$(database_size_bytes) || die "database size is unavailable; no backup was written."
  backup_storage_guards "$root" "$db_size" "$verify" || return 1
  alembic=$(postgres_sql "$(env_get POSTGRES_DB)" \
    'SELECT version_num FROM alembic_version;' | tr -d '[:space:]') \
    || die "alembic_version is unavailable; no backup was written."
  [ -n "$alembic" ] || die "alembic_version is empty; no backup was written."

  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  name="qradar-dash-$stamp-$reason"
  final="$root/$name"
  BACKUP_STAGE="$root/.$name.partial"
  [ ! -e "$final" ] && [ ! -e "$BACKUP_STAGE" ] \
    || die "backup path already exists: $final"
  umask 077
  mkdir -m 700 -- "$BACKUP_STAGE"
  trap backup_cleanup EXIT
  install_signal_traps

  BACKUP_CONTAINER_DUMP="/tmp/qradar-dash-$stamp.dump"
  dc exec -T postgres pg_dump -U "$(env_get POSTGRES_USER)" -Fc \
    -d "$(env_get POSTGRES_DB)" -f "$BACKUP_CONTAINER_DUMP" \
    || die "database dump failed; the partial backup was removed."
  dc cp "postgres:$BACKUP_CONTAINER_DUMP" "$BACKUP_STAGE/database.dump" \
    || die "database dump copy-out failed; the partial backup was removed."
  dc exec -T postgres rm -f -- "$BACKUP_CONTAINER_DUMP" \
    || die "database dump cleanup failed; the partial backup was removed."
  BACKUP_CONTAINER_DUMP=""
  install -m 600 "$ENV_FILE" "$BACKUP_STAGE/env.bak" \
    || die "environment backup failed; the partial backup was removed."
  # Next to env.bak. Mode is kept (0600 or 0400). An older backup has no such copy, and a
  # file parse_answers would refuse is omitted and not read. Rollback then keeps a private
  # live file and drops keys the target release does not know.
  if answers_file_is_private "$SAVED_ANSWERS"; then
    answers_mode=$(stat -c '%a' "$SAVED_ANSWERS") \
      || die "answers backup failed; the partial backup was removed."
    install -m "$answers_mode" "$SAVED_ANSWERS" "$BACKUP_STAGE/install.answers" \
      || die "answers backup failed; the partial backup was removed."
  fi
  write_secrets_backup "$BACKUP_STAGE/secrets.tar" \
    || die "secrets backup failed; the partial backup was removed."
  if [ -f .qradar-dash/state.json ]; then
    install -m 600 .qradar-dash/state.json "$BACKUP_STAGE/state.json" \
      || die "state backup failed; the partial backup was removed."
    state_json=included
  fi
  write_backup_manifest \
    "$BACKUP_STAGE" "$db_size" "$alembic" "$state_json" "$BACKUP_SECRETS_VOLUMES" \
    || die "backup manifest failed; the partial backup was removed."
  chmod 600 "$BACKUP_STAGE"/*
  # The blanket chmod above is for the dump, env, secrets and manifest. The answers copy
  # keeps the mode it was installed with, including 0400.
  if [ -n "$answers_mode" ]; then
    chmod "$answers_mode" "$BACKUP_STAGE/install.answers" \
      || die "answers backup failed; the partial backup was removed."
  fi

  if [ "$verify" = yes ]; then
    drop_database qradar_obs_restore_test >/dev/null \
      || die "could not clear the backup verification database."
    # From this point cleanup may safely issue DROP IF EXISTS even when copy-in
    # or CREATE DATABASE itself is the failing step.
    BACKUP_SCRATCH_CREATED=yes
    restore_dump_into_database "$BACKUP_STAGE/database.dump" qradar_obs_restore_test \
      || die "backup verification restore failed; the partial backup was removed."
    verify_restored_database qradar_obs_restore_test "$alembic" yes \
      || die "backup verification failed; the partial backup was removed."
    drop_database qradar_obs_restore_test \
      || die "backup verification database cleanup failed; the partial backup was removed."
    BACKUP_SCRATCH_CREATED=no
  fi
  mv -- "$BACKUP_STAGE" "$final"
  BACKUP_STAGE=""
  trap - EXIT HUP INT TERM
  apply_backup_retention "$root" "$db_size"
  say "$final"
}

print_backup_timer() {
  cat <<EOF
# qradar-dash-backup.service
[Unit]
Description=Create a verified QRadar Dash backup

[Service]
Type=oneshot
WorkingDirectory=$ROOT
ExecStart=$ROOT/qradar-dash backup scheduled

# qradar-dash-backup.timer
[Unit]
Description=Create a daily QRadar Dash backup

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=15min
Unit=qradar-dash-backup.service

[Install]
WantedBy=timers.target
EOF
}

install_backup_timer() {
  local unit_dir systemctl_args=()
  if [ "$(id -u)" -eq 0 ]; then
    unit_dir=/etc/systemd/system
  else
    unit_dir=${HOME:?HOME is not set}/.config/systemd/user
    systemctl_args=(--user)
  fi
  mkdir -p -- "$unit_dir"
  print_backup_timer | sed -n '/^# qradar-dash-backup.service$/,/^# qradar-dash-backup.timer$/p' \
    | sed '$d' >"$unit_dir/qradar-dash-backup.service"
  print_backup_timer | sed -n '/^# qradar-dash-backup.timer$/,$p' \
    >"$unit_dir/qradar-dash-backup.timer"
  chmod 644 "$unit_dir/qradar-dash-backup.service" "$unit_dir/qradar-dash-backup.timer"
  systemctl "${systemctl_args[@]}" daemon-reload
  systemctl "${systemctl_args[@]}" enable --now qradar-dash-backup.timer
  say "Installed and enabled backup timer under $unit_dir."
  if [ "${#systemctl_args[@]}" -gt 0 ]; then
    say "A user timer runs only while that user has a session unless lingering is enabled."
    say "Enable lingering if required: loginctl enable-linger $(id -un)"
  fi
}

cmd_backup() {
  local reason=manual verify=yes action=create
  while [ $# -gt 0 ]; do
    case "$1" in
      manual | scheduled | pre-upgrade) reason=$1 ;;
      --no-verify) verify=no ;;
      --print-timer) action=print ;;
      --install-timer) action=install ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown backup option: $1"; return 2 ;;
    esac
    shift
  done
  if [ "$action" != create ]; then
    [ "$reason" = manual ] && [ "$verify" = yes ] \
      || { fail "timer options cannot be combined with a backup reason or --no-verify"; return 2; }
    if [ "$action" = print ]; then print_backup_timer; else install_backup_timer; fi
    return
  fi
  if [ "$reason" = pre-upgrade ] && [ "$verify" = no ]; then
    fail "pre-upgrade backups must be verified"
    return 2
  fi
  cmd_backup_create "$reason" "$verify"
}

backup_directory_complete() { # backup_directory_complete DIRECTORY
  local path=$1 file mode state_json secrets_volumes
  [ -d "$path" ] && [ ! -L "$path" ] || return 1
  mode=$(stat -c '%a' "$path" 2>/dev/null) || return 1
  [ "$mode" = 700 ] || return 1
  for file in database.dump env.bak secrets.tar MANIFEST; do
    [ -f "$path/$file" ] && [ ! -L "$path/$file" ] && [ -s "$path/$file" ] || return 1
    mode=$(stat -c '%a' "$path/$file" 2>/dev/null) || return 1
    [ "$mode" = 600 ] || return 1
  done
  state_json=$(manifest_get "$path" STATE_JSON)
  case "$state_json" in included | absent) ;; *) return 1 ;; esac
  if [ "$state_json" = included ] && [ ! -f "$path/state.json" ]; then return 1; fi
  if [ -e "$path/state.json" ] || [ -L "$path/state.json" ]; then
    [ -f "$path/state.json" ] && [ ! -L "$path/state.json" ] \
      && [ -s "$path/state.json" ] || return 1
    mode=$(stat -c '%a' "$path/state.json" 2>/dev/null) || return 1
    [ "$mode" = 600 ] || return 1
  fi
  secrets_volumes=$(manifest_get "$path" SECRETS_VOLUMES)
  case "$secrets_volumes" in qradar | qradar,proxy) ;; *) return 1 ;; esac
}

version_is_newer() { # version_is_newer CANDIDATE CURRENT
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

encryption_key_compatible() { # encryption_key_compatible BACKUP_ENV
  local backup_key current keys item
  backup_key=$(sed -n 's/^ENCRYPTION_KEY=//p' "$1" | head -n1)
  current=$(env_get ENCRYPTION_KEY)
  [ -n "$backup_key" ] || return 1
  [ "$backup_key" = "$current" ] && return 0
  keys=$(env_get ENCRYPTION_KEYS_JSON)
  keys=${keys#\{}
  keys=${keys%\}}
  keys=${keys//[[:space:]]/}
  keys=${keys//,/$'\n'}
  while IFS= read -r item; do
    [[ $item == *:* ]] || continue
    item=${item#*:}
    item=${item#\"}
    item=${item%\"}
    [ "$item" = "$backup_key" ] && return 0
  done <<<"$keys"
  return 1
}

RESTORE_STOPPED_SERVICES=()

restore_stop_services() {
  local service running_text
  local -a running=()
  running_text=$(dc ps --services --status running) || return 1
  mapfile -t running <<<"$running_text"
  for service in backend celery-worker celery-beat frontend proxy; do
    if printf '%s\n' "${running[@]}" | grep -qx "$service"; then
      RESTORE_STOPPED_SERVICES+=("$service")
    fi
  done
  [ "${#RESTORE_STOPPED_SERVICES[@]}" -gt 0 ] || return 0
  dc stop "${RESTORE_STOPPED_SERVICES[@]}"
}

restore_start_services() {
  [ "${#RESTORE_STOPPED_SERVICES[@]}" -eq 0 ] || dc start "${RESTORE_STOPPED_SERVICES[@]}"
}

restore_failure_before_swap() { # restore_failure_before_swap DATABASE
  drop_database "$1" >/dev/null 2>&1 || true
  restore_start_services || true
}

print_broken_database_instructions() { # print_broken_database_instructions NAME
  say "Previous database kept as $1."
  say "Drop it later only after validation:"
  say "  $(compose_command) exec -T postgres psql -U $(env_get POSTGRES_USER) -d postgres -c 'DROP DATABASE $1;'"
}

restore_swap_database() { # restore_swap_database BACKUP_DIRECTORY REASON
  local backup=$1 reason=$2 stamp db_stamp restored broken live expected
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  db_stamp=${stamp,,}
  restored="qradar_obs_restore_$db_stamp"
  broken="qradar_obs_broken_$db_stamp"
  live=$(env_get POSTGRES_DB)
  validate_database_identifier "$live" || return 1
  expected=$(manifest_get "$backup" ALEMBIC_VERSION)
  RESTORE_STOPPED_SERVICES=()
  if ! restore_stop_services; then
    restore_start_services || true
    return 1
  fi
  if ! restore_dump_into_database "$backup/database.dump" "$restored"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! verify_restored_database "$restored" "$expected"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$live' AND pid <> pg_backend_pid();" \
      >/dev/null; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres "ALTER DATABASE $live RENAME TO $broken;"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres "ALTER DATABASE $restored RENAME TO $live;"; then
    if ! postgres_sql postgres "ALTER DATABASE $broken RENAME TO $live;"; then
      fail "restore swap failed and the original database could not be renamed back"
      say "Original database: $broken"
      say "Restored candidate database: $restored"
      say "Rename the original back with:"
      say "  $(compose_command) exec -T postgres psql -U $(env_get POSTGRES_USER) -d postgres -c 'ALTER DATABASE $broken RENAME TO $live;'"
    fi
    restore_start_services || true
    return 1
  fi
  print_broken_database_instructions "$broken"
  say "Database swap complete ($reason); services remain stopped."
}

restore_start_and_wait() { # restore_start_and_wait BACKUP_DIRECTORY REASON
  local backup=$1 reason=$2 port
  if ! restore_start_services; then
    fail "the database was restored but the stopped services did not all restart"
    return 1
  fi
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  if ! wait_ready "http://127.0.0.1:$port/api/v1/health/ready" 180; then
    fail "the database was restored but readiness did not answer within 180 seconds"
    return 1
  fi
  say "Restore complete ($reason)."
  say "Secrets were not restored. Inspect the archive with:"
  printf '  tar -tf %q\n' "$backup/secrets.tar"
}

cmd_restore() {
  local backup="" non_interactive=no yes=no version current db_size answer
  need_installed
  need_docker || exit 1
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) non_interactive=yes ;;
      --yes) yes=yes ;;
      -h | --help) usage; return 0 ;;
      -*) fail "unknown restore option: $1"; return 2 ;;
      *) [ -z "$backup" ] || { fail "restore accepts one backup path"; return 2; }; backup=$1 ;;
    esac
    shift
  done
  [ -n "$backup" ] || { fail "restore needs a backup directory"; return 2; }
  backup=$(readlink -f -- "$backup") || {
    fail "restore refused: the backup path cannot be resolved"
    return 1
  }
  backup_directory_complete "$backup" || {
    fail "restore refused: the backup directory is incomplete or has unsafe modes"
    return 1
  }
  version=$(manifest_get "$backup" VERSION)
  current=$(env_get QRADAR_DASH_VERSION)
  [ -n "$version" ] && [ -n "$current" ] || {
    fail "restore refused: backup or current image version is unavailable"
    return 1
  }
  if [ "$version" != "$current" ]; then
    if version_is_newer "$version" "$current"; then
      fail "restore refused: backup version is newer; upgrade to that version first"
    else
      fail "restore refused: backup version is older; use rollback, or put that version's images back and then restore"
    fi
    return 1
  fi
  if ! encryption_key_compatible "$backup/env.bak"; then
    fail "restore refused: the backup encryption key is not in the current keyring."
    fail "Put the backup's key back as described in OPERATIONS-DESIGN section 5.1, without replacing or printing keys."
    return 1
  fi
  db_size=$(manifest_get "$backup" DATABASE_SIZE_BYTES)
  case "$db_size" in '' | *[!0-9]*) fail "restore refused: invalid database size in MANIFEST"; return 1 ;; esac
  local docker_root
  docker_root=$(docker_root_path) || {
    fail "restore refused: Docker root directory is unavailable"
    return 1
  }
  backup_disk_guard "$docker_root" "$db_size" 2 || return 1
  # A copy that is not the regular mode-0600 or mode-0400 file backup writes is refused
  # here: no prompt, no stopped container, and the live answers file is left untouched.
  answers_copy_is_acceptable restore "$backup" || return 1
  if [ "$non_interactive" = yes ]; then
    [ "$yes" = yes ] || { fail "--non-interactive restore requires --yes"; return 1; }
  else
    printf 'Type restore to replace the application database: '
    IFS= read -r answer || answer=""
    # Piped input is not echoed, so end the prompt's line ourselves.
    [ -t 0 ] || printf '\n'
    [ "$answer" = restore ] || { fail "restore confirmation was not given"; return 1; }
  fi
  restore_swap_database "$backup" manual || return 1
  # After the swap, and only then. The file is paths and names, not a secret, so this does
  # not restore secrets.tar. No copy means the live file stays and nothing new is printed.
  # A failed copy does not stop the restore. The database is already the backup's, and this
  # file only matters to a later install re-run, so the services still start. The previous
  # file stays; the operator puts the copy back with the printed install command.
  local answers_mode=""
  if [ -e "$backup/install.answers" ] || [ -L "$backup/install.answers" ]; then
    if restore_answers_file restore "$backup/install.answers"; then
      say "Restored $SAVED_ANSWERS (the answers file, not a secret)."
    else
      answers_mode=$(stat -c '%a' "$backup/install.answers" 2>/dev/null || true)
      warn "$SAVED_ANSWERS was not restored; the previous file was kept. Put the copy back by hand: install -m $answers_mode $backup/install.answers $SAVED_ANSWERS"
    fi
  fi
  restore_start_and_wait "$backup" manual || return 1
  write_restore_state "$backup" || {
    fail "restore completed but the state file could not be updated"
    return 1
  }
}

# ---------------------------------------------------------------- upgrade and rollback

UPGRADE_SERVICES=()
UPGRADE_CHECK_FAILURE=""

set_upgrade_services() {
  UPGRADE_SERVICES=(backend celery-worker celery-beat frontend)
  if doctor_profile_enabled proxy; then UPGRADE_SERVICES+=(proxy); fi
  # The backend is the MCP service's only client; one 'up -d --wait' recreates both and
  # waits for the healthcheck, so the argument order is not an ordering guarantee.
  if doctor_profile_enabled mcp; then UPGRADE_SERVICES=(qradar-mcp "${UPGRADE_SERVICES[@]}"); fi
}

ANSWER_ROLLBACK_PLAN=""
ANSWER_ROLLBACK_KEYS=""

# One key per line. ANSWER_KEYS is a double-quoted list that may span lines.
extract_answer_keys() {
  awk '
    function emit(text,    n, i, fields) {
      sub(/"$/, "", text)
      n = split(text, fields, /[[:space:]]+/)
      for (i = 1; i <= n; i++) if (fields[i] != "") print fields[i]
    }
    capture == 0 && /^ANSWER_KEYS="/ {
      text = $0
      sub(/^ANSWER_KEYS="/, "", text)
      if (text ~ /"$/) { emit(text); found = 1; exit }
      emit(text)
      capture = 1
      next
    }
    capture == 1 {
      text = $0
      if (text ~ /"$/) { emit(text); found = 1; exit }
      emit(text)
    }
    END { if (!found) exit 1 }
  ' "$1"
}

# Rollback runs from the newer checkout. The operator checks out the old tag only
# afterwards, so the ANSWER_KEYS on disk are the new release's. The list the old
# installer accepts is the assignment in v<from>:qradar-dash, the file that checkout
# would put on disk. When VERSION is already that release, the file on disk is it.
target_answer_keys() { # target_answer_keys VERSION -> keys, one per line
  local version=$1 checkout="" keys keys_file
  if [ -r VERSION ]; then checkout=$(tr -d '[:space:]' <VERSION); fi
  if [ "$checkout" = "$version" ] && [ -f "$ROOT/qradar-dash" ] && [ ! -L "$ROOT/qradar-dash" ]; then
    keys=$(extract_answer_keys "$ROOT/qradar-dash") || return 1
  else
    keys_file=".qradar-dash/.answer-keys.$$"
    if ! git --no-pager show "v${version}:qradar-dash" >"$keys_file" 2>/dev/null; then
      rm -f -- "$keys_file"
      return 1
    fi
    keys=$(extract_answer_keys "$keys_file") || { rm -f -- "$keys_file"; return 1; }
    rm -f -- "$keys_file"
  fi
  [ -n "$keys" ] || return 1
  printf '%s\n' "$keys"
}

answer_key_known() {
  local k
  for k in $ANSWER_ROLLBACK_KEYS; do
    [ "$k" = "$1" ] && return 0
  done
  return 1
}

# 0 when BACKUP has no install.answers, or a regular mode-0600 or mode-0400 copy and .secrets
# is not a symlink. A symlink is not followed. Anything else is refused before a prompt or a
# stopped container, and the live file is left as it is.
answers_copy_is_acceptable() { # answers_copy_is_acceptable COMMAND BACKUP
  local command=$1 backup=$2 path="$2/install.answers" mode
  if [ ! -e "$path" ] && [ ! -L "$path" ]; then
    return 0
  fi
  if [ -L "$path" ] || [ ! -f "$path" ]; then
    fail "$command refused: $path is not a regular file"
    return 1
  fi
  mode=$(stat -c '%a' "$path" 2>/dev/null) || {
    fail "$command refused: $path mode could not be read"
    return 1
  }
  if [ "$mode" != 600 ] && [ "$mode" != 400 ]; then
    fail "$command refused: $path has mode $mode; it must be 0600 or 0400"
    return 1
  fi
  # Restoring writes under .secrets. A symlink would land the file outside the checkout.
  if [ -L .secrets ]; then
    fail "$command refused: .secrets is a symlink; $SAVED_ANSWERS was left unchanged"
    return 1
  fi
  return 0
}

prepare_answer_rollback() { # prepare_answer_rollback BACKUP VERSION; sets ANSWER_ROLLBACK_*
  local backup=$1 version=$2
  ANSWER_ROLLBACK_PLAN=""
  ANSWER_ROLLBACK_KEYS=""
  answers_copy_is_acceptable rollback "$backup" || return 1
  if [ -e "$backup/install.answers" ] || [ -L "$backup/install.answers" ]; then
    ANSWER_ROLLBACK_PLAN=restore
    return 0
  fi
  if [ ! -e "$SAVED_ANSWERS" ] && [ ! -L "$SAVED_ANSWERS" ]; then
    ANSWER_ROLLBACK_PLAN=none
    return 0
  fi
  # Not an answers file install would read. Leave it, and do not block the database rollback:
  # upgrade already ignores this file. A symlink is not followed.
  if ! answers_file_is_private "$SAVED_ANSWERS"; then
    ANSWER_ROLLBACK_PLAN=none
    return 0
  fi
  if [ -L .secrets ]; then
    fail "rollback refused: .secrets is a symlink; $SAVED_ANSWERS was left unchanged"
    return 1
  fi
  ANSWER_ROLLBACK_KEYS=$(target_answer_keys "$version") || {
    fail "rollback refused: cannot read the answer keys of v$version (git show v$version:qradar-dash)"
    return 1
  }
  ANSWER_ROLLBACK_PLAN=strip
}

restore_answers_file() { # restore_answers_file COMMAND SRC; atomic, source mode, next to .env
  local command=$1 src=$2 mode tmp
  if [ -L .secrets ]; then
    fail "$command refused: .secrets is a symlink; $SAVED_ANSWERS was left unchanged"
    return 1
  fi
  if [ -L "$src" ] || [ ! -f "$src" ]; then
    fail "$command refused: $src is not a regular file"
    return 1
  fi
  mode=$(stat -c '%a' "$src" 2>/dev/null) || {
    fail "$command refused: $src mode could not be read"
    return 1
  }
  if [ "$mode" != 600 ] && [ "$mode" != 400 ]; then
    fail "$command refused: $src has mode $mode; it must be 0600 or 0400"
    return 1
  fi
  mkdir -p -- .secrets || return 1
  chmod 700 .secrets || return 1
  tmp="$SAVED_ANSWERS.restore.$$"
  umask 077
  if ! install -m "$mode" "$src" "$tmp" || ! mv -- "$tmp" "$SAVED_ANSWERS"; then
    rm -f -- "$tmp"
    # restore warns and continues: the swap has already succeeded. Rollback still stops.
    if [ "$command" != restore ]; then
      fail "$command could not restore $SAVED_ANSWERS; the previous file was kept"
    fi
    return 1
  fi
}

strip_unknown_answer_keys() { # strip_unknown_answer_keys VERSION; names only, other lines kept
  local version=$1 line key tmp="$SAVED_ANSWERS.strip.$$" removed="" mode
  [ -n "$ANSWER_ROLLBACK_KEYS" ] || {
    fail "rollback refused: the answer key list for $version is empty; $SAVED_ANSWERS was left unchanged"
    return 1
  }
  # Sibling temp, then the same mode, then rename. The account owns a 0400 file and
  # .secrets is writable, so the live file itself is not chmod'd.
  mode=$(stat -c '%a' "$SAVED_ANSWERS" 2>/dev/null) || return 1
  if [ "$mode" != 600 ] && [ "$mode" != 400 ]; then
    fail "rollback refused: $SAVED_ANSWERS has mode $mode; it must be 0600 or 0400"
    return 1
  fi
  umask 077
  : >"$tmp" || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ ^([A-Z][A-Z0-9_]*)= ]]; then
      key=${BASH_REMATCH[1]}
      if ! answer_key_known "$key"; then
        removed="${removed:+$removed }$key"
        continue
      fi
    fi
    printf '%s\n' "$line" >>"$tmp" || { rm -f -- "$tmp"; return 1; }
  done <"$SAVED_ANSWERS"
  if [ -z "$removed" ]; then
    rm -f -- "$tmp"
    return 0
  fi
  if ! chmod "$mode" "$tmp" || ! mv -- "$tmp" "$SAVED_ANSWERS"; then
    rm -f -- "$tmp"
    fail "rollback could not update $SAVED_ANSWERS; the previous file was kept"
    return 1
  fi
  for key in $removed; do
    say "Removed answer key $key (unknown to $version)."
  done
}

apply_answer_rollback() { # apply_answer_rollback BACKUP VERSION
  [ -n "$ANSWER_ROLLBACK_PLAN" ] || prepare_answer_rollback "$1" "$2" || return 1
  case "$ANSWER_ROLLBACK_PLAN" in
    none) return 0 ;;
    restore) restore_answers_file rollback "$1/install.answers" ;;
    strip) strip_unknown_answer_keys "$2" ;;
    *) fail "rollback refused: answers were not prepared"; return 1 ;;
  esac
}

set_env_version() { # set_env_version VERSION
  local version=$1 tmp="$ENV_FILE.version.$$" count
  valid_release_version "$version" || return 1
  count=$(grep -c '^QRADAR_DASH_VERSION=' "$ENV_FILE" 2>/dev/null || true)
  [ "$count" -eq 1 ] || {
    fail "$ENV_FILE must contain exactly one QRADAR_DASH_VERSION line"
    return 1
  }
  umask 077
  if ! sed "s/^QRADAR_DASH_VERSION=.*/QRADAR_DASH_VERSION=$version/" \
      "$ENV_FILE" >"$tmp" \
    || ! chmod 600 "$tmp" \
    || ! mv -- "$tmp" "$ENV_FILE"; then
    rm -f -- "$tmp"
    fail "$ENV_FILE version update failed; the previous file was kept"
    return 1
  fi
}

release_notes_fields() { # release_notes_fields TEXT -> version<TAB>min_from
  local text=$1 front version min_from count
  [ "$(printf '%s\n' "$text" | sed -n '1p')" = "---" ] || return 1
  front=$(printf '%s\n' "$text" \
    | awk 'NR == 1 {next} /^---[[:space:]]*$/ {found=1; exit} {print}
        END {if (!found) exit 1}') || return 1
  count=$(printf '%s\n' "$front" | grep -c '^version:[[:space:]]*' || true)
  [ "$count" -eq 1 ] || return 1
  count=$(printf '%s\n' "$front" | grep -c '^min_from:[[:space:]]*' || true)
  [ "$count" -eq 1 ] || return 1
  version=$(printf '%s\n' "$front" \
    | sed -n 's/^version:[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')
  min_from=$(printf '%s\n' "$front" \
    | sed -n 's/^min_from:[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')
  valid_release_version "$version" && valid_release_version "$min_from" || return 1
  printf '%s\t%s\n' "$version" "$min_from"
}

UPGRADE_MISSING_IMAGE=""

upgrade_pull_target() { # upgrade_pull_target VERSION OFFLINE; offline, UPGRADE_MISSING_IMAGE names what is absent
  local target=$1 offline=$2 prefix service ref
  local -a services=(postgres redis backend frontend)
  doctor_profile_enabled proxy && services+=(proxy)
  doctor_profile_enabled mcp && services+=(qradar-mcp)
  UPGRADE_MISSING_IMAGE=""
  if [ "$offline" = no ]; then
    QRADAR_DASH_VERSION=$target dc pull "${services[@]}"
    return
  fi
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=$DEFAULT_IMAGE_PREFIX}"
  for service in postgres backend frontend; do
    ref=$prefix/$service:$target
    docker image inspect "$ref" >/dev/null 2>&1 || { UPGRADE_MISSING_IMAGE=$ref; return 1; }
  done
  if doctor_profile_enabled proxy; then
    ref=$prefix/proxy:$target
    docker image inspect "$ref" >/dev/null 2>&1 || { UPGRADE_MISSING_IMAGE=$ref; return 1; }
  fi
  if doctor_profile_enabled mcp; then
    ref=$prefix/qradar-mcp:$target
    docker image inspect "$ref" >/dev/null 2>&1 || { UPGRADE_MISSING_IMAGE=$ref; return 1; }
  fi
  ref=$(redis_ref) || { UPGRADE_MISSING_IMAGE="redis (docker-compose.prod.yml pins no digest)"; return 1; }
  docker image inspect "$ref" >/dev/null 2>&1 || { UPGRADE_MISSING_IMAGE=$ref; return 1; }
  # the pre-upgrade backup tars the secrets volumes with this image, and an
  # offline host cannot let `docker run` pull it
  ref=$(secrets_helper_image) \
    || { UPGRADE_MISSING_IMAGE="secrets helper (deploy/load-secrets.sh pins no digest)"; return 1; }
  docker image inspect "$ref" >/dev/null 2>&1 || { UPGRADE_MISSING_IMAGE=$ref; return 1; }
}

read_target_release_notes() { # read_target_release_notes VERSION
  local target=$1 prefix notes fields version min_from
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=$DEFAULT_IMAGE_PREFIX}"
  notes=$(docker run --rm --entrypoint cat "$prefix/backend:$target" \
    "/app/releases/$target.md") || return 1
  fields=$(release_notes_fields "$notes") || return 1
  IFS=$'\t' read -r version min_from <<<"$fields"
  [ "$version" = "$target" ] || return 1
  printf '%s\n' "$min_from"
}

# Only db_connect and migration_head decide an upgrade or rollback; the rest of the report
# (a beat heartbeat not written yet, QRadar checks) would read as a failed upgrade.
print_deciding_checks() { # print_deciding_checks REPORT
  printf '%s\n' "$1" | grep -E '^[A-Z]+[[:space:]]+(db_connect|migration_head)([[:space:]]|$)' || true
  say "Full report: ./qradar-dash doctor"
}

upgrade_doctor_preflight() {
  local report
  report=$(cmd_doctor || true)
  print_deciding_checks "$report"
  if printf '%s\n' "$report" \
      | grep -Eq '^FAIL[[:space:]]+(db_connect|migration_head)([[:space:]]|$)'; then
    fail "upgrade refused: database readiness is already failing; see runbook OPS-R11"
    return 1
  fi
  # Fail closed: a doctor that could not report either check proves nothing.
  if ! printf '%s\n' "$report" | grep -Eq '^PASS[[:space:]]+db_connect([[:space:]]|$)' \
    || ! printf '%s\n' "$report" | grep -Eq '^PASS[[:space:]]+migration_head([[:space:]]|$)'; then
    fail "upgrade refused: doctor did not report db_connect and migration_head as PASS; see runbook OPS-R11"
    return 1
  fi
}

upgrade_runtime_checks() { # upgrade_runtime_checks EXPECTED_VERSION
  local expected=$1 port api ready="" reported reported_version report left=180
  UPGRADE_CHECK_FAILURE=""
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  api="http://127.0.0.1:$port/api/v1"
  while [ "$left" -gt 0 ]; do
    ready=$(curl -fsS --max-time 5 "$api/health/ready" 2>/dev/null || true)
    if grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$ready"; then break; fi
    sleep 3
    left=$((left - 3))
  done
  if ! grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$ready"; then
    UPGRADE_CHECK_FAILURE="readiness did not report database ok within 180 seconds"
    return 1
  fi
  reported=$(curl -fsS --max-time 5 "$api/version" 2>/dev/null) || {
    UPGRADE_CHECK_FAILURE="version endpoint did not answer 200"
    return 1
  }
  reported_version=$(state_string_field "$reported" version)
  if [ "$reported_version" != "$expected" ]; then
    UPGRADE_CHECK_FAILURE="version endpoint did not report $expected"
    return 1
  fi
  report=$(cmd_doctor || true)
  print_deciding_checks "$report"
  if ! printf '%s\n' "$report" \
      | grep -Eq '^PASS[[:space:]]+db_connect([[:space:]]|$)'; then
    UPGRADE_CHECK_FAILURE="doctor db_connect is not PASS"
    return 1
  fi
  if ! printf '%s\n' "$report" \
      | grep -Eq '^PASS[[:space:]]+migration_head([[:space:]]|$)'; then
    UPGRADE_CHECK_FAILURE="doctor migration_head is not PASS"
    return 1
  fi
}

image_map_digest() { # image_map_digest MAP SERVICE
  local item service
  while IFS= read -r item; do
    service=${item%%:*}
    [ "$service" = "$2" ] && { printf '%s\n' "${item#*:}"; return 0; }
  done < <(printf '%s\n' "${1//,/$'\n'}")
  return 1
}

PREVIOUS_IMAGE_PROBLEM=""
previous_images_are_local() { # previous_images_are_local MAP
  local item digest actual service
  PREVIOUS_IMAGE_PROBLEM=""
  validate_image_map "$1" || { PREVIOUS_IMAGE_PROBLEM="the image map is invalid"; return 1; }
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    service=${item%%:*}
    digest=${item#*:}
    actual=$(docker image inspect --format '{{.Id}}' "$digest" 2>/dev/null) || {
      PREVIOUS_IMAGE_PROBLEM="service $service digest $digest is not a local image"
      return 1
    }
    if [ "$actual" != "$digest" ]; then
      PREVIOUS_IMAGE_PROBLEM="service $service digest $digest has local id $actual"
      return 1
    fi
  done < <(printf '%s\n' "${1//,/$'\n'}")
}

rollback_service_image() { # rollback_service_image SERVICE
  case "$1" in
    celery-worker | celery-beat) say backend ;;
    *) say "$1" ;;
  esac
}

rollback_service_profile() { # rollback_service_profile SERVICE
  case "$1" in
    qradar-mcp) say mcp ;;
    *) say "$1" ;;
  esac
}

rollback_unrecorded_images_are_ready() { # rollback_unrecorded_images_are_ready MAP VERSION
  local map=$1 version=$2 prefix service image ref profile
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=$DEFAULT_IMAGE_PREFIX}"
  for service in "${UPGRADE_SERVICES[@]}"; do
    image_map_digest "$map" "$service" >/dev/null 2>&1 && continue
    image=$(rollback_service_image "$service")
    ref=$prefix/$image:$version
    if docker image inspect "$ref" >/dev/null 2>&1; then
      say "$service: no recorded image; using $ref (local)"
      continue
    fi
    if docker pull "$ref"; then
      say "$service: no recorded image; using $ref (pulled)"
      continue
    fi
    profile=$(rollback_service_profile "$service")
    fail "rollback refused: $service has no recorded image from the upgrade and $ref is neither local nor pullable. Next: load the $version offline bundle (docker load -i …/images.tar), or remove $profile from COMPOSE_PROFILES and run rollback again. Nothing was changed."
    return 1
  done
}

tag_previous_images() { # tag_previous_images MAP VERSION
  local map=$1 version=$2 prefix service digest
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=$DEFAULT_IMAGE_PREFIX}"
  for service in postgres backend frontend proxy qradar-mcp; do
    digest=$(image_map_digest "$map" "$service" 2>/dev/null || true)
    [ -n "$digest" ] || continue
    docker tag "$digest" "$prefix/$service:$version" || return 1
  done
}

UPGRADE_RESTART_OLD=no

upgrade_restart_old() { # start the stopped services again, on the old images
  [ "$UPGRADE_RESTART_OLD" = yes ] || return 0
  UPGRADE_RESTART_OLD=no
  restore_start_services || fail "the stopped services did not all restart; run: ./qradar-dash doctor"
}

start_upgrade_services() {
  dc up -d --wait --wait-timeout 180 "${UPGRADE_SERVICES[@]}"
}

record_rollback_failure() { # backup old-version old-images from to at
  local backup=$1 old_version=$2 old_images=$3 from=$4 to=$5 at=$6
  restore_stop_services >/dev/null 2>&1 || true
  say "Rollback failed; the writers and the UI are stopped. Verified backup: $backup"
  say "Nothing further was attempted. Run ./qradar-dash rollback again once the cause is fixed,"
  say "or ./qradar-dash restore $backup"
  write_state "$old_version" "$old_images" "$old_images" "$at" "$from" "$to" \
    failed "$backup" || true
  return 1
}

# The stack is already healthy. say (not fail) so the exact sentence is on stdout;
# write_state has already printed its own failure.
report_bookkeeping_failure() { # upgrade|rollback
  local kind=$1 port api code body version="unknown" rc=0
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  api="http://127.0.0.1:$port/api/v1"
  if code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$api/health/ready"); then
    rc=0
  else
    rc=$?
    code=${code:-none}
  fi
  if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then
    if body=$(curl -fsS --max-time 5 "$api/version" 2>/dev/null); then
      version=$(state_string_field "$body" version)
      [ -n "$version" ] || version=unknown
    fi
    say "Running now: version $version, healthy (HTTP 200 from $api/health/ready)."
  else
    say "Running now: health check of $api/health/ready returned HTTP ${code:-none} (curl exit $rc)."
  fi
  if state_read .qradar-dash/state.json; then
    if [ "$STATE_LAST_PRESENT" = yes ]; then
      say "state.json says installed_version $STATE_INSTALLED_VERSION, last_upgrade outcome $STATE_LAST_OUTCOME ($STATE_LAST_FROM -> $STATE_LAST_TO)."
    else
      say "state.json says installed_version $STATE_INSTALLED_VERSION, last_upgrade is missing."
    fi
  else
    say "state.json could not be read (field ${STATE_ERROR_FIELD:-json})."
  fi
  if [ "$kind" = rollback ]; then
    say "The rollback itself succeeded; do not roll back again."
  else
    say "The upgrade itself succeeded; do not roll back."
  fi
  say "Repair the record: ./qradar-dash repair-state"
}

# A manual rollback writes "failed" before it reads the digests, so a later failure leaves a
# record repair-state may replace. When that first write itself fails, state.json still holds
# the upgrade's success record; the running version is what proves the rollback happened, and
# repair-state accepts exactly that case.
report_rollback_record_not_written() {
  local port api code body version=unknown rc=0
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  api="http://127.0.0.1:$port/api/v1"
  if code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$api/health/ready"); then
    rc=0
  else
    rc=$?
    code=${code:-none}
  fi
  if [ "$rc" -eq 0 ] && [ "$code" = 200 ]; then
    if body=$(curl -fsS --max-time 5 "$api/version" 2>/dev/null); then
      version=$(state_string_field "$body" version)
      [ -n "$version" ] || version=unknown
    fi
    say "The rollback ran. Running now: version $version, healthy (HTTP 200 from $api/health/ready)."
  else
    say "The rollback ran. Running now: health check of $api/health/ready returned HTTP ${code:-none} (curl exit $rc)."
  fi
  if state_read .qradar-dash/state.json; then
    say "The state file .qradar-dash/state.json could not be written; it still says installed_version $STATE_INSTALLED_VERSION, last_upgrade outcome $STATE_LAST_OUTCOME ($STATE_LAST_FROM -> $STATE_LAST_TO)."
  else
    say "The state file .qradar-dash/state.json could not be written; it could not be read back (field ${STATE_ERROR_FIELD:-json})."
  fi
  say "Next: fix permissions of .qradar-dash, then run ./qradar-dash repair-state."
}

perform_rollback() { # backup old-version old-images from to at
  local backup=$1 old_version=$2 old_images=$3 from=$4 to=$5 at=$6 images
  # Refuse before the database swap when the answers file cannot be made readable by the
  # target. Upgrade's own backup carries the file, so this is the older-backup path.
  prepare_answer_rollback "$backup" "$old_version" || return 1
  if ! restore_swap_database "$backup" rollback; then
    record_rollback_failure "$backup" "$old_version" "$old_images" "$from" "$to" "$at"
    return 1
  fi
  # The version line in .env, then the answers file beside it.
  if ! set_env_version "$old_version" \
    || ! apply_answer_rollback "$backup" "$old_version" \
    || ! tag_previous_images "$old_images" "$old_version" \
    || ! start_upgrade_services \
    || ! upgrade_runtime_checks "$old_version"; then
    [ -z "$UPGRADE_CHECK_FAILURE" ] || fail "$UPGRADE_CHECK_FAILURE"
    record_rollback_failure "$backup" "$old_version" "$old_images" "$from" "$to" "$at"
    return 1
  fi
  # A manual rollback of a successful upgrade still has outcome success until this write.
  # Mark failed first, after the stack is healthy and before the digest, so a failed final
  # write can be repaired. Do not do it before the database swap: a crash there must not
  # let repair-state record success of a rollback that never happened. An upgrade's
  # automatic rollback already recorded failed, so it is left as it is.
  if [ "$STATE_LAST_OUTCOME" != failed ] || [ -n "$STATE_LAST_RESTORED_FROM" ]; then
    write_state "$old_version" "$old_images" "$old_images" "$at" "$from" "$to" \
      failed "$backup" || {
      report_rollback_record_not_written
      return 1
    }
  fi
  images=$(backup_image_digests) || {
    report_bookkeeping_failure rollback
    return 1
  }
  write_state "$old_version" "$images" "" "$at" "$from" "$to" rolled_back "$backup" \
    || {
    report_bookkeeping_failure rollback
    return 1
  }
  say "Rollback complete."
}

# The image prefix moves with the repository rename. It runs inside upgrade, after every refusal
# that needs no registry and before anything is pulled or read from the target's images.
# Only an exact old prefix (or an absent key, where the old compose default applied) moves; any
# other value is the operator's own registry or mirror. Order: tag locally first, so a missing
# image refuses the upgrade with nothing changed; then the answers file, then .env, so a failure
# between the two leaves a state that a second run repairs.
rewrite_prefix_file() { # rewrite_prefix_file FILE KEY NEWLINE-IF-ABSENT(yes|no)
  local file=$1 key=$2 append=$3 tmp="$1.prefix.$$" count
  count=$(grep -c "^$key=" "$file" 2>/dev/null || true)
  [ "$count" -le 1 ] || {
    fail "$file has more than one $key line"
    return 1
  }
  umask 077
  if [ "$count" -eq 1 ]; then
    sed "s|^$key=.*|$key=$DEFAULT_IMAGE_PREFIX|" "$file" >"$tmp" || { rm -f -- "$tmp"; return 1; }
  elif [ "$append" = yes ]; then
    { cat -- "$file"; printf '%s=%s\n' "$key" "$DEFAULT_IMAGE_PREFIX"; } >"$tmp" \
      || { rm -f -- "$tmp"; return 1; }
  else
    return 0
  fi
  if ! chmod 600 "$tmp" || ! mv -- "$tmp" "$file"; then
    rm -f -- "$tmp"
    fail "$file image prefix update failed; the previous file was kept"
    return 1
  fi
}

migrate_image_prefix() { # migrate_image_prefix INSTALLED_VERSION
  local installed=$1 prefix service entry
  local -a services=(postgres backend frontend)
  [ -f "$ENV_FILE" ] || return 0
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  [ "$prefix" != "$DEFAULT_IMAGE_PREFIX" ] || return 0
  if [ "$(grep -c '^QRADAR_DASH_IMAGE_PREFIX=' "$ENV_FILE" || true)" -gt 1 ]; then
    fail "upgrade refused: $ENV_FILE has more than one QRADAR_DASH_IMAGE_PREFIX line; nothing was changed"
    return 1
  fi
  if [ -n "$prefix" ] && [ "$prefix" != "$OLD_IMAGE_PREFIX" ]; then
    say "Image prefix $prefix is not the old default; left as it is. The registry or mirror must carry the target's images under that prefix."
    return 0
  fi
  if doctor_profile_enabled proxy; then services+=(proxy); fi
  if doctor_profile_enabled mcp; then services+=(qradar-mcp); fi
  for service in "${services[@]}"; do
    docker image inspect "$OLD_IMAGE_PREFIX/$service:$installed" >/dev/null 2>&1 || {
      fail "upgrade refused: the installed image $OLD_IMAGE_PREFIX/$service:$installed is not on this host, so the image prefix cannot move; nothing was changed"
      return 1
    }
  done
  for service in "${services[@]}"; do
    docker tag "$OLD_IMAGE_PREFIX/$service:$installed" \
      "$DEFAULT_IMAGE_PREFIX/$service:$installed" || {
      fail "upgrade refused: tagging $service under $DEFAULT_IMAGE_PREFIX failed; nothing was changed"
      return 1
    }
  done
  if [ -f "$SAVED_ANSWERS" ]; then
    entry=$(sed -n 's/^IMAGE_PREFIX=//p' "$SAVED_ANSWERS" | head -n1)
    if [ "$entry" = "$OLD_IMAGE_PREFIX" ]; then
      rewrite_prefix_file "$SAVED_ANSWERS" IMAGE_PREFIX no || return 1
    fi
  fi
  rewrite_prefix_file "$ENV_FILE" QRADAR_DASH_IMAGE_PREFIX yes || return 1
  say "Image prefix moved: $OLD_IMAGE_PREFIX -> $DEFAULT_IMAGE_PREFIX (the repository was renamed)."
}

set_env_line() { # set_env_line KEY VALUE: replace the one KEY= line, or append it; mode 0600
  local key=$1 value=$2 tmp="$ENV_FILE.fwd.$$"
  umask 077
  if grep -q "^$key=" "$ENV_FILE"; then
    awk -v k="$key" -v v="$value" 'index($0, k "=") == 1 && !done { print k "=" v; done = 1; next } { print }' \
      "$ENV_FILE" >"$tmp" || { rm -f -- "$tmp"; return 1; }
  else
    { cat -- "$ENV_FILE"; printf '%s=%s\n' "$key" "$value"; } >"$tmp" || { rm -f -- "$tmp"; return 1; }
  fi
  if ! chmod 600 "$tmp" || ! mv -- "$tmp" "$ENV_FILE"; then
    rm -f -- "$tmp"
    fail "$ENV_FILE update of $key failed; the previous file was kept"
    return 1
  fi
}

# 0.1.9 (RL-1): the frontend is a second trusted forwarder. An older .env has no FRONTEND_EDGE_IP
# and a FORWARDED_ALLOW_IPS that lists the proxy only. Both are brought along; nothing else moves.
migrate_forwarded_allow_ips() {
  local frontend proxy list new key
  [ -f "$ENV_FILE" ] || return 0
  for key in FRONTEND_EDGE_IP FORWARDED_ALLOW_IPS; do
    if [ "$(grep -c "^$key=" "$ENV_FILE" || true)" -gt 1 ]; then
      fail "upgrade refused: $ENV_FILE has more than one $key line; nothing was changed"
      return 1
    fi
  done
  # A .env with no FORWARDED_ALLOW_IPS line, an empty one or "*" is not ours to rewrite.
  list=$(env_get FORWARDED_ALLOW_IPS)
  if [ -z "$list" ] || [ "$list" = "*" ]; then return 0; fi
  frontend=$(env_get FRONTEND_EDGE_IP)
  if [ -z "$frontend" ]; then
    proxy=$(env_get PROXY_EDGE_IP)
    frontend=$(next_address "${proxy:-172.28.10.10}")
  fi
  new=$(forwarded_with_frontend "$list" "$frontend")
  [ "$new" != "$list" ] || return 0
  if ! env_has_key FRONTEND_EDGE_IP; then
    set_env_line FRONTEND_EDGE_IP "$frontend" || return 1
    say "Frontend address $frontend added to $ENV_FILE (FRONTEND_EDGE_IP)."
  fi
  set_env_line FORWARDED_ALLOW_IPS "$new" || return 1
  say "FORWARDED_ALLOW_IPS now also trusts the frontend ($frontend): $new"
}

cmd_upgrade() {
  local target="" offline=no bundle="" installed min_from db_size backup_root old_images prefix
  local backup_output backup at new_images old_env_version checkout_version
  need_installed
  need_docker || exit 1
  report_compose_override
  while [ $# -gt 0 ]; do
    case "$1" in
      --offline)
        offline=yes
        # An optional bundle file follows; a version or another option does not.
        if [ $# -ge 2 ] && [[ $2 != -* ]] && ! valid_release_version "$2"; then
          bundle=$(user_path "$2")
          shift
        fi
        ;;
      -h | --help) usage; return 0 ;;
      -*) fail "unknown upgrade option: $1"; return 2 ;;
      *) [ -z "$target" ] || { fail "upgrade accepts one version"; return 2; }; target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || { fail "upgrade needs a version"; return 2; }
  valid_release_version "$target" || {
    fail "upgrade version must be plain SemVer (MAJOR.MINOR.PATCH)"
    return 1
  }
  checkout_version=$(read_checkout_version "upgrade $target")
  if [ "$checkout_version" != "$target" ]; then
    fail "upgrade refused: this checkout is version ${checkout_version:-unknown}, not $target; run git fetch --tags && git checkout v$target first (see docs/OPERATIONS.md, Yükseltme)"
    return 1
  fi
  state_read .qradar-dash/state.json || {
    fail "upgrade refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    return 1
  }
  installed=$STATE_INSTALLED_VERSION
  set_upgrade_services
  if [ "$installed" = "$target" ]; then
    if upgrade_runtime_checks "$target"; then
      say "Version $target is already installed and healthy; nothing changed."
      return 0
    fi
    fail "version $target is recorded but the running stack is not healthy: $UPGRADE_CHECK_FAILURE"
    return 1
  fi
  if version_is_newer "$installed" "$target"; then
    fail "upgrade refused: $installed is newer than $target; that is rollback"
    return 1
  fi
  refuse_if_last_upgrade_failed upgrade || return 1
  migrate_image_prefix "$installed" || return 1
  migrate_forwarded_allow_ips || return 1
  if [ -n "$bundle" ]; then
    [ -r "$bundle" ] || { fail "upgrade refused: bundle not readable: $bundle; no container was stopped"; return 1; }
    prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
    bundle_precheck "$bundle" "$target" "the upgrade target" "${prefix:-$DEFAULT_IMAGE_PREFIX}"
    bundle_load "$bundle"
  fi
  upgrade_pull_target "$target" "$offline" || {
    if [ "$offline" = yes ] && [ -n "$UPGRADE_MISSING_IMAGE" ]; then
      if [ -n "$bundle" ]; then
        fail "upgrade refused: target images are unavailable: image $UPGRADE_MISSING_IMAGE is not on this host although the bundle was loaded (the bundle was made for another image prefix or profile set); no container was stopped; make the bundle again on a connected host with ./qradar-dash bundle"
      else
        fail "upgrade refused: target images are unavailable: image $UPGRADE_MISSING_IMAGE is not loaded on this host; no container was stopped; pass the bundle: ./qradar-dash upgrade $target --offline /path/to/qradar-dash-$target-bundle.tar"
      fi
    else
      fail "upgrade refused: target images are unavailable; no container was stopped"
    fi
    return 1
  }
  min_from=$(read_target_release_notes "$target") || {
    fail "upgrade refused: target release notes are missing, invalid, or for another version"
    return 1
  }
  version_ge "$installed" "$min_from" || {
    fail "upgrade refused: $target requires at least $min_from"
    return 1
  }
  backup_root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -d "$backup_root" ] || { fail "upgrade refused: backup root is unavailable"; return 1; }
  db_size=$(database_size_bytes) || {
    fail "upgrade refused: database size is unavailable"
    return 1
  }
  backup_storage_guards "$backup_root" "$db_size" yes || return 1
  upgrade_doctor_preflight || return 1
  old_images=$(backup_image_digests) || {
    fail "upgrade refused: running image digests are unavailable"
    return 1
  }
  old_env_version=$(env_get QRADAR_DASH_VERSION)
  if [ "$old_env_version" != "$installed" ]; then
    fail "upgrade refused: $ENV_FILE has QRADAR_DASH_VERSION=${old_env_version:-unset} but the state file says $installed"
    return 1
  fi
  at=$(state_now) || {
    fail "upgrade refused: the UTC time is unavailable"
    return 1
  }
  RESTORE_STOPPED_SERVICES=()
  UPGRADE_RESTART_OLD=yes
  trap upgrade_restart_old EXIT
  install_signal_traps
  if ! restore_stop_services; then
    upgrade_restart_old
    fail "upgrade could not stop all writer and UI services"
    return 1
  fi
  # A subshell: cmd_backup_create calls die and sets its own EXIT trap. Called directly, a
  # failed backup would exit this script and replace the trap that restarts the old services.
  if ! backup_output=$( (cmd_backup_create pre-upgrade yes) ); then
    upgrade_restart_old
    fail "pre-upgrade backup failed; old services were restarted"
    return 1
  fi
  printf '%s\n' "$backup_output"
  backup=$(printf '%s\n' "$backup_output" | tail -n1)
  if ! backup_path_is_managed "$backup_root" "$backup" \
    || ! backup_directory_complete "$backup"; then
    upgrade_restart_old
    fail "pre-upgrade backup returned an unsafe or incomplete path; old services were restarted"
    return 1
  fi
  if ! dc exec -T redis redis-cli FLUSHALL >/dev/null; then
    upgrade_restart_old
    fail "Redis flush failed before migration; old services were restarted"
    return 1
  fi
  # Record the attempt before anything irreversible: a crash or reboot from here on leaves a
  # state that blocks upgrade and lets rollback run. Success, rollback and failure overwrite it.
  if ! write_state "$installed" "$old_images" "$old_images" "$at" "$installed" "$target" \
    failed "$backup"; then
    upgrade_restart_old
    fail "the upgrade attempt could not be recorded; old services were restarted"
    return 1
  fi
  if ! set_env_version "$target"; then
    # Nothing irreversible happened: put the recorded state back as it was.
    # STATE_LAST_* still describe that previous file; write_state does not refresh them.
    write_state "$installed" "$STATE_IMAGES" "$STATE_PREVIOUS_IMAGES" "$STATE_LAST_AT" \
      "$STATE_LAST_FROM" "$STATE_LAST_TO" "$STATE_LAST_OUTCOME" "$STATE_LAST_BACKUP" \
      "$STATE_LAST_RESTORED_FROM" || fail "the previous state could not be put back"
    upgrade_restart_old
    return 1
  fi
  # perform_rollback treats an already-failed attempt as the in-progress record and
  # does not write failed again. Refresh the globals only after set_env_version, so a
  # failure there can still restore the pre-attempt state from the old globals.
  STATE_LAST_PRESENT=yes
  STATE_LAST_OUTCOME=failed
  STATE_LAST_RESTORED_FROM=""
  UPGRADE_RESTART_OLD=no
  if ! dc run --rm -T migrate; then
    fail "migration failed; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  if ! start_upgrade_services; then
    read_unhealthy_services
    fail "a required service was not healthy within 180 seconds: ${UNHEALTHY_DESC}. Next: ${UNHEALTHY_NEXT:-./qradar-dash logs backend} and ./qradar-dash doctor; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  if ! upgrade_runtime_checks "$target"; then
    fail "$UPGRADE_CHECK_FAILURE; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  new_images=$(backup_image_digests) || {
    report_bookkeeping_failure upgrade
    return 1
  }
  write_state "$target" "$new_images" "$old_images" "$at" "$installed" "$target" \
    success "$backup" || {
    report_bookkeeping_failure upgrade
    return 1
  }
  say "Upgrade complete: $installed -> $target."
}

upgrade_auto_rollback() { # backup old-version old-images target at
  if perform_rollback "$1" "$2" "$3" "$2" "$4" "$5"; then
    fail "upgrade to $4 failed and was rolled back to $2; the broken database was kept"
  fi
}

cmd_rollback() {
  local backup old_version old_images db_size docker_root at answer
  local non_interactive=no yes=no
  need_installed
  need_docker || exit 1
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) non_interactive=yes ;;
      --yes) yes=yes ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown rollback argument: $1"; return 2 ;;
    esac
    shift
  done
  state_read .qradar-dash/state.json || {
    fail "rollback refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    return 1
  }
  old_images=$STATE_PREVIOUS_IMAGES
  [ -n "$old_images" ] || {
    fail "rollback refused: previous_images is null"
    return 1
  }
  [ "$STATE_LAST_PRESENT" = yes ] || {
    fail "rollback refused: last_upgrade is missing"
    return 1
  }
  backup=$STATE_LAST_BACKUP
  backup_directory_complete "$backup" || {
    fail "rollback refused: last_upgrade.backup is missing or incomplete: $backup"
    return 1
  }
  old_version=$STATE_LAST_FROM
  [ "$(manifest_get "$backup" VERSION)" = "$old_version" ] || {
    fail "rollback refused: backup version does not match last_upgrade.from"
    return 1
  }
  set_upgrade_services
  previous_images_are_local "$old_images" || {
    fail "rollback refused: a previous image is absent or has the wrong local digest (${PREVIOUS_IMAGE_PROBLEM:-unknown}). Next: ./qradar-dash doctor. Nothing was changed."
    return 1
  }
  rollback_unrecorded_images_are_ready "$old_images" "$old_version" || return 1
  encryption_key_compatible "$backup/env.bak" || {
    fail "rollback refused: the backup's ENCRYPTION_KEY is not the current key or in ENCRYPTION_KEYS_JSON"
    return 1
  }
  db_size=$(manifest_get "$backup" DATABASE_SIZE_BYTES)
  case "$db_size" in '' | *[!0-9]*) fail "rollback refused: invalid backup size"; return 1 ;; esac
  docker_root=$(docker_root_path) || {
    fail "rollback refused: Docker root directory is unavailable"
    return 1
  }
  backup_disk_guard "$docker_root" "$db_size" 2 || return 1
  # A strip that cannot see the target's keys, or an answers file that is unsafe to copy,
  # stops here: no prompt, no stopped container, and the file on disk is unchanged.
  prepare_answer_rollback "$backup" "$old_version" || return 1
  if [ "$non_interactive" = yes ]; then
    [ "$yes" = yes ] || { fail "--non-interactive rollback requires --yes"; return 1; }
  else
    say "Rollback replaces the live database with $backup; data written since is kept only in the broken copy."
    printf 'Type rollback to continue: '
    IFS= read -r answer || answer=""
    # A terminal echoes the operator's Enter; piped input does not, so the next line of output
    # would otherwise share the prompt's line.
    [ -t 0 ] || printf '\n'
    [ "$answer" = rollback ] || { fail "rollback confirmation was not given"; return 1; }
  fi
  at=$(state_now) || return 1
  perform_rollback "$backup" "$old_version" "$old_images" \
    "$STATE_LAST_FROM" "$STATE_LAST_TO" "$at"
}

# ---------------------------------------------------------------- doctor

DOCTOR_WORST=0
DOCTOR_HAS_DOCKER=0
DOCTOR_BACKEND_RUNNING=0
DOCTOR_ID_WIDTH=16

DOCTOR_AS_JSON=0
DOCTOR_JSON_ITEMS=""
DOCTOR_JSON_TAIL=""

doctor_json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "$s"
}

doctor_json_add_item() { # one JSON object, no surrounding array
  if [ -n "$DOCTOR_JSON_ITEMS" ]; then
    DOCTOR_JSON_ITEMS="$DOCTOR_JSON_ITEMS, $1"
  else
    DOCTOR_JSON_ITEMS=$1
  fi
}

# The container prints its own json.dumps array. Keep it whole and splice it at print time:
# splitting on "}, {" would break a message that contains that text inside a string.
doctor_take_json_array() { # body -> DOCTOR_JSON_TAIL; 1 when it is not an array of objects
  local compact inner
  compact=$(printf '%s' "$1" | tr -d '\r\n')
  compact=${compact#"${compact%%[![:space:]]*}"}
  compact=${compact%"${compact##*[![:space:]]}"}
  [[ $compact == \[*\] ]] || return 1
  inner=${compact#\[}
  inner=${inner%\]}
  inner=${inner#"${inner%%[![:space:]]*}"}
  [ -z "$inner" ] || [[ $inner == \{* ]] || return 1
  DOCTOR_JSON_TAIL=$compact
}

# One array: the host objects, then the container's array without its leading "[".
doctor_json_print() {
  local inner=""
  if [ -n "$DOCTOR_JSON_TAIL" ]; then
    inner=${DOCTOR_JSON_TAIL#\[}
    inner=${inner%\]}
    inner=${inner#"${inner%%[![:space:]]*}"}
    inner=${inner%"${inner##*[![:space:]]}"}
  fi
  if [ -z "$DOCTOR_JSON_TAIL" ] || [ -z "$inner" ]; then
    printf '[%s]\n' "$DOCTOR_JSON_ITEMS"
  elif [ -z "$DOCTOR_JSON_ITEMS" ]; then
    printf '[%s]\n' "$inner"
  else
    printf '[%s, %s]\n' "$DOCTOR_JSON_ITEMS" "$inner"
  fi
}

doctor_line() { # doctor_line STATUS ID MESSAGE [RUNBOOK]
  local status=$1 id=$2 message=$3 runbook=${4:-} severity=0
  local runbook_json escaped_id escaped_message escaped_status
  case "$status" in
    WARN) severity=1 ;;
    FAIL) severity=2 ;;
  esac
  [ "$severity" -le "$DOCTOR_WORST" ] || DOCTOR_WORST=$severity
  if [ "$DOCTOR_AS_JSON" -eq 1 ]; then
    escaped_id=$(doctor_json_escape "$id")
    escaped_message=$(doctor_json_escape "$message")
    escaped_status=$(doctor_json_escape "$status")
    runbook_json=null
    [ -z "$runbook" ] || runbook_json="\"$(doctor_json_escape "$runbook")\""
    doctor_json_add_item "$(printf '{"id": "%s", "message": "%s", "runbook": %s, "status": "%s"}' \
      "$escaped_id" "$escaped_message" "$runbook_json" "$escaped_status")"
    return
  fi
  printf '%-5s %-*s %s' "$status" "$DOCTOR_ID_WIDTH" "$id" "$message"
  [ -z "$runbook" ] || printf '    runbook: %s' "$runbook"
  printf '\n'
}

doctor_free_gib() { awk -v blocks="$1" 'BEGIN {printf "%.1f", blocks / 1048576}'; }

doctor_df() { # doctor_df PATH -> "FREE_KIB USED_PERCENT", or no output
  local row free used
  row=$(df -Pk -- "$1" 2>/dev/null | awk 'NR == 2 {print $4, $5}') || return 1
  read -r free used <<<"$row"
  used=${used%%%}
  case "$free:$used" in
    *[!0-9:]* | :* | *:) return 1 ;;
  esac
  printf '%s %s\n' "$free" "$used"
}

doctor_disk_docker() {
  local root metrics free used free_gib status
  if [ "$DOCTOR_HAS_DOCKER" -eq 0 ]; then
    doctor_line FAIL disk_docker "Docker is not installed"
    return
  fi
  root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)
  if [ -z "$root" ]; then
    doctor_line FAIL disk_docker "Docker root directory is unavailable" OPS-R14
    return
  fi
  metrics=$(doctor_df "$root" || true)
  if [ -z "$metrics" ]; then
    doctor_line FAIL disk_docker "free space is unavailable for Docker root $root" OPS-R14
    return
  fi
  read -r free used <<<"$metrics"
  free_gib=$(doctor_free_gib "$free")
  status=PASS
  if [ "$used" -ge 90 ]; then status=FAIL; elif [ "$used" -ge 70 ]; then status=WARN; fi
  doctor_line "$status" disk_docker "$used% used; $free_gib GiB free on $root" \
    "$([ "$status" = PASS ] || echo OPS-R14)"
}

doctor_database_size() { # bytes on stdout; failure means unavailable
  [ "$DOCTOR_HAS_DOCKER" -eq 1 ] || return 1
  database_size_bytes
}

doctor_disk_backup() {
  local path metrics free used free_gib status=PASS message db_size required_kib required_gib
  path=$(env_get QRADAR_DASH_BACKUP_DIR)
  if [ -z "$path" ]; then
    doctor_line FAIL disk_backup "backup directory is not configured" OPS-R14
    return
  fi
  if [ ! -e "$path" ]; then
    doctor_line WARN disk_backup "backup directory does not exist: $path" OPS-R14
    return
  fi
  if [ ! -d "$path" ]; then
    doctor_line FAIL disk_backup "backup path is not a directory: $path" OPS-R14
    return
  fi
  metrics=$(doctor_df "$path" || true)
  if [ -z "$metrics" ]; then
    doctor_line FAIL disk_backup "free space is unavailable for backup directory $path" OPS-R14
    return
  fi
  read -r free used <<<"$metrics"
  free_gib=$(doctor_free_gib "$free")
  if [ "$used" -ge 90 ]; then status=FAIL; elif [ "$used" -ge 70 ]; then status=WARN; fi
  message="$used% used; $free_gib GiB free on $path"
  if db_size=$(doctor_database_size); then
    read -r _ required_kib <<<"$(backup_guard_values "$path" "$db_size" 2)"
    required_gib=$(doctor_free_gib "$required_kib")
    if [ "$free" -lt "$required_kib" ]; then
      status=FAIL
      message="$message; backup guard needs $required_gib GiB"
    else
      message="$message; backup guard passes"
    fi
  else
    [ "$status" = FAIL ] || status=WARN
    message="$message; database size unavailable"
  fi
  doctor_line "$status" disk_backup "$message" "$([ "$status" = PASS ] || echo OPS-R14)"
}

doctor_clock() {
  local synced
  if ! command -v timedatectl >/dev/null 2>&1; then
    doctor_line WARN host_clock "timedatectl is not available; check NTP by hand" OPS-R15
    return
  fi
  synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
  if [ "$synced" = yes ]; then
    doctor_line PASS host_clock "NTP is synchronized"
  else
    doctor_line WARN host_clock "NTP is not synchronized" OPS-R15
  fi
}

doctor_selinux() {
  local mode
  if ! command -v getenforce >/dev/null 2>&1; then
    doctor_line PASS selinux "SELinux is not in use on this host"
    return
  fi
  mode=$(getenforce 2>/dev/null | head -n1 | tr -d '[:space:]' || true)
  case "$mode" in
    Enforcing)
      doctor_line PASS selinux "SELinux is Enforcing" ;;
    Permissive)
      doctor_line WARN selinux "SELinux is permissive: denials are logged, not enforced" ;;
    "" | Disabled)
      doctor_line PASS selinux "SELinux is not in use on this host" ;;
    *)
      doctor_line WARN selinux "SELinux mode is $mode; expected Enforcing, Permissive, or Disabled" ;;
  esac
}

# 26 h is 26*3600 s. A backup that is exactly that old still passes. A disabled timer is a WARN
# with the enable command; a unit file is only the signal when systemctl is not installed.
doctor_backup_age() {
  local root dir epoch newest="" newest_epoch=-1 seconds age_text message="" status=PASS
  local timer_scope timer_state
  root=$(env_get QRADAR_DASH_BACKUP_DIR)
  if [ -z "$root" ] || [ ! -d "$root" ]; then
    message="no backup exists${root:+ under $root}"
    status=WARN
  else
    # nullglob is off: an unmatched glob stays literal and is not a directory, so date is not called.
    for dir in "$root"/qradar-dash-*; do
      [ -d "$dir" ] || continue
      epoch=$(backup_stamp_epoch "$dir" 2>/dev/null) || continue
      if [ "$epoch" -gt "$newest_epoch" ]; then
        newest_epoch=$epoch
        newest=$dir
      fi
    done
    if [ -z "$newest" ]; then
      message="no backup exists under $root"
      status=WARN
    elif ! seconds=$(backup_age_seconds "$newest"); then
      message="backup age is unreadable for $newest"
      status=WARN
    else
      age_text=$(format_age "$seconds")
      if [ "$seconds" -gt $((26 * 3600)) ]; then
        message="newest backup $newest is $age_text old (older than 26 h). Next: ./qradar-dash backup manual"
        status=WARN
      else
        message="newest backup $newest is $age_text old"
      fi
    fi
  fi
  read -r timer_scope timer_state <<<"$(backup_timer_state || true)"
  case "$timer_state" in
    enabled | enabled-runtime | unit-file) ;;
    missing)
      status=WARN
      message="$message; backup timer is not installed; run ./qradar-dash backup --install-timer"
      ;;
    *)
      status=WARN
      message="$message; backup timer is $timer_state; run $(backup_timer_enable_command "$timer_scope")"
      ;;
  esac
  doctor_line "$status" backup_age "$message"
}

doctor_profile_enabled() {
  local profiles=${COMPOSE_PROFILES:-}
  [ -n "$profiles" ] || profiles=$(env_get COMPOSE_PROFILES)
  case ",${profiles// /,}," in *,$1,*) return 0 ;; *) return 1 ;; esac
}

doctor_forwarded() {
  local list frontend proxy item found=no
  # An .env with no such line is not an installed site this check can speak for.
  [ -f "$ENV_FILE" ] && [ -n "$(sed -n '/^FORWARDED_ALLOW_IPS=/p' "$ENV_FILE")" ] || return 0
  list=$(env_get FORWARDED_ALLOW_IPS)
  if [ -z "$list" ] || [ "$list" = "*" ]; then
    doctor_line FAIL forwarded_allow_ips "FORWARDED_ALLOW_IPS is ${list:-empty}; every analyst shares one rate-limit key" OPS-R21
    return
  fi
  frontend=$(env_get FRONTEND_EDGE_IP)
  if [ -z "$frontend" ]; then
    proxy=$(env_get PROXY_EDGE_IP)
    frontend=$(next_address "${proxy:-172.28.10.10}")
  fi
  for item in ${list//,/ }; do
    if [ "$item" = "$frontend" ]; then found=yes; fi
  done
  if [ "$found" = yes ]; then
    doctor_line PASS forwarded_allow_ips "FORWARDED_ALLOW_IPS trusts the frontend ($frontend)"
  else
    doctor_line WARN forwarded_allow_ips "FORWARDED_ALLOW_IPS does not trust the frontend ($frontend); pages drawn by the server share one rate-limit key" OPS-R21
  fi
}

doctor_container_runbook() {
  case "$1" in
    backend | postgres) say OPS-R36 ;;
    celery-worker) say OPS-R41 ;;
    celery-beat) say OPS-R9 ;;
  esac
}

doctor_containers() {
  local output row service state health exit_code state_l health_l total=0 runbook candidate detail
  local -a failures=()
  local -a failure_runbooks=()
  DOCTOR_BACKEND_RUNNING=0
  if [ "$DOCTOR_HAS_DOCKER" -eq 0 ]; then
    doctor_line FAIL containers "Docker is not installed"
    return
  fi
  if ! output=$(
    dc ps --all --format '{{.Service}}\t{{.State}}\t{{.Health}}\t{{.ExitCode}}' 2>/dev/null
  ); then
    doctor_line FAIL containers "docker compose ps failed"
    return
  fi
  while IFS= read -r row; do
    row=${row//$'\t'/$'\x1f'}
    IFS=$'\x1f' read -r service state health exit_code <<<"$row"
    [ -n "$service" ] || continue
    state_l=${state,,}
    health_l=${health,,}
    if [ "$service" = qradar-mcp ] && ! doctor_profile_enabled mcp; then continue; fi
    if [ "$service" = migrate ] && [ "$state_l" = exited ]; then
      if [ "$exit_code" = 0 ]; then continue; fi
      total=$((total + 1))
      failures+=("migrate is exited (exit code: ${exit_code:-unknown})")
      failure_runbooks+=(OPS-R11)
      continue
    fi
    total=$((total + 1))
    if [ "$service" = backend ] && [ "$state_l" = running ]; then
      DOCTOR_BACKEND_RUNNING=1
    fi
    if [ "$state_l" != running ] || { [ -n "$health_l" ] && [ "$health_l" != healthy ]; }; then
      detail="$service is ${state_l:-unknown}"
      [ -z "$health_l" ] || detail="$detail (health: $health_l)"
      failures+=("$detail")
      candidate=$(doctor_container_runbook "$service")
      failure_runbooks+=("$candidate")
    fi
  done <<<"$output"
  if [ "$total" -eq 0 ]; then
    doctor_line FAIL containers "no active Compose services were found"
  elif [ "${#failures[@]}" -gt 0 ]; then
    local joined=${failures[0]}
    for detail in "${failures[@]:1}"; do joined="$joined; $detail"; done
    runbook=${failure_runbooks[0]:-}
    if [ -n "$runbook" ]; then
      for candidate in "${failure_runbooks[@]}"; do
        if [ -z "$candidate" ] || [ "$candidate" != "$runbook" ]; then
          runbook=""
          break
        fi
      done
    fi
    doctor_line FAIL containers "$joined" "$runbook"
  else
    doctor_line PASS containers "$total Compose service(s) are running and healthy"
  fi
}

doctor_incontainer() {
  local rc body
  if [ "$DOCTOR_BACKEND_RUNNING" -eq 0 ]; then
    doctor_line FAIL doctor_incontainer "backend container is not running. Next: ./qradar-dash logs backend" OPS-R36
    return
  fi
  if [ "$DOCTOR_AS_JSON" -eq 1 ]; then
    set +e
    body=$(dc exec -T backend python -m app.cli.doctor --json)
    rc=$?
    set -e
    case "$rc" in
      0) ;;
      1) [ "$DOCTOR_WORST" -ge 1 ] || DOCTOR_WORST=1 ;;
      *) DOCTOR_WORST=2 ;;
    esac
    if ! doctor_take_json_array "$body"; then
      doctor_line FAIL doctor_incontainer "backend doctor --json did not print a JSON array. Next: ./qradar-dash logs backend" OPS-R36
      DOCTOR_WORST=2
    fi
    return
  fi
  set +e
  dc exec -T backend python -m app.cli.doctor
  rc=$?
  set -e
  case "$rc" in
    0) ;;
    1) [ "$DOCTOR_WORST" -ge 1 ] || DOCTOR_WORST=1 ;;
    *) DOCTOR_WORST=2 ;;
  esac
}

cmd_doctor() {
  DOCTOR_AS_JSON=0
  DOCTOR_JSON_ITEMS=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json)
        [ "$DOCTOR_AS_JSON" -eq 0 ] || {
          fail "unknown doctor argument: $1; usage: ./qradar-dash doctor [--json]"
          return 2
        }
        DOCTOR_AS_JSON=1
        ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown doctor argument: $1; usage: ./qradar-dash doctor [--json]"; return 2 ;;
    esac
    shift
  done
  need_installed
  DOCTOR_HAS_DOCKER=0
  if need_docker; then DOCTOR_HAS_DOCKER=1; fi
  doctor_disk_docker
  doctor_disk_backup
  doctor_clock
  doctor_selinux
  doctor_forwarded
  doctor_backup_age
  doctor_containers
  doctor_incontainer
  if [ "$DOCTOR_AS_JSON" -eq 1 ]; then
    doctor_json_print
  fi
  return "$DOCTOR_WORST"
}

# ---------------------------------------------------------------- support bundle

SUPPORT_STAGE=""

support_cleanup() {
  [ -z "$SUPPORT_STAGE" ] || rm -rf -- "$SUPPORT_STAGE"
}

support_error() { # support_error PART MESSAGE
  printf '%s\n' "$2" >"$SUPPORT_STAGE/input/$1.error.txt"
}

support_psql() { # support_psql PART QUERY
  local part=$1 query=$2 target="$SUPPORT_STAGE/input/$1.txt"
  if printf '%s\n' "$query" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -P pager=off >"$target" 2>/dev/null; then
    return
  fi
  rm -f -- "$target"
  support_error "$part" "$part could not be read; inspect ./qradar-dash doctor and the service logs."
}

support_version() {
  local target="$SUPPORT_STAGE/input/version.txt" piece="$SUPPORT_STAGE/version-piece"
  local api_port ui_port service digest
  : >"$target"
  if [ -f .qradar-dash/state.json ]; then
    if cat .qradar-dash/state.json >"$piece"; then
      printf '%s\n' 'state.json'
      cat "$piece"
      printf '\n'
    else
      support_error version-state \
        "version state could not be read; check .qradar-dash/state.json permissions."
    fi >>"$target"
  fi

  api_port=$(env_get API_LOOPBACK_PORT)
  : "${api_port:=8000}"
  if curl -fsS --max-time 5 "http://127.0.0.1:$api_port/api/v1/version" \
    >"$piece" 2>/dev/null; then
    printf '%s\n' 'backend /api/v1/version'
    cat "$piece"
    printf '\n'
  else
    support_error version-backend \
      "backend version endpoint could not be read; inspect doctor.txt and backend.log."
  fi >>"$target"

  ui_port=$(env_get UI_LOOPBACK_PORT)
  : "${ui_port:=3000}"
  if curl -fsS --max-time 5 "http://127.0.0.1:$ui_port/api/health" \
    >"$piece" 2>/dev/null; then
    printf '%s\n' 'frontend /api/health'
    cat "$piece"
    printf '\n'
  else
    support_error version-frontend \
      "frontend health endpoint could not be read; inspect doctor.txt and frontend.log."
  fi >>"$target"

  if dc config --services >"$SUPPORT_STAGE/services" 2>/dev/null; then
    printf '%s\n' 'compose image digests' >>"$target"
    while IFS= read -r service; do
      [ -n "$service" ] || continue
      case "$service" in
        *[!A-Za-z0-9_.-]*)
          support_error version-images \
            "Compose returned an unsafe service name; image digests are incomplete."
          continue
          ;;
      esac
      digest=$(dc images -q "$service" 2>/dev/null || true)
      if [ -n "$digest" ]; then
        printf '%s\t%s\n' "$service" "$digest" >>"$target"
      else
        support_error "version-image-$service" \
          "the $service image digest is unavailable; ensure its image has been pulled."
      fi
    done <"$SUPPORT_STAGE/services"
    printf '\n' >>"$target"
  else
    : >"$SUPPORT_STAGE/services"
    support_error version-images \
      "Compose service discovery failed; verify the Compose files and rerun the bundle."
  fi

  if printf '%s\n' 'SELECT version_num FROM alembic_version;' \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -P pager=off >"$piece" 2>/dev/null; then
    printf '%s\n' 'alembic_version'
    cat "$piece"
    printf '\n'
  else
    support_error version-alembic \
      "alembic_version could not be read; inspect doctor.txt and postgres.log."
  fi >>"$target"
  rm -f -- "$piece"
}

support_logs() {
  local service
  mkdir -p "$SUPPORT_STAGE/input/logs"
  if [ ! -s "$SUPPORT_STAGE/services" ]; then
    support_error logs \
      "Compose service discovery failed; no service logs could be collected."
    return
  fi
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    case "$service" in
      *[!A-Za-z0-9_.-]*) continue ;;
    esac
    if ! dc logs --tail=2000 --no-color "$service" \
      >"$SUPPORT_STAGE/input/logs/$service.log" 2>/dev/null; then
      rm -f -- "$SUPPORT_STAGE/input/logs/$service.log"
      printf '%s\n' \
        "$service logs could not be read; check whether the service has a container." \
        >"$SUPPORT_STAGE/input/logs/$service.error.txt"
    fi
  done <"$SUPPORT_STAGE/services"
}

support_stage_secret() { # support_stage_secret SOURCE NAME
  [ -e "$1" ] || return 0
  if [ ! -f "$1" ] || [ ! -r "$1" ]; then
    fail "secret input cannot be read: $1; fix its permissions and rerun. No archive was written."
    return 1
  fi
  if ! install -m 600 "$1" "$SUPPORT_STAGE/input/.support-input/$2"; then
    fail "secret input could not be staged: $1; fix disk access and rerun. No archive was written."
    return 1
  fi
}

cmd_support_bundle() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage; return 0 ;;
      *) fail "unknown support-bundle argument: $1; usage: ./qradar-dash support-bundle"; return 2 ;;
    esac
    shift
  done
  need_installed
  need_docker || exit 1
  command -v tar >/dev/null 2>&1 || die \
    "tar is not installed; install tar and rerun support-bundle."

  local backup_root timestamp final output
  backup_root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -n "$backup_root" ] || die \
    "backup root is not configured; set QRADAR_DASH_BACKUP_DIR and rerun support-bundle."
  umask 077
  mkdir -p -- "$backup_root" || die \
    "backup root cannot be created: $backup_root; fix its parent permissions and rerun."
  SUPPORT_STAGE=$(mktemp -d "$backup_root/.support-staging.XXXXXX") || die \
    "staging directory cannot be created under $backup_root; fix its permissions and rerun."
  trap support_cleanup EXIT
  install_signal_traps
  chmod 700 "$SUPPORT_STAGE"
  mkdir -p "$SUPPORT_STAGE/input/.support-input/secrets"

  (cmd_doctor || true) >"$SUPPORT_STAGE/input/doctor.txt" 2>&1
  support_version
  if ! dc ps --all >"$SUPPORT_STAGE/input/compose-ps.txt" 2>/dev/null; then
    rm -f -- "$SUPPORT_STAGE/input/compose-ps.txt"
    support_error compose-ps \
      "docker compose ps failed; verify Docker access and inspect doctor.txt."
  fi
  support_psql watermarks \
    'SELECT id, instance_id, collector, watermark_at, last_run_at, lag_seconds, intervals_collected, consecutive_failures, last_error, collection_metadata, created_at, updated_at FROM collection_watermark ORDER BY instance_id, collector;'
  support_psql cadence \
    'SELECT family, cadence_seconds, last_slot_start, updated_at, updated_by, last_run_at, last_run_outcome, last_run_searches, last_run_buckets, last_run_splits FROM search_cadence ORDER BY family;'
  support_logs

  if ! install -m 600 "$ENV_FILE" "$SUPPORT_STAGE/input/.support-input/config.env"; then
    fail "configuration could not be staged; fix .env permissions and rerun. No archive was written."
    return 1
  fi
  support_stage_secret .secrets/qradar.sec secrets/qradar.sec
  support_stage_secret .secrets/ghcr.token secrets/ghcr.token
  support_stage_secret .secrets/tls.key secrets/tls.key

  output="$SUPPORT_STAGE/support.tar.gz"
  if ! tar -C "$SUPPORT_STAGE/input" -cf - . \
    | dc run --rm --no-deps -T backend python -m app.cli.support_bundle >"$output"; then
    fail "support-bundle scrubber failed; ensure the backend image is available, then rerun. No archive was written."
    return 1
  fi

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  final="$backup_root/support-$timestamp.tar.gz"
  [ ! -e "$final" ] || die \
    "support archive already exists: $final; wait one second and rerun support-bundle."
  chmod 600 "$output"
  mv -- "$output" "$final"
  chmod 600 "$final"
  say "$final"
}

cmd_repair_state() {
  local code="" body="" version="" head="" db_rev="" images="" outcome="" previous=""
  local port api rc=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -h | --help) usage; return 0 ;;
      *)
        fail "unknown repair-state argument: $1; usage: ./qradar-dash repair-state. Nothing was written."
        return 2
        ;;
    esac
    shift
  done
  if [ ! -f "$ENV_FILE" ]; then
    fail "repair-state refused: not installed here: $ENV_FILE is missing. Run ./qradar-dash install. Nothing was written."
    return 1
  fi
  need_installed
  if ! need_docker; then
    fail "Nothing was written."
    return 1
  fi
  if ! state_read .qradar-dash/state.json; then
    fail "repair-state refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing. Next: ./qradar-dash status. Nothing was written."
    return 1
  fi
  if [ "$STATE_LAST_PRESENT" != yes ]; then
    fail "repair-state refused: .qradar-dash/state.json has no last_upgrade. Next: ./qradar-dash status. Nothing was written."
    return 1
  fi
  if [ -n "$STATE_LAST_RESTORED_FROM" ]; then
    fail "repair-state refused: last_upgrade.outcome is $STATE_LAST_OUTCOME and restored_from is $STATE_LAST_RESTORED_FROM. A restore already cleared that failure. Next: ./qradar-dash status. Nothing was written."
    return 1
  fi
  case "$STATE_LAST_OUTCOME" in
    # success is accepted only when the running version is that upgrade's "from": a manual
    # rollback whose "failed" write was lost leaves this record and is proved by the version.
    failed | success) ;;
    rolled_back)
      fail "repair-state refused: last_upgrade.outcome is $STATE_LAST_OUTCOME ($STATE_LAST_FROM -> $STATE_LAST_TO). The record already matches a finished upgrade or rollback. Next: ./qradar-dash status. Nothing was written."
      return 1
      ;;
    *)
      fail "repair-state refused: last_upgrade.outcome is ${STATE_LAST_OUTCOME:-unset}. Next: ./qradar-dash status. Nothing was written."
      return 1
      ;;
  esac
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  api="http://127.0.0.1:$port/api/v1"
  if code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$api/health/ready"); then
    rc=0
  else
    rc=$?
    code=${code:-none}
  fi
  if [ "$rc" -ne 0 ] || [ "$code" != 200 ]; then
    fail "repair-state refused: $api/health/ready answered HTTP ${code:-none} (curl exit $rc), not 200. Next: ./qradar-dash doctor and ./qradar-dash logs backend. Nothing was written."
    return 1
  fi
  if ! body=$(curl -fsS --max-time 5 "$api/version" 2>/dev/null); then
    fail "repair-state refused: $api/version did not answer. Next: ./qradar-dash logs backend. Nothing was written."
    return 1
  fi
  version=$(state_string_field "$body" version)
  if ! valid_release_version "$version"; then
    fail "repair-state refused: $api/version field version is '${version:-missing}', not plain SemVer. Next: ./qradar-dash logs backend. Nothing was written."
    return 1
  fi
  head=$(state_string_field "$body" migration_head)
  if [ -z "$head" ]; then
    fail "repair-state refused: $api/version field migration_head is missing. Next: ./qradar-dash logs backend. Nothing was written."
    return 1
  fi
  if ! db_rev=$(database_alembic_revision); then
    fail "repair-state refused: SELECT version_num FROM alembic_version returned nothing. Next: ./qradar-dash doctor. Nothing was written."
    return 1
  fi
  if [ "$db_rev" != "$head" ]; then
    fail "repair-state refused: database alembic revision is $db_rev, image migration_head is $head. Next: ./qradar-dash doctor (migration_head, OPS-R11). Nothing was written."
    return 1
  fi
  if [ "$version" = "$STATE_LAST_TO" ]; then
    if [ "$STATE_LAST_OUTCOME" = success ]; then
      fail "repair-state refused: last_upgrade.outcome is success ($STATE_LAST_FROM -> $STATE_LAST_TO) and the running version is already $STATE_LAST_TO. Next: ./qradar-dash status. Nothing was written."
      return 1
    fi
    outcome=success
    previous=$STATE_PREVIOUS_IMAGES
  elif [ "$version" = "$STATE_LAST_FROM" ] && [ "$STATE_LAST_FROM" != "$STATE_LAST_TO" ]; then
    outcome=rolled_back
    previous=""
  else
    fail "repair-state refused: running version $version is neither last_upgrade.from $STATE_LAST_FROM nor last_upgrade.to $STATE_LAST_TO. Next: ./qradar-dash status. Nothing was written."
    return 1
  fi
  if ! images=$(backup_image_digests); then
    fail "repair-state refused: running image digests could not be recorded. Next: ./qradar-dash doctor. Nothing was written."
    return 1
  fi
  if ! write_state "$version" "$images" "$previous" "$STATE_LAST_AT" "$STATE_LAST_FROM" \
    "$STATE_LAST_TO" "$outcome" "$STATE_LAST_BACKUP"; then
    fail "Next: fix permissions of .qradar-dash and rerun ./qradar-dash repair-state. Nothing was written."
    return 1
  fi
  say "Recorded installed_version $version, outcome $outcome, images $images."
  if [ "$outcome" = success ]; then
    say "The upgrade itself succeeded; do not roll back."
  else
    say "The rollback itself succeeded; do not roll back again."
  fi
}

main() {
  local cmd=${1:-}
  [ $# -eq 0 ] || shift
  case "$cmd" in
    install) cmd_install "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    rollback) cmd_rollback "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    doctor) cmd_doctor "$@" ;;
    support-bundle) cmd_support_bundle "$@" ;;
    repair-state) cmd_repair_state "$@" ;;
    bundle) cmd_bundle "$@" ;;
    -h | --help | help | "") usage; [ -n "$cmd" ] || exit 2 ;;
    *) fail "unknown command: $cmd"; usage >&2; exit 2 ;;
  esac
}

if [ "${QRADAR_DASH_SOURCE_ONLY:-0}" != 1 ]; then main "$@"; fi
