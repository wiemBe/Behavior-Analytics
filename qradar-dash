#!/usr/bin/env bash
# qradar-dash -- install and operate the on-premises QRadar behavioural-analytics stack.
#
#   ./qradar-dash install [--non-interactive FILE] [--build | --offline BUNDLE]
#                         [--external-proxy] [--reconfigure] [--dry-run]
#                         [--skip-qradar-check]
#   ./qradar-dash status
#   ./qradar-dash logs [docker compose logs arguments]
#   ./qradar-dash backup [manual|scheduled|pre-upgrade] [--no-verify]
#   ./qradar-dash restore <backup-directory> [--non-interactive --yes]
#   ./qradar-dash upgrade <version> [--offline]
#   ./qradar-dash rollback [--non-interactive --yes]
#
# Specified in docs/OPERATIONS-DESIGN.md section 3. The script needs bash and
# Docker with Compose v2 on the host, plus openssl and curl. It never calls
# Python on the host, never changes the SELinux mode, never passes :z or :Z, and
# never bind-mounts the checkout: secrets travel through deploy/load-secrets.sh.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT"

START_SECONDS=$SECONDS
ENV_FILE=.env
SAVED_ANSWERS=.secrets/install.answers
TMP_DIR=.install-tmp

say() { printf '%s\n' "$*"; }
info() { printf '[ ok ] %s\n' "$*"; }
warn() { printf '[warn] %s\n' "$*" >&2; }
fail() { printf '[FAIL] %s\n' "$*" >&2; }
die() { fail "$*"; exit 1; }

usage() {
  cat <<'EOF'
Usage: ./qradar-dash <command> [options]

Commands
  install       Preflight, wizard, secrets, migrate, break-glass admin, start.
  status        Show the stack and the API health.
  logs          Show service logs (arguments go to `docker compose logs`).
  doctor        Run read-only host and in-container diagnostics.
  backup        Create and verify a private database, configuration and secrets backup.
  restore       Restore a complete backup after confirmation.
  support-bundle
                Write a redacted diagnostic archive under the backup root.
  upgrade       Pull and install one explicit production SemVer release.
  rollback      Restore the pre-upgrade backup and previous image digests (asks first).
  bundle        Not built in this release (use install --build, or pull from the registry).

backup options
  --no-verify       Skip the scratch-database restore (not allowed for pre-upgrade).
  --print-timer     Print the daily systemd service and timer; write nothing.
  --install-timer   Install and enable the daily systemd timer.

restore options
  --non-interactive Refuse unless --yes is also present.
  --yes             Confirm a non-interactive restore.

upgrade options
  --offline         Refuse unless every target image is already loaded locally.

rollback options
  --non-interactive Refuse unless --yes is also present.
  --yes             Confirm a non-interactive rollback.

install options
  --non-interactive FILE   Read the answers from FILE (mode 0600, no secrets).
  --build                  Build the images from this checkout instead of pulling.
  --offline BUNDLE         Load the images from an offline bundle tar.
  --external-proxy         Skip the bundled TLS proxy; you run your own.
  --reconfigure            Ask the questions again even when answers are saved.
  --dry-run                Run every check, write nothing, change nothing.
  --skip-qradar-check      Skip the TLS handshake test against the QRadar console.
EOF
}

# ---------------------------------------------------------------- answers

# Keys an answers file may hold. None is a secret: files are named, never read here.
ANSWER_KEYS="PUBLIC_HOSTNAME TLS_CERT_FILE TLS_KEY_FILE EXTERNAL_PROXY FORWARDED_ALLOW_IPS
QRADAR_URL QRADAR_CONSOLE_FQDN QRADAR_API_VERSION QRADAR_TOKEN_FILE QRADAR_CA_FILE
QRADAR_ALLOW_MISSING_AKI INSTANCE_NAME BACKUP_DIR GHCR_USER GHCR_TOKEN_FILE ADMIN_USERNAME
HTTPS_PORT API_LOOPBACK_PORT UI_LOOPBACK_PORT IMAGE_PREFIX SECRETS_VOLUME PROXY_CERTS_VOLUME
EDGE_SUBNET PROXY_EDGE_IP PROJECT_NAME"

declare -A ANS=()
ERRORS=()

is_answer_key() {
  local k
  for k in $ANSWER_KEYS; do [ "$k" = "$1" ] && return 0; done
  return 1
}

# check_value KEY VALUE -> prints the reason and returns 1 when VALUE is refused.
# Pure: it reads files to check they are there but writes nothing.
check_value() {
  local key=$1 val=$2
  case "$key" in
    PUBLIC_HOSTNAME)
      [[ $val =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
        || { say "must be a bare host name (no scheme, port or path)"; return 1; } ;;
    TLS_CERT_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'BEGIN CERTIFICATE' "$val" || { say "not a PEM certificate: $val"; return 1; } ;;
    TLS_KEY_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'PRIVATE KEY' "$val" || { say "not a PEM private key: $val"; return 1; } ;;
    EXTERNAL_PROXY | QRADAR_ALLOW_MISSING_AKI)
      [[ $val =~ ^(yes|no)$ ]] || { say "must be yes or no"; return 1; } ;;
    FORWARDED_ALLOW_IPS)
      [ "$val" != "*" ] || { say "must list the proxy address, not *"; return 1; }
      [[ $val =~ ^[0-9A-Fa-f.:,/\ ]+$ ]] || { say "must be a comma list of addresses"; return 1; } ;;
    QRADAR_URL)
      [[ $val =~ ^https://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]{1,5})?/?$ ]] \
        || { say "must be an https:// URL with a host and no path (plain http is refused)"; return 1; } ;;
    QRADAR_CONSOLE_FQDN)
      [[ $val =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] \
        || { say "must be a bare host name"; return 1; } ;;
    QRADAR_API_VERSION)
      [[ $val =~ ^[0-9]{1,3}\.[0-9]{1,3}$ ]] || { say "must look like 20.0"; return 1; } ;;
    QRADAR_TOKEN_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      [ -s "$val" ] || { say "file is empty: $val"; return 1; } ;;
    QRADAR_CA_FILE)
      [ -r "$val" ] && [ -f "$val" ] || { say "file not readable: $val"; return 1; }
      grep -q 'BEGIN CERTIFICATE' "$val" || { say "no PEM certificate in: $val"; return 1; } ;;
    INSTANCE_NAME)
      [[ $val =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] \
        || { say "1 to 64 characters: letters, digits, . _ -"; return 1; } ;;
    BACKUP_DIR)
      [[ $val == /* ]] || { say "must be an absolute path"; return 1; }
      case "$val/" in
        "$ROOT"/*) say "must not be inside the checkout ($ROOT)"; return 1 ;;
      esac ;;
    GHCR_USER)
      [[ $val =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]] || { say "not a registry user name"; return 1; } ;;
    GHCR_TOKEN_FILE)
      [ -r "$val" ] && [ -f "$val" ] && [ -s "$val" ] \
        || { say "file not readable or empty: $val"; return 1; } ;;
    ADMIN_USERNAME)
      [[ $val =~ ^[^[:space:][:cntrl:]]{1,255}$ ]] \
        || { say "1 to 255 characters, no spaces or control characters"; return 1; } ;;
    HTTPS_PORT | API_LOOPBACK_PORT | UI_LOOPBACK_PORT)
      [[ $val =~ ^[0-9]{1,5}$ ]] && [ "$val" -ge 1 ] && [ "$val" -le 65535 ] \
        || { say "not a port number (1-65535)"; return 1; } ;;
    IMAGE_PREFIX)
      [[ $val =~ ^[a-z0-9][a-z0-9._/:-]*$ ]] || { say "not an image name prefix"; return 1; } ;;
    SECRETS_VOLUME | PROXY_CERTS_VOLUME | PROJECT_NAME)
      [[ $val =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] \
        || { say "lower-case letters, digits, _ and - only"; return 1; } ;;
    EDGE_SUBNET)
      [[ $val =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$ ]] || { say "not an IPv4 CIDR"; return 1; } ;;
    PROXY_EDGE_IP)
      [[ $val =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || { say "not an IPv4 address"; return 1; } ;;
  esac
  return 0
}

# parse_answers FILE -> fills ANS. Never sources the file.
parse_answers() {
  local file=$1 mode line key val n=0
  [ -f "$file" ] || { fail "answers file not found: $file"; exit 2; }
  mode=$(stat -c '%a' "$file")
  if [ "$mode" != "600" ] && [ "$mode" != "400" ]; then
    fail "answers file $file has mode $mode; it must be 0600 (chmod 600 $file)"
    exit 2
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    line=${line%$'\r'}
    [[ $line =~ ^[[:space:]]*(#.*)?$ ]] && continue
    if [[ ! $line =~ ^([A-Z][A-Z0-9_]*)=(.*)$ ]]; then
      ERRORS+=("$file:$n: not KEY=value")
      continue
    fi
    key=${BASH_REMATCH[1]}
    val=${BASH_REMATCH[2]}
    val=${val#"${val%%[![:space:]]*}"}
    val=${val%"${val##*[![:space:]]}"}
    if [[ $val =~ ^\"(.*)\"$ ]] || [[ $val =~ ^\'(.*)\'$ ]]; then val=${BASH_REMATCH[1]}; fi
    if ! is_answer_key "$key"; then
      if [[ $key =~ (TOKEN|PASSWORD|SECRET|ENCRYPTION|PRIVATE) ]] && [[ ! $key =~ _FILE$ ]]; then
        ERRORS+=("$file:$n: $key looks like a secret; an answers file holds paths, never secrets")
      else
        ERRORS+=("$file:$n: unknown key $key")
      fi
      continue
    fi
    ANS[$key]=$val
  done <"$file"
}

# Defaults for the keys a file may leave out. Order matters: derived values last.
apply_defaults() {
  : "${ANS[EXTERNAL_PROXY]:=no}"
  : "${ANS[QRADAR_API_VERSION]:=20.0}"
  : "${ANS[QRADAR_ALLOW_MISSING_AKI]:=no}"
  : "${ANS[INSTANCE_NAME]:=qradar}"
  : "${ANS[BACKUP_DIR]:=${HOME:-/root}/qradar-dash-backups}"
  : "${ANS[ADMIN_USERNAME]:=admin}"
  : "${ANS[HTTPS_PORT]:=443}"
  : "${ANS[API_LOOPBACK_PORT]:=8000}"
  : "${ANS[UI_LOOPBACK_PORT]:=3000}"
  : "${ANS[IMAGE_PREFIX]:=ghcr.io/wiembe/qradar-dashboard}"
  : "${ANS[SECRETS_VOLUME]:=qradar-observability-secrets}"
  : "${ANS[PROXY_CERTS_VOLUME]:=qradar-observability-proxy-certs}"
  : "${ANS[EDGE_SUBNET]:=172.28.10.0/24}"
  : "${ANS[PROXY_EDGE_IP]:=172.28.10.10}"
  : "${ANS[PROJECT_NAME]:=qradar-observability}"
  if [ -z "${ANS[QRADAR_CONSOLE_FQDN]:-}" ] && [ -n "${ANS[QRADAR_URL]:-}" ]; then
    local h=${ANS[QRADAR_URL]#https://}
    h=${h%%/*}
    ANS[QRADAR_CONSOLE_FQDN]=${h%%:*}
  fi
}

# validate_answers MODE -> appends to ERRORS; MODE is pull, build or offline.
validate_answers() {
  local mode=$1 key msg required
  required="PUBLIC_HOSTNAME QRADAR_URL QRADAR_TOKEN_FILE QRADAR_CA_FILE"
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then required="$required TLS_CERT_FILE TLS_KEY_FILE"; fi
  for key in $required; do
    if [ -z "${ANS[$key]:-}" ]; then ERRORS+=("$key: required"); fi
  done
  for key in $ANSWER_KEYS; do
    [ -n "${ANS[$key]:-}" ] || continue
    if [ "${ANS[EXTERNAL_PROXY]}" = "yes" ] && [[ $key == TLS_*_FILE ]]; then continue; fi
    if msg=$(check_value "$key" "${ANS[$key]}"); then :; else ERRORS+=("$key: $msg"); fi
  done
  if [ -n "${ANS[GHCR_TOKEN_FILE]:-}" ] && [ -z "${ANS[GHCR_USER]:-}" ]; then
    ERRORS+=("GHCR_USER: required with GHCR_TOKEN_FILE")
  fi
  if [ "$mode" = "pull" ] && [ -n "${ANS[GHCR_USER]:-}" ] && [ -z "${ANS[GHCR_TOKEN_FILE]:-}" ] \
    && [ ! -s .secrets/ghcr.token ]; then
    ERRORS+=("GHCR_TOKEN_FILE: required with GHCR_USER")
  fi
  # Ports must be distinct, or compose publishes two services on one port.
  local seen=" "
  for key in API_LOOPBACK_PORT UI_LOOPBACK_PORT; do
    if [[ $seen == *" ${ANS[$key]} "* ]]; then ERRORS+=("$key: port ${ANS[$key]} is used twice"); fi
    seen="$seen${ANS[$key]} "
  done
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ] && [[ $seen == *" ${ANS[HTTPS_PORT]} "* ]]; then
    ERRORS+=("HTTPS_PORT: port ${ANS[HTTPS_PORT]} is used twice")
  fi
}

report_errors_and_exit() {
  local e
  [ "${#ERRORS[@]}" -gt 0 ] || return 0
  fail "the answers are refused; nothing was written:"
  for e in "${ERRORS[@]}"; do printf '       %s\n' "$e" >&2; done
  exit 2
}

# ---------------------------------------------------------------- wizard

ask() { # ask KEY "question" [hint]
  local key=$1 question=$2 hint=${3:-} def=${ANS[$1]:-} reply msg
  while true; do
    if [ -n "$hint" ]; then say "    $hint"; fi
    if [ -n "$def" ]; then printf '%s [%s]: ' "$question" "$def"; else printf '%s: ' "$question"; fi
    IFS= read -r reply || die "input ended before the wizard finished"
    reply=${reply:-$def}
    if [ -z "$reply" ]; then
      case "$key" in
        GHCR_USER | GHCR_TOKEN_FILE | FORWARDED_ALLOW_IPS) ANS[$key]=""; return 0 ;;
      esac
      say "    an answer is required"
      continue
    fi
    reply=${reply/#\~/$HOME}
    if msg=$(check_value "$key" "$reply"); then ANS[$key]=$reply; return 0; fi
    say "    $msg"
  done
}

wizard() {
  local mode=$1
  say ""
  say "QRadar Dash installer. LDAP is not asked here: set it up in the UI afterwards."
  say ""
  ask PUBLIC_HOSTNAME "1. Public host name analysts will type" \
    "Becomes PUBLIC_ORIGIN=https://<name>. Production refuses any other shape."
  if [ "$FLAG_EXTERNAL_PROXY" = "yes" ]; then
    ANS[EXTERNAL_PROXY]=yes
  else
    ask EXTERNAL_PROXY "3. Use your own TLS proxy instead of the bundled one? (yes/no)" \
      "Default no: the bundled nginx terminates TLS on 443."
  fi
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    ask TLS_CERT_FILE "2. TLS certificate file (PEM) for that name"
    ask TLS_KEY_FILE "   TLS private key file (PEM)"
  else
    say "2. External proxy chosen: no certificate is needed here. Run your own TLS proxy to"
    say "   127.0.0.1:${ANS[API_LOOPBACK_PORT]:-8000} (/api/) and 127.0.0.1:${ANS[UI_LOOPBACK_PORT]:-3000}"
    say "   (everything else), and set FORWARDED_ALLOW_IPS in .env to the peer address uvicorn sees"
    say "   (README, 'Proxy headers and the rate limiter')."
  fi
  ask QRADAR_URL "4. QRadar base URL (https://...)"
  ask QRADAR_CONSOLE_FQDN "5. QRadar console FQDN (bare host name)" \
    "Used by the MCP profile only; asked now so a later enable has the value."
  ask QRADAR_API_VERSION "6. QRadar API version" \
    "Default 20.0. The lab console in the README uses 29.0. Not guessed."
  ask QRADAR_TOKEN_FILE "7. Path to the file holding the SEC token" \
    "It is copied to .secrets/qradar.sec (0600). The token is never typed or put in .env."
  ask QRADAR_CA_FILE "8. Path to the QRadar CA bundle (root + intermediate)"
  ask QRADAR_ALLOW_MISSING_AKI "9. Accept a QRadar certificate without an Authority Key Identifier? (yes/no)" \
    "Only if the TLS check fails with 'Missing Authority Key Identifier' (runbook symptom 3)."
  ask INSTANCE_NAME "10. Instance name"
  ask BACKUP_DIR "11. Backup directory (absolute, outside this checkout)"
  if [ "$mode" = "pull" ]; then
    ask GHCR_USER "12. Registry user name (empty if the images are public)"
    if [ -n "${ANS[GHCR_USER]:-}" ]; then ask GHCR_TOKEN_FILE "    Path to the read:packages token file"; fi
  fi
  ask ADMIN_USERNAME "13. Break-glass admin user name" "The password is generated and shown once."
}

# ---------------------------------------------------------------- preflight

CPU_MIN=4
MEM_MIN_KB=7864320 # 7.5 GiB: a nominal 8 GiB host reports slightly less
DISK_MIN_KB=$((80 * 1024 * 1024))
BACKUP_MIN_KB=$((20 * 1024 * 1024))
COMPOSE_MIN="2.24"

version_ge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" = "$2" ]; }

free_kb() { # free space of the nearest existing parent of $1
  local p=$1
  while [ ! -e "$p" ] && [ "$p" != "/" ]; do p=$(dirname "$p"); done
  df -Pk "$p" 2>/dev/null | awk 'NR==2 {print $4}'
}

port_free() { ! ss -ltnH "sport = :$1" 2>/dev/null | grep -q .; }

preflight_host() {
  local bad=0 arch cv mem cpus root free
  command -v docker >/dev/null 2>&1 || die "Docker is not installed (docker not on PATH). Nothing was written."
  docker version >/dev/null 2>&1 || die "Docker is installed but 'docker version' failed (daemon down or no permission). Nothing was written."
  cv=$(docker compose version --short 2>/dev/null) || die "Docker Compose v2 is required ('docker compose version' failed). The script does not call docker-compose."
  cv=${cv#v}
  version_ge "$cv" "$COMPOSE_MIN" || die "Docker Compose $cv is too old; $COMPOSE_MIN or newer is required."
  info "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null), compose $cv"
  for tool in openssl curl ss tar sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || { fail "'$tool' is required on the host"; bad=1; }
  done
  arch=$(uname -m)
  if [ "$arch" = "x86_64" ]; then info "architecture $arch"; else fail "architecture $arch; the images are x86_64 only"; bad=1; fi
  cpus=$(nproc)
  if [ "$cpus" -ge "$CPU_MIN" ]; then info "$cpus CPUs"; else fail "$cpus CPUs; at least $CPU_MIN are required"; bad=1; fi
  # QRADAR_DASH_MEMINFO_FILE exists for the tests, so they run on a host of any size.
  mem=$(awk '/^MemTotal:/ {print $2}' "${QRADAR_DASH_MEMINFO_FILE:-/proc/meminfo}")
  if [ "$mem" -ge "$MEM_MIN_KB" ]; then info "RAM $((mem / 1024 / 1024)) GiB"; else fail "RAM $((mem / 1024 / 1024)) GiB; at least 8 GiB is required"; bad=1; fi
  root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)
  free=""
  if [ -n "$root" ]; then free=$(free_kb "$root" || true); fi
  if [ -z "$free" ] || [ ! -d "$root" ]; then
    warn "cannot read the free space of the Docker root (${root:-unknown}); check 80 GiB by hand"
  elif [ "$free" -ge "$DISK_MIN_KB" ]; then
    info "$((free / 1024 / 1024)) GiB free on the Docker root ($root)"
  else
    fail "$((free / 1024 / 1024)) GiB free on the Docker root ($root); at least 80 GiB is required"; bad=1
  fi
  if command -v getenforce >/dev/null 2>&1; then
    info "SELinux: $(getenforce) (left as it is; secrets go through deploy/load-secrets.sh)"
  else
    info "SELinux: not present"
  fi
  if command -v timedatectl >/dev/null 2>&1; then
    if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null || echo no)" = "yes" ]; then
      info "clock is NTP-synchronised ($(date -u '+%Y-%m-%d %H:%M UTC'), zone $(date '+%Z'))"
    else
      warn "the clock is not NTP-synchronised; collection watermarks and sessions use UTC"
    fi
  else
    warn "timedatectl not found; check the clock by hand"
  fi
  if [ -f docker-compose.override.yml ]; then
    info "docker-compose.override.yml exists and will be used as-is (a lab overlay)"
  fi
  [ "$bad" -eq 0 ] || { fail "preflight failed; nothing was written."; exit 1; }
}

stack_running() {
  [ -f "$ENV_FILE" ] || return 1
  [ -n "$(dc ps --status running -q 2>/dev/null || true)" ]
}

preflight_network() {
  local bad=0 p backup_free url host port out
  if stack_running; then
    info "this stack is already running; its published ports are not re-checked"
  else
    local ports="${ANS[API_LOOPBACK_PORT]} ${ANS[UI_LOOPBACK_PORT]}"
    if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then ports="${ANS[HTTPS_PORT]} $ports"; fi
    for p in $ports; do
      if port_free "$p"; then info "port $p is free"; else fail "port $p is already in use"; bad=1; fi
    done
  fi
  backup_free=$(free_kb "${ANS[BACKUP_DIR]}" || true)
  if [ -z "$backup_free" ]; then
    warn "cannot read the free space of ${ANS[BACKUP_DIR]}"
  elif [ "$backup_free" -lt "$BACKUP_MIN_KB" ]; then
    fail "$((backup_free / 1024 / 1024)) GiB free for backups at ${ANS[BACKUP_DIR]}; at least 20 GiB is required"; bad=1
  else
    info "$((backup_free / 1024 / 1024)) GiB free for backups at ${ANS[BACKUP_DIR]}"
  fi
  if [ -e "${ANS[BACKUP_DIR]}" ] && [ ! -d "${ANS[BACKUP_DIR]}" ]; then
    fail "${ANS[BACKUP_DIR]} exists and is not a directory"; bad=1
  fi
  local root_dev backup_dev
  root_dev=$(stat -c %d "$(docker info --format '{{.DockerRootDir}}' 2>/dev/null)" 2>/dev/null || true)
  backup_dev=$(stat -c %d "$(dirname "${ANS[BACKUP_DIR]}")" 2>/dev/null || true)
  if [ -n "$root_dev" ] && [ "$root_dev" = "$backup_dev" ]; then
    warn "the backup directory and the Docker data root share a device; a dead disk loses both"
  fi
  if [ "$FLAG_SKIP_QRADAR" = "yes" ]; then
    warn "QRadar TLS check skipped (--skip-qradar-check)"
  elif ! command -v openssl >/dev/null 2>&1; then
    warn "openssl missing; QRadar TLS check skipped"
  else
    url=${ANS[QRADAR_URL]#https://}
    url=${url%%/*}
    host=${url%%:*}
    port=443
    if [[ $url == *:* ]]; then port=${url##*:}; fi
    # A handshake only: no token and no AQL are sent.
    out=$(timeout 15 openssl s_client -connect "$host:$port" -servername "$host" \
      -CAfile "${ANS[QRADAR_CA_FILE]}" -verify_return_error </dev/null 2>&1 || true)
    if grep -q 'Verify return code: 0' <<<"$out"; then
      info "QRadar $host:$port presents a certificate the CA bundle verifies"
    elif grep -q 'Authority Key Identifier' <<<"$out"; then
      warn "QRadar $host:$port certificate has no Authority Key Identifier; see runbook symptom 3 (QRADAR_ALLOW_MISSING_AKI)"
    elif grep -q 'verify error' <<<"$out"; then
      fail "QRadar $host:$port certificate does not verify against ${ANS[QRADAR_CA_FILE]}: $(grep -m1 'verify error' <<<"$out")"
      bad=1
    else
      warn "QRadar $host:$port is not reachable from this host; the install continues and records the check as FAIL"
    fi
  fi
  [ "$bad" -eq 0 ] || { fail "preflight failed; nothing was written."; exit 1; }
}

# ---------------------------------------------------------------- compose helpers

PROJECT=qradar-observability
dc() { docker compose -p "$PROJECT" -f docker-compose.yml -f docker-compose.prod.yml "$@"; }

env_get() { # env_get KEY -> value from .env, or empty
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | head -n1
}

load_project_from_env() {
  local p=${QRADAR_DASH_PROJECT:-}
  [ -n "$p" ] || p=$(env_get COMPOSE_PROJECT_NAME)
  [ -z "$p" ] || PROJECT=$p
}

# ---------------------------------------------------------------- install steps

write_secrets_dir() {
  umask 077
  mkdir -p .secrets
  chmod 700 .secrets
  copy_secret "${ANS[QRADAR_TOKEN_FILE]}" .secrets/qradar.sec
  copy_secret "${ANS[QRADAR_CA_FILE]}" .secrets/qradar-ca.pem
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    copy_secret "${ANS[TLS_CERT_FILE]}" .secrets/tls.crt
    copy_secret "${ANS[TLS_KEY_FILE]}" .secrets/tls.key
  fi
  if [ -n "${ANS[GHCR_TOKEN_FILE]:-}" ]; then copy_secret "${ANS[GHCR_TOKEN_FILE]}" .secrets/ghcr.token; fi
}

copy_secret() { # copy_secret SRC DST, mode 0600, skipped when they are the same file
  if [ -e "$2" ] && [ "$1" -ef "$2" ]; then chmod 600 "$2"; return 0; fi
  install -m 600 "$1" "$2"
}

save_answers() {
  local key f=$SAVED_ANSWERS.tmp
  umask 077
  {
    say "# Written by ./qradar-dash install. Paths and names only; no secret is stored here."
    for key in $ANSWER_KEYS; do
      [ -n "${ANS[$key]:-}" ] && printf '%s=%s\n' "$key" "${ANS[$key]}"
    done
  } >"$f"
  chmod 600 "$f"
  mv "$f" "$SAVED_ANSWERS"
}

write_env() { # write_env ENCRYPTION_KEY
  local enc=$1 secret_key pg_pass fwd origin profiles version
  secret_key=$(env_get SECRET_KEY)
  [ -n "$secret_key" ] || secret_key=$(openssl rand -base64 48 | tr -d '\n')
  # hex, not base64: the password is spliced into a database URL unescaped, and a
  # '/' or '+' from base64 would break it (backend/app/core/config.py database_url).
  pg_pass=$(env_get POSTGRES_PASSWORD)
  [ -n "$pg_pass" ] || pg_pass=$(openssl rand -hex 24)
  fwd=${ANS[FORWARDED_ALLOW_IPS]:-}
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    fwd=${ANS[PROXY_EDGE_IP]}
    profiles=proxy
    origin="https://${ANS[PUBLIC_HOSTNAME]}"
    if [ "${ANS[HTTPS_PORT]}" != "443" ]; then origin="$origin:${ANS[HTTPS_PORT]}"; fi
  else
    profiles=""
    origin="https://${ANS[PUBLIC_HOSTNAME]}"
    # Keep an earlier external-proxy value, never the bundled proxy address of a previous mode.
    if [ -z "$fwd" ] && [ -z "$(env_get COMPOSE_PROFILES)" ]; then fwd=$(env_get FORWARDED_ALLOW_IPS); fi
  fi
  version=""
  if [ -r VERSION ]; then version=$(tr -d '[:space:]' <VERSION); fi
  : "${version:=0.1.0}"
  umask 077
  cat >"$ENV_FILE.tmp" <<EOF
# Written by ./qradar-dash install. Mode 0600. Secret keys are kept on re-runs.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
AUTH_PROVIDER=session
PUBLIC_ORIGIN=$origin
SECRET_KEY=$secret_key
ENCRYPTION_KEY=$enc
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEYS_JSON=
POSTGRES_USER=qradar_obs
POSTGRES_PASSWORD=$pg_pass
POSTGRES_DB=qradar_obs
POSTGRES_HOST=postgres
QRADAR_PROVIDER=rest
QRADAR_BASE_URL=${ANS[QRADAR_URL]%/}
QRADAR_CONSOLE_FQDN=${ANS[QRADAR_CONSOLE_FQDN]}
QRADAR_API_VERSION=${ANS[QRADAR_API_VERSION]}
QRADAR_VERIFY_SSL=true
QRADAR_API_TOKEN_FILE=/run/secrets/qradar_sec_token
QRADAR_CA_BUNDLE=/run/secrets/qradar_ca.pem
QRADAR_TLS_ALLOW_MISSING_AKI=$([ "${ANS[QRADAR_ALLOW_MISSING_AKI]}" = yes ] && echo true || echo false)
NEXT_PUBLIC_API_BASE_URL=/api/v1
INTERNAL_API_BASE_URL=http://backend:8000/api/v1
RETENTION_ENABLED=true
RETENTION_LOG_SOURCE_METRIC_DAYS=90
RETENTION_RULE_METRIC_DAYS=90
RETENTION_OFFENSE_SNAPSHOT_DAYS=90
COMPRESSION_AFTER_DAYS=7
FORWARDED_ALLOW_IPS=$fwd
LLM_ENABLED=false
LLM_ALLOW_AUTONOMOUS_ACTIONS=false
MCP_ENABLED=false
COMPOSE_PROJECT_NAME=${ANS[PROJECT_NAME]}
# So a bare 'docker compose' in this directory uses the production overlay too (./qradar-dash passes -f itself).
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=$profiles
QRADAR_DASH_VERSION=$version
QRADAR_DASH_IMAGE_PREFIX=${ANS[IMAGE_PREFIX]}
QRADAR_DASH_BACKUP_DIR=${ANS[BACKUP_DIR]}
SECRETS_VOLUME=${ANS[SECRETS_VOLUME]}
PROXY_CERTS_VOLUME=${ANS[PROXY_CERTS_VOLUME]}
HTTPS_PORT=${ANS[HTTPS_PORT]}
API_LOOPBACK_PORT=${ANS[API_LOOPBACK_PORT]}
UI_LOOPBACK_PORT=${ANS[UI_LOOPBACK_PORT]}
EDGE_SUBNET=${ANS[EDGE_SUBNET]}
PROXY_EDGE_IP=${ANS[PROXY_EDGE_IP]}
EOF
  chmod 600 "$ENV_FILE.tmp"
  mv "$ENV_FILE.tmp" "$ENV_FILE"
}

get_images() { # get_images MODE OFFLINE_BUNDLE
  local mode=$1 bundle=${2:-} svc="postgres redis backend frontend" dir
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then svc="$svc proxy"; fi
  case "$mode" in
    build)
      say "Building the images from this checkout (the first build takes several minutes)..."
      # Stamp the build with the commit; unset (not an error) outside a git checkout. Never in .env.
      if GIT_SHA=$(git rev-parse HEAD 2>/dev/null) && [ -n "$GIT_SHA" ]; then export GIT_SHA; else unset GIT_SHA; fi
      # shellcheck disable=SC2086 # word splitting of the service list is intended
      dc build ${svc/redis /} || die "docker compose build failed"
      # redis is not built; the plain image is pulled when it is not present.
      dc pull redis || warn "could not pull redis; compose will try again at start"
      ;;
    offline)
      dir=$TMP_DIR/bundle
      rm -rf "$TMP_DIR"
      mkdir -p "$dir"
      tar -xf "$bundle" -C "$dir" SHA256SUMS images.tar || die "cannot read the bundle $bundle"
      (cd "$dir" && sha256sum -c --quiet SHA256SUMS) || die "the bundle checksums do not match; nothing was loaded"
      docker load -i "$dir/images.tar" || die "docker load failed"
      rm -rf "$TMP_DIR"
      ;;
    pull)
      if [ -s .secrets/ghcr.token ] && [ -n "${ANS[GHCR_USER]:-}" ]; then
        docker login ghcr.io --username "${ANS[GHCR_USER]}" --password-stdin <.secrets/ghcr.token \
          || die "docker login ghcr.io failed"
      fi
      # shellcheck disable=SC2086
      if ! dc pull $svc; then
        die "docker compose pull failed. A private registry needs a read:packages token: set GHCR_USER and GHCR_TOKEN_FILE (it is stored as .secrets/ghcr.token)."
      fi
      ;;
  esac
}

fernet_key() {
  docker run --rm --entrypoint python "${ANS[IMAGE_PREFIX]}/backend:$(env_get QRADAR_DASH_VERSION)" \
    -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())' \
    | tr -d '[:space:]'
}

wait_ready() { # wait_ready URL SECONDS
  local url=$1 left=$2
  while [ "$left" -gt 0 ]; do
    if curl -fsS --max-time 5 -o /dev/null "$url" 2>/dev/null; then return 0; fi
    sleep 3
    left=$((left - 3))
  done
  return 1
}

admin_exists() { # prints yes or no; no user field is printed
  local n
  n=$(printf '%s\n' "SELECT count(*) FROM app_user u JOIN user_role_link l ON l.user_id = u.id JOIN role r ON r.id = l.role_id WHERE u.username = lower(:'u') AND r.name = 'admin';" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -v "u=${ANS[ADMIN_USERNAME]}" -Atq) || die "could not query for the break-glass admin"
  if [ "$n" -gt 0 ] 2>/dev/null; then echo yes; else echo no; fi
}

cmd_install() {
  local mode=pull bundle="" answers="" dry=no reconfigure=no
  FLAG_EXTERNAL_PROXY=no
  FLAG_SKIP_QRADAR=no
  PREFLIGHT_HOST_DONE=no
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) [ $# -ge 2 ] || { fail "--non-interactive needs a file"; exit 2; }; answers=$2; shift ;;
      --build) mode=build ;;
      --offline) [ $# -ge 2 ] || { fail "--offline needs a bundle file"; exit 2; }; mode=offline; bundle=$2; shift ;;
      --external-proxy) FLAG_EXTERNAL_PROXY=yes ;;
      --reconfigure) reconfigure=yes ;;
      --dry-run) dry=yes ;;
      --skip-qradar-check) FLAG_SKIP_QRADAR=yes ;;
      -h | --help) usage; exit 0 ;;
      *) fail "unknown install option: $1"; usage >&2; exit 2 ;;
    esac
    shift
  done
  if [ "$mode" = "offline" ]; then
    [ -r "$bundle" ] || { fail "bundle not readable: $bundle"; exit 2; }
  fi

  # 1. Answers. Pure: nothing is written until every check has passed.
  if [ -n "$answers" ]; then
    parse_answers "$answers"
  elif [ -s "$SAVED_ANSWERS" ] && [ "$reconfigure" = "no" ] && [ -f "$ENV_FILE" ]; then
    say "Re-run: reusing the saved answers in $SAVED_ANSWERS (use --reconfigure to be asked again)."
    parse_answers "$SAVED_ANSWERS"
  elif [ -t 0 ]; then
    if [ -s "$SAVED_ANSWERS" ]; then parse_answers "$SAVED_ANSWERS"; fi
  else
    fail "no terminal and no --non-interactive FILE; nothing was written."
    exit 2
  fi
  [ "$FLAG_EXTERNAL_PROXY" = "no" ] || ANS[EXTERNAL_PROXY]=yes
  report_errors_and_exit # syntax errors in the file

  if [ -z "$answers" ] && [ -t 0 ] && { [ "$reconfigure" = "yes" ] || [ ! -s "$SAVED_ANSWERS" ] || [ ! -f "$ENV_FILE" ]; }; then
    preflight_host
    PREFLIGHT_HOST_DONE=yes
    apply_defaults
    wizard "$mode"
  fi
  apply_defaults
  validate_answers "$mode"
  report_errors_and_exit

  # 2. Preflight. Changes nothing.
  say "Preflight"
  if [ "$PREFLIGHT_HOST_DONE" = "no" ]; then preflight_host; fi
  PROJECT=${ANS[PROJECT_NAME]}
  preflight_network
  if [ "$dry" = "yes" ]; then say "Dry run: every check passed; nothing was written."; exit 0; fi

  # 3. First writes: secrets directory, answers, a .env with no Fernet key yet.
  # compose reads .env for env_file, so it must exist before build or pull.
  local enc
  enc=$(env_get ENCRYPTION_KEY)
  write_secrets_dir
  save_answers
  write_env "$enc"
  info ".env written (mode 0600); existing keys were kept"

  # 4. Images.
  get_images "$mode" "$bundle"

  # 5. The Fernet key, made inside the backend image. Never replaced once set.
  if [ -z "$enc" ]; then
    enc=$(fernet_key)
    [ -n "$enc" ] || die "could not generate the encryption key inside the backend image"
    write_env "$enc"
    info "ENCRYPTION_KEY generated inside the backend image"
  else
    info "ENCRYPTION_KEY kept (never rotated)"
  fi

  # 6. Secret volumes, then data services.
  export SECRETS_VOLUME=${ANS[SECRETS_VOLUME]} PROXY_CERTS_VOLUME=${ANS[PROXY_CERTS_VOLUME]}
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then
    ./deploy/load-secrets.sh all >/dev/null || die "deploy/load-secrets.sh failed"
  else
    ./deploy/load-secrets.sh qradar >/dev/null || die "deploy/load-secrets.sh failed"
  fi
  info "secrets loaded into the volumes ${ANS[SECRETS_VOLUME]}$([ "${ANS[EXTERNAL_PROXY]}" = no ] && echo " and ${ANS[PROXY_CERTS_VOLUME]}")"
  mkdir -p "${ANS[BACKUP_DIR]}" && chmod 700 "${ANS[BACKUP_DIR]}"
  dc up -d --wait --wait-timeout 180 postgres redis || { dc ps; die "postgres or redis did not become healthy"; }
  info "postgres and redis are healthy"

  # 7. Migrate. A failure stops the install: the database is new, nothing to restore.
  if ! dc run --rm -T migrate; then
    dc logs --no-color --tail 40 migrate || true
    die "alembic upgrade head failed"
  fi
  info "migrations are at head"

  # 8. Break-glass admin. seed is not run: it would insert a mock QRadar instance.
  local have_admin
  have_admin=$(admin_exists)
  if [ "$have_admin" = "yes" ]; then
    info "break-glass admin '${ANS[ADMIN_USERNAME]}' exists; create-admin is not run again"
  else
    say ""
    say "==================== BREAK-GLASS ADMIN: password shown ONCE ===================="
    dc run --rm --no-deps -T backend python -m app.cli.users create-admin \
      --username "${ANS[ADMIN_USERNAME]}" || die "create-admin failed"
    say "================================================================================"
    say ""
  fi

  # 9. Register the console inside the container, so the stored CA path is the container path.
  local qr_rc=0
  dc run --rm --no-deps -T backend python -m app.cli.qradar add \
    --name "${ANS[INSTANCE_NAME]}" --url "${ANS[QRADAR_URL]%/}" \
    --token-file /run/secrets/qradar_sec_token --ca-file /run/secrets/qradar_ca.pem \
    --api-version "${ANS[QRADAR_API_VERSION]}" || qr_rc=$?

  # 10. Start.
  if [ "${ANS[EXTERNAL_PROXY]}" = "yes" ]; then
    local f
    f=$(env_get FORWARDED_ALLOW_IPS)
    if [ -z "$f" ] || [ "$f" = "*" ]; then
      fail "external proxy: FORWARDED_ALLOW_IPS in $ENV_FILE is empty. The backend is not started."
      say "Set it to the peer address uvicorn sees from your proxy (README, 'Proxy headers and the"
      say "rate limiter'), then run ./qradar-dash install again. Any admin password printed above stays valid."
      exit 3
    fi
  fi
  local svc="backend celery-worker celery-beat frontend"
  if [ "${ANS[EXTERNAL_PROXY]}" = "no" ]; then svc="$svc proxy"; fi
  # shellcheck disable=SC2086
  dc up -d --wait --wait-timeout 180 $svc || { dc ps; fail "a service did not become healthy within 180 s"; exit 1; }
  info "backend, worker, beat, frontend$([ "${ANS[EXTERNAL_PROXY]}" = no ] && echo ", proxy") are healthy"
  local api="http://127.0.0.1:${ANS[API_LOOPBACK_PORT]}/api/v1"
  wait_ready "$api/health/ready" 60 || warn "$api/health/ready did not answer 200 within 60 s"
  local code
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "$api/version" || true)
  if [ "$code" = "200" ]; then
    info "version: $(curl -s --max-time 5 "$api/version")"
  else
    warn "GET /api/v1/version did not answer 200 (got '${code:-no answer}'); check ./qradar-dash doctor"
  fi

  summary "$qr_rc" "$have_admin"
  # The state file records the version and image digests, which do not depend on QRadar.
  write_install_state || die "the install succeeded but its state file could not be written"
  [ "$qr_rc" -eq 0 ] || exit 1
}

summary() {
  local qr_rc=$1 had=$2 origin
  origin=$(env_get PUBLIC_ORIGIN)
  say ""
  say "=============================== Install summary ==============================="
  say "URL                 $origin/"
  say "Sign-in             $origin/login"
  if [ "$had" = "yes" ]; then
    say "Admin               ${ANS[ADMIN_USERNAME]} (already existed; its password was not touched)"
  else
    say "Admin               ${ANS[ADMIN_USERNAME]} (the password was printed above and is not stored)"
    say "                    The first sign-in must change that password."
  fi
  if [ "$qr_rc" -eq 0 ]; then
    say "QRadar connection  ok (instance '${ANS[INSTANCE_NAME]}')"
  else
    say "QRadar connection  FAILED (exit $qr_rc). The instance row is stored; fix the console, token or"
    say "                    CA and run ./qradar-dash install again (qradar add updates the row)."
  fi
  say "Left off           WAF, IPS, rule-match collection, custom rules (turn them on later)"
  say "Next               Sign in, then Directory ($origin/admin/directory) if AD is used,"
  say "                    and Users ($origin/admin/users) to assign roles."
  say "Runbook            docs/OPERATIONS.md; ./qradar-dash doctor"
  say "Backup directory   ${ANS[BACKUP_DIR]}"
  say "Install time       $(((SECONDS - START_SECONDS) / 60)) min $(((SECONDS - START_SECONDS) % 60)) s"
  say "================================================================================"
}

# ---------------------------------------------------------------- status, logs

need_installed() {
  [ -f "$ENV_FILE" ] || die "not installed here: $ENV_FILE is missing. Run ./qradar-dash install."
  load_project_from_env
}

cmd_status() {
  need_installed
  command -v docker >/dev/null 2>&1 || die "Docker is not installed"
  dc ps
  local port code service digest item age="unknown"
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  code=$(curl -s --max-time 5 -o /dev/null -w '%{http_code}' "http://127.0.0.1:$port/api/v1/health/ready" || true)
  say "API ready: HTTP ${code:-none} (http://127.0.0.1:$port/api/v1/health/ready)"
  if ! state_read .qradar-dash/state.json; then
    fail "status: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    say "Installed version: unknown"
    return 1
  fi
  say "Installed version: $STATE_INSTALLED_VERSION"
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    service=${item%%:*}
    digest=${item#*:}
    say "Image $service: $digest"
  done < <(printf '%s\n' "${STATE_IMAGES//,/$'\n'}")
  if [ "$STATE_LAST_PRESENT" = yes ]; then
    if age=$(state_age "$STATE_LAST_AT" 2>/dev/null); then :; else age=unknown; fi
    say "Last upgrade: $STATE_LAST_OUTCOME, $STATE_LAST_FROM -> $STATE_LAST_TO at $STATE_LAST_AT"
    say "Last upgrade backup: $STATE_LAST_BACKUP (age $age)"
  else
    say "Last upgrade: none"
  fi
  [ "$code" = "200" ]
}

cmd_logs() {
  need_installed
  dc logs "$@"
}

# ---------------------------------------------------------------- backup and restore primitives

database_size_bytes() { # bytes on stdout; failure means unavailable
  local size
  size=$(printf '%s\n' "SELECT pg_database_size(current_database());" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -Atq 2>/dev/null) || return 1
  case "$size" in '' | *[!0-9]*) return 1 ;; esac
  printf '%s\n' "$size"
}

backup_guard_values() { # backup_guard_values PATH DATABASE_BYTES COPIES -> "FREE_KIB REQUIRED_KIB"
  local metrics free used required_kib
  metrics=$(doctor_df "$1" || true)
  [ -n "$metrics" ] || return 1
  read -r free used <<<"$metrics"
  required_kib=$((($3 * $2 + 2 * 1024 * 1024 * 1024 + 1023) / 1024))
  printf '%s %s\n' "$free" "$required_kib"
}

backup_disk_guard() { # backup_disk_guard PATH DATABASE_BYTES COPIES [DISPLAY_PATHS]
  local path=$1 display=${4:-$1} values free required free_gib required_gib
  values=$(backup_guard_values "$path" "$2" "$3") || {
    fail "free space is unavailable for backup path $display"
    return 1
  }
  read -r free required <<<"$values"
  free_gib=$(doctor_free_gib "$free")
  required_gib=$(doctor_free_gib "$required")
  say "Backup disk: $free_gib GiB free; $required_gib GiB required at $display."
  if [ "$free" -lt "$required" ]; then
    fail "backup disk guard refused: $free_gib GiB free, $required_gib GiB required at $display"
    return 1
  fi
}

docker_root_path() {
  local path
  path=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null) || return 1
  [ -n "$path" ] || return 1
  printf '%s\n' "$path"
}

backup_storage_guards() { # backup_storage_guards BACKUP_ROOT DATABASE_BYTES VERIFY
  local backup_root=$1 db_size=$2 verify=$3 docker_root backup_device docker_device copies
  docker_root=$(docker_root_path) || {
    fail "Docker root directory is unavailable; no backup was written."
    return 1
  }
  backup_device=$(stat -c %d -- "$backup_root" 2>/dev/null) || {
    fail "backup filesystem is unavailable at $backup_root"
    return 1
  }
  docker_device=$(stat -c %d -- "$docker_root" 2>/dev/null) || {
    fail "Docker filesystem is unavailable at $docker_root"
    return 1
  }
  if [ "$backup_device" = "$docker_device" ]; then
    if [ "$verify" = yes ]; then copies=3; else copies=2; fi
    say "Backup and Docker paths share one filesystem: $backup_root and $docker_root."
    backup_disk_guard "$backup_root" "$db_size" "$copies" \
      "$backup_root and $docker_root"
    return
  fi
  backup_disk_guard "$backup_root" "$db_size" 2 || return 1
  if [ "$verify" = yes ]; then copies=2; else copies=1; fi
  backup_disk_guard "$docker_root" "$db_size" "$copies"
}

validate_database_identifier() {
  [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]{0,62}$ ]] || {
    fail "unsafe database name refused"
    return 1
  }
}

guard_drop_database() { # guard_drop_database NAME
  local live
  live=$(env_get POSTGRES_DB)
  validate_database_identifier "$1" || return 1
  if [ "$1" = "$live" ]; then
    fail "refusing to drop the live POSTGRES_DB database"
    return 1
  fi
}

is_restore_database_name() {
  [[ $1 == qradar_obs_restore_test || $1 =~ ^qradar_obs_restore_[0-9]{8}t[0-9]{6}z$ ]]
}

postgres_sql() { # postgres_sql DATABASE SQL
  printf '%s\n' "$2" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$1" \
      -v ON_ERROR_STOP=1 -Atq
}

drop_database() { # drop_database NAME
  guard_drop_database "$1" || return 1
  postgres_sql postgres "DROP DATABASE IF EXISTS $1;"
}

RESTORE_CONTAINER_DUMP=""

restore_container_dump_cleanup() {
  [ -z "$RESTORE_CONTAINER_DUMP" ] \
    || dc exec -T postgres rm -f -- "$RESTORE_CONTAINER_DUMP" >/dev/null 2>&1 \
    || true
  RESTORE_CONTAINER_DUMP=""
}

restore_dump_into_database() { # restore_dump_into_database DUMP NAME
  local dump=$1 database=$2
  is_restore_database_name "$database" || {
    fail "unsafe restore database name refused"
    return 1
  }
  guard_drop_database "$database" || return 1
  RESTORE_CONTAINER_DUMP="/tmp/qradar-dash-${database}.dump"
  dc cp "$dump" "postgres:$RESTORE_CONTAINER_DUMP" || {
    restore_container_dump_cleanup
    return 1
  }
  if ! postgres_sql postgres "CREATE DATABASE $database;"; then
    restore_container_dump_cleanup
    return 1
  fi
  if ! postgres_sql "$database" \
      'CREATE EXTENSION IF NOT EXISTS timescaledb; CREATE EXTENSION IF NOT EXISTS pgcrypto;' \
    || ! postgres_sql "$database" 'SELECT timescaledb_pre_restore();' \
    || ! dc exec -T postgres pg_restore -U "$(env_get POSTGRES_USER)" \
      -d "$database" --no-owner "$RESTORE_CONTAINER_DUMP" \
    || ! postgres_sql "$database" 'SELECT timescaledb_post_restore();'; then
    restore_container_dump_cleanup
    return 1
  fi
  restore_container_dump_cleanup
}

manifest_get() { # manifest_get BACKUP_DIRECTORY KEY
  sed -n "s/^$2=//p" "$1/MANIFEST" | head -n1
}

verify_restored_database() { # verify_restored_database NAME EXPECTED_ALEMBIC [COUNTS]
  local database=$1 expected=$2 counts=${3:-no} actual
  actual=$(postgres_sql "$database" 'SELECT version_num FROM alembic_version;' \
    | tr -d '[:space:]') || return 1
  [ "$actual" = "$expected" ] || {
    fail "restored alembic_version does not match the backup manifest"
    return 1
  }
  if [ "$counts" = yes ]; then
    postgres_sql "$database" 'SELECT count(*) FROM alembic_version;' >/dev/null || return 1
    postgres_sql "$database" 'SELECT count(*) FROM role;' >/dev/null || return 1
  fi
}

BACKUP_STAGE=""
BACKUP_SCRATCH_CREATED=no
BACKUP_CONTAINER_DUMP=""

backup_cleanup() {
  if [ "$BACKUP_SCRATCH_CREATED" = yes ]; then
    drop_database qradar_obs_restore_test >/dev/null 2>&1 || true
    BACKUP_SCRATCH_CREATED=no
  fi
  if [ -n "$BACKUP_CONTAINER_DUMP" ]; then
    dc exec -T postgres rm -f -- "$BACKUP_CONTAINER_DUMP" >/dev/null 2>&1 || true
    BACKUP_CONTAINER_DUMP=""
  fi
  [ -z "$BACKUP_STAGE" ] || rm -rf -- "$BACKUP_STAGE"
  BACKUP_STAGE=""
}

backup_image_digests() {
  local containers container row service oneoff digest joined="" has_postgres=no
  containers=$(dc ps -a -q) || return 1
  while IFS= read -r container; do
    [ -n "$container" ] || continue
    case "$container" in *[!A-Za-z0-9_.-]*) return 1 ;; esac
    row=$(docker inspect --format \
      '{{printf "%s\t%s\t%s" (index .Config.Labels "com.docker.compose.service") (index .Config.Labels "com.docker.compose.oneoff") .Image}}' \
      "$container") || return 1
    IFS=$'\t' read -r service oneoff digest <<<"$row"
    [ "${oneoff,,}" = true ] && continue
    case "$service" in '' | *[!A-Za-z0-9_.-]*) return 1 ;; esac
    if [[ $digest =~ ^[0-9a-f]{64}$ ]]; then digest="sha256:$digest"; fi
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    [ "$service" != postgres ] || has_postgres=yes
    if [ -n "$joined" ]; then joined="$joined,"; fi
    joined="$joined$service:$digest"
  done <<<"$containers"
  [ "$has_postgres" = yes ] || return 1
  printf '%s\n' "$joined"
}

# ---------------------------------------------------------------- version state

STATE_INSTALLED_VERSION=""
STATE_IMAGES=""
STATE_PREVIOUS_IMAGES=""
STATE_LAST_PRESENT=no
STATE_LAST_AT=""
STATE_LAST_FROM=""
STATE_LAST_TO=""
STATE_LAST_OUTCOME=""
STATE_LAST_BACKUP=""
STATE_LAST_RESTORED_FROM=""
STATE_ERROR_FIELD="json"

valid_release_version() { [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; }

valid_state_time() {
  [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]
}

state_now() {
  local value
  value=$(date -u +%Y-%m-%dT%H:%M:%SZ) || return 1
  if [[ $value =~ ^([0-9]{4})([0-9]{2})([0-9]{2})T([0-9]{2})([0-9]{2})([0-9]{2})Z$ ]]; then
    value="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}-${BASH_REMATCH[3]}T${BASH_REMATCH[4]}:${BASH_REMATCH[5]}:${BASH_REMATCH[6]}Z"
  fi
  valid_state_time "$value" || return 1
  printf '%s\n' "$value"
}

valid_state_path() {
  [[ $1 == /* ]] || return 1
  [[ $1 != *['"'\\]* ]] || return 1
  ! printf '%s' "$1" | LC_ALL=C grep -q '[[:cntrl:]]'
}

validate_image_map() { # comma-separated service:sha256 image ids
  local map=$1 item service digest seen="|"
  [ -n "$map" ] || return 1
  while IFS= read -r item; do
    [ -n "$item" ] || return 1
    service=${item%%:*}
    digest=${item#*:}
    [[ $service =~ ^[A-Za-z0-9_.-]+$ ]] || return 1
    [[ $digest =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    [[ $seen != *"|$service|"* ]] || return 1
    seen="$seen$service|"
  done < <(printf '%s\n' "${map//,/$'\n'}")
}

image_map_to_json() {
  local map=$1 item service digest joined=""
  validate_image_map "$map" || return 1
  while IFS= read -r item; do
    service=${item%%:*}
    digest=${item#*:}
    [ -z "$joined" ] || joined="$joined,"
    joined="$joined\"$service\":\"$digest\""
  done < <(printf '%s\n' "${map//,/$'\n'}")
  printf '{%s}' "$joined"
}

json_object_to_image_map() {
  local object=${1//[[:space:]]/} item service digest joined=""
  [ -n "$object" ] || return 1
  while IFS= read -r item; do
    if [[ ! $item =~ ^\"([A-Za-z0-9_.-]+)\":\"(sha256:[0-9a-f]{64})\"$ ]]; then
      return 1
    fi
    service=${BASH_REMATCH[1]}
    digest=${BASH_REMATCH[2]}
    [ -z "$joined" ] || joined="$joined,"
    joined="$joined$service:$digest"
  done < <(printf '%s\n' "${object//,/$'\n'}")
  validate_image_map "$joined" || return 1
  printf '%s\n' "$joined"
}

state_object_field() { # compact JSON, object name -> object body
  printf '%s\n' "$1" \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p"
}

state_string_field() { # compact JSON/object, field name -> string value
  printf '%s\n' "$1" \
    | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
}

state_read() { # state_read FILE -> validated STATE_* globals
  local file=$1 compact images_object previous_object last_object
  STATE_ERROR_FIELD="file"
  [ -r "$file" ] && [ -f "$file" ] && [ ! -L "$file" ] || return 1
  STATE_ERROR_FIELD=json
  compact=$(tr -d '\n\r' <"$file") || return 1
  [[ $compact == \{*\} ]] || return 1
  STATE_INSTALLED_VERSION=$(state_string_field "$compact" installed_version)
  STATE_ERROR_FIELD=installed_version
  valid_release_version "$STATE_INSTALLED_VERSION" || return 1
  images_object=$(state_object_field "$compact" images)
  STATE_ERROR_FIELD=images
  STATE_IMAGES=$(json_object_to_image_map "$images_object") || return 1
  STATE_ERROR_FIELD=previous_images
  if [[ $compact =~ \"previous_images\"[[:space:]]*:[[:space:]]*null ]]; then
    STATE_PREVIOUS_IMAGES=""
  else
    previous_object=$(state_object_field "$compact" previous_images)
    STATE_PREVIOUS_IMAGES=$(json_object_to_image_map "$previous_object") || return 1
  fi
  STATE_LAST_PRESENT=no
  STATE_LAST_AT=""
  STATE_LAST_FROM=""
  STATE_LAST_TO=""
  STATE_LAST_OUTCOME=""
  STATE_LAST_BACKUP=""
  STATE_LAST_RESTORED_FROM=""
  if [[ $compact =~ \"last_upgrade\"[[:space:]]*:[[:space:]]*\{ ]]; then
    STATE_ERROR_FIELD=last_upgrade
    last_object=$(state_object_field "$compact" last_upgrade)
    [ -n "$last_object" ] || return 1
    STATE_LAST_AT=$(state_string_field "$last_object" at)
    STATE_LAST_FROM=$(state_string_field "$last_object" from)
    STATE_LAST_TO=$(state_string_field "$last_object" to)
    STATE_LAST_OUTCOME=$(state_string_field "$last_object" outcome)
    STATE_LAST_BACKUP=$(state_string_field "$last_object" backup)
    STATE_LAST_RESTORED_FROM=$(state_string_field "$last_object" restored_from)
    STATE_ERROR_FIELD=last_upgrade.at
    valid_state_time "$STATE_LAST_AT" || return 1
    STATE_ERROR_FIELD=last_upgrade.from
    valid_release_version "$STATE_LAST_FROM" || return 1
    STATE_ERROR_FIELD=last_upgrade.to
    valid_release_version "$STATE_LAST_TO" || return 1
    STATE_ERROR_FIELD=last_upgrade.outcome
    case "$STATE_LAST_OUTCOME" in success | rolled_back | failed) ;; *) return 1 ;; esac
    STATE_ERROR_FIELD=last_upgrade.backup
    valid_state_path "$STATE_LAST_BACKUP" || return 1
    if [ -n "$STATE_LAST_RESTORED_FROM" ]; then
      STATE_ERROR_FIELD=last_upgrade.restored_from
      valid_state_path "$STATE_LAST_RESTORED_FROM" || return 1
    fi
    STATE_LAST_PRESENT=yes
  elif [[ $compact =~ \"last_upgrade\"[[:space:]]*:[[:space:]]*null ]]; then
    :
  elif [[ $compact =~ \"last_upgrade\" ]]; then
    STATE_ERROR_FIELD=last_upgrade
    return 1
  fi
  STATE_ERROR_FIELD=""
}

write_state() { # installed images previous-or-empty [last fields and restored-from]
  local installed=$1 images=$2 previous=$3 at=${4:-} from=${5:-} to=${6:-}
  local outcome=${7:-} backup=${8:-} restored_from=${9:-}
  local images_json previous_json tmp last_json=""
  valid_release_version "$installed" || { fail "state write refused: invalid version"; return 1; }
  images_json=$(image_map_to_json "$images") \
    || { fail "state write refused: invalid image digest"; return 1; }
  if [ -n "$previous" ]; then
    previous_json=$(image_map_to_json "$previous") \
      || { fail "state write refused: invalid previous image digest"; return 1; }
  else
    previous_json=null
  fi
  if [ -n "$at$from$to$outcome$backup$restored_from" ]; then
    valid_state_time "$at" || { fail "state write refused: invalid UTC time"; return 1; }
    if ! valid_release_version "$from" || ! valid_release_version "$to"; then
      fail "state write refused: invalid upgrade version"
      return 1
    fi
    case "$outcome" in success | rolled_back | failed) ;; *)
      fail "state write refused: invalid outcome"; return 1 ;;
    esac
    valid_state_path "$backup" \
      || { fail "state write refused: invalid backup path"; return 1; }
    if [ -n "$restored_from" ]; then
      valid_state_path "$restored_from" \
        || { fail "state write refused: invalid restore path"; return 1; }
    fi
    last_json=",\"last_upgrade\":{\"at\":\"$at\",\"from\":\"$from\",\"to\":\"$to\",\"outcome\":\"$outcome\",\"backup\":\"$backup\""
    [ -z "$restored_from" ] || last_json="$last_json,\"restored_from\":\"$restored_from\""
    last_json="$last_json}"
  fi
  umask 077
  mkdir -p .qradar-dash || return 1
  chmod 700 .qradar-dash || return 1
  tmp=".qradar-dash/.state.json.$$"
  [ ! -e "$tmp" ] || { fail "state temporary file already exists"; return 1; }
  if ! printf '{\n  "installed_version":"%s",\n  "images":%s,\n  "previous_images":%s%s\n}\n' \
      "$installed" "$images_json" "$previous_json" "$last_json" >"$tmp" \
    || ! chmod 600 "$tmp" \
    || ! mv -- "$tmp" .qradar-dash/state.json; then
    rm -f -- "$tmp"
    fail "state file write failed; the previous state was kept"
    return 1
  fi
}

write_install_state() {
  local version images previous="" at="" from="" to="" outcome="" backup="" restored=""
  version=$(env_get QRADAR_DASH_VERSION)
  valid_release_version "$version" || return 1
  images=$(backup_image_digests) || return 1
  if [ -e .qradar-dash/state.json ]; then
    state_read .qradar-dash/state.json || return 1
    previous=$STATE_PREVIOUS_IMAGES
    if [ "$STATE_LAST_PRESENT" = yes ]; then
      at=$STATE_LAST_AT
      from=$STATE_LAST_FROM
      to=$STATE_LAST_TO
      outcome=$STATE_LAST_OUTCOME
      backup=$STATE_LAST_BACKUP
      restored=$STATE_LAST_RESTORED_FROM
    fi
  fi
  write_state "$version" "$images" "$previous" "$at" "$from" "$to" \
    "$outcome" "$backup" "$restored"
}

write_restore_state() { # write_restore_state BACKUP_DIRECTORY
  local backup=$1 version images previous="" at from to outcome recorded_backup
  version=$(manifest_get "$backup" VERSION)
  valid_release_version "$version" || return 1
  images=$(backup_image_digests) || return 1
  if [ -e .qradar-dash/state.json ] && state_read .qradar-dash/state.json; then
    previous=$STATE_PREVIOUS_IMAGES
  fi
  if [ "${STATE_LAST_PRESENT:-no}" = yes ]; then
    at=$STATE_LAST_AT
    from=$STATE_LAST_FROM
    to=$STATE_LAST_TO
    outcome=$STATE_LAST_OUTCOME
    recorded_backup=$STATE_LAST_BACKUP
  else
    at="" from="" to="" outcome="" recorded_backup="" backup=""
  fi
  write_state "$version" "$images" "$previous" "$at" "$from" "$to" \
    "$outcome" "$recorded_backup" "$backup"
}

state_age() {
  local timestamp now seconds
  timestamp=$(date -u -d "$1" +%s) || return 1
  now=$(date -u +%s) || return 1
  seconds=$((now - timestamp))
  [ "$seconds" -ge 0 ] || return 1
  if [ "$seconds" -lt 3600 ]; then
    printf '%s min\n' "$((seconds / 60))"
  elif [ "$seconds" -lt 86400 ]; then
    printf '%s h\n' "$((seconds / 3600))"
  else
    printf '%s d\n' "$((seconds / 86400))"
  fi
}

write_backup_manifest() { # write_backup_manifest DIR DB_SIZE ALEMBIC STATE SECRET_VOLUMES
  local version images host
  version=$(env_get QRADAR_DASH_VERSION)
  if [ -z "$version" ] && [ -r VERSION ]; then version=$(tr -d '[:space:]' <VERSION); fi
  [ -n "$version" ] || return 1
  images=$(backup_image_digests) || return 1
  host=$(hostname) || return 1
  {
    printf 'VERSION=%s\n' "$version"
    printf 'IMAGE_DIGESTS=%s\n' "$images"
    printf 'ALEMBIC_VERSION=%s\n' "$3"
    printf 'DATABASE_SIZE_BYTES=%s\n' "$2"
    printf 'HOSTNAME=%s\n' "$host"
    printf 'STATE_JSON=%s\n' "$4"
    printf 'SECRETS_VOLUMES=%s\n' "$5"
  } >"$1/MANIFEST"
}

state_last_upgrade_fields() { # state_last_upgrade_fields FILE -> OUTCOME<TAB>BACKUP
  local compact object outcome backup
  compact=$(tr -d '\n\r' <"$1") || return 1
  object=$(printf '%s\n' "$compact" \
    | sed -n 's/.*"last_upgrade"[[:space:]]*:[[:space:]]*{\([^}]*\)}.*/\1/p')
  [ -n "$object" ] || return 1
  outcome=$(printf '%s\n' "$object" \
    | sed -n 's/.*"outcome"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  backup=$(printf '%s\n' "$object" \
    | sed -n 's/.*"backup"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
  [ -n "$outcome" ] || return 1
  printf '%s\t%s\n' "$outcome" "$backup"
}

successful_upgrades_after() { # successful_upgrades_after STAMP STATE_FILE BACKUP_ROOT
  local stamp=$1 state=$2 root=$3 text at outcome path fields count=0 candidate_stamp seen="|"
  [ -r "$state" ] || return 1
  text=$(tr -d '\n\r' <"$state") || return 1
  while IFS= read -r fields; do
    at=$(printf '%s\n' "$fields" \
      | sed -n 's/.*"at"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
      | tr -d -- '-:')
    outcome=$(printf '%s\n' "$fields" \
      | sed -n 's/.*"outcome"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
    if [ "$outcome" = success ] && [[ $at > $stamp ]] && [[ $seen != *"|$at|"* ]]; then
      count=$((count + 1))
      seen="$seen$at|"
    fi
  done < <(printf '%s\n' "$text" | sed 's/}/}\n/g')
  for path in "$root"/qradar-dash-*-pre-upgrade; do
    [ -d "$path" ] || continue
    candidate_stamp=${path##*/qradar-dash-}
    candidate_stamp=${candidate_stamp%-pre-upgrade}
    [[ $candidate_stamp > $stamp ]] || continue
    [ -r "$path/state.json" ] || continue
    fields=$(state_last_upgrade_fields "$path/state.json" 2>/dev/null || true)
    outcome=${fields%%$'\t'*}
    at=$(tr -d '\n\r' <"$path/state.json" \
      | sed -n 's/.*"last_upgrade"[[:space:]]*:[[:space:]]*{[^}]*"at"[[:space:]]*:[[:space:]]*"\([^"]*\)"[^}]*}.*/\1/p' \
      | tr -d -- '-:')
    if [ "$outcome" = success ] && [ -n "$at" ] && [[ $seen != *"|$at|"* ]]; then
      count=$((count + 1))
      seen="$seen$at|"
    fi
  done
  printf '%s\n' "$count"
}

backup_path_is_managed() { # exact direct-child backup directory pattern
  local root=$1 path=$2 base
  [ -d "$path" ] && [ ! -L "$path" ] || return 1
  [ "$(dirname -- "$path")" = "$root" ] || return 1
  base=${path##*/}
  [[ $base =~ ^qradar-dash-[0-9]{8}T[0-9]{6}Z-(manual|scheduled|pre-upgrade)$ ]]
}

retention_delete() { # retention_delete ROOT PATH DB_SIZE
  backup_path_is_managed "$1" "$2" || return 1
  if ! backup_disk_guard "$1" "$3" 2 >/dev/null; then
    warn "retention kept backup because the next-backup disk guard does not pass: $2"
    return 1
  fi
  rm -rf -- "$2"
}

apply_backup_retention() { # apply_backup_retention ROOT DB_SIZE
  local root=$1 db_size=$2 path base stamp state=.qradar-dash/state.json
  local fields outcome protected count
  local -a ordinary=()
  protected=""
  if [ -r "$state" ]; then
    fields=$(state_last_upgrade_fields "$state" 2>/dev/null || true)
    outcome=${fields%%$'\t'*}
    if [ "$outcome" = failed ] || [ "$outcome" = rolled_back ]; then
      protected=${fields#*$'\t'}
    fi
  fi
  for path in "$root"/qradar-dash-*-manual "$root"/qradar-dash-*-scheduled; do
    [ -d "$path" ] || continue
    backup_path_is_managed "$root" "$path" || continue
    ordinary+=("$path")
  done
  if [ "${#ordinary[@]}" -gt 7 ]; then
    mapfile -t ordinary < <(printf '%s\n' "${ordinary[@]}" | sort)
    count=$((${#ordinary[@]} - 7))
    for path in "${ordinary[@]:0:count}"; do
      [ "$path" = "$protected" ] || retention_delete "$root" "$path" "$db_size"
    done
  fi
  [ -r "$state" ] || return 0
  for path in "$root"/qradar-dash-*-pre-upgrade; do
    [ -d "$path" ] || continue
    backup_path_is_managed "$root" "$path" || continue
    [ "$path" = "$protected" ] && continue
    base=${path##*/qradar-dash-}
    stamp=${base%-pre-upgrade}
    count=$(successful_upgrades_after "$stamp" "$state" "$root" 2>/dev/null || true)
    case "$count" in '' | *[!0-9]*) continue ;; esac
    [ "$count" -ge 2 ] && retention_delete "$root" "$path" "$db_size"
  done
  return 0
}

BACKUP_SECRETS_VOLUMES=""

write_secrets_backup() { # write_secrets_backup TARGET
  local secrets proxy
  local -a mounts entries
  secrets=$(env_get SECRETS_VOLUME)
  proxy=$(env_get PROXY_CERTS_VOLUME)
  : "${secrets:=qradar-observability-secrets}"
  : "${proxy:=qradar-observability-proxy-certs}"
  case "$secrets:$proxy" in *[!A-Za-z0-9_.:-]*) return 1 ;; esac
  docker volume inspect "$secrets" >/dev/null 2>&1 || {
    fail "required QRadar secrets volume is missing"
    return 1
  }
  mounts=(-v "$secrets:/volumes/qradar:ro")
  entries=(qradar)
  BACKUP_SECRETS_VOLUMES=qradar
  if docker volume inspect "$proxy" >/dev/null 2>&1; then
    mounts+=(-v "$proxy:/volumes/proxy:ro")
    entries+=(proxy)
    BACKUP_SECRETS_VOLUMES=qradar,proxy
  fi
  docker run --rm "${mounts[@]}" alpine tar -C /volumes -cf - "${entries[@]}" >"$1"
}

cmd_backup_create() { # cmd_backup_create REASON VERIFY
  local reason=$1 verify=$2 root stamp name final db_size alembic state_json=absent
  need_installed
  command -v docker >/dev/null 2>&1 || die "Docker is not installed"
  root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -n "$root" ] || die "backup root is not configured; set QRADAR_DASH_BACKUP_DIR."
  [ -d "$root" ] || die "backup root is not a directory: $root"
  db_size=$(database_size_bytes) || die "database size is unavailable; no backup was written."
  backup_storage_guards "$root" "$db_size" "$verify" || return 1
  alembic=$(postgres_sql "$(env_get POSTGRES_DB)" \
    'SELECT version_num FROM alembic_version;' | tr -d '[:space:]') \
    || die "alembic_version is unavailable; no backup was written."
  [ -n "$alembic" ] || die "alembic_version is empty; no backup was written."

  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  name="qradar-dash-$stamp-$reason"
  final="$root/$name"
  BACKUP_STAGE="$root/.$name.partial"
  [ ! -e "$final" ] && [ ! -e "$BACKUP_STAGE" ] \
    || die "backup path already exists: $final"
  umask 077
  mkdir -m 700 -- "$BACKUP_STAGE"
  trap backup_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  BACKUP_CONTAINER_DUMP="/tmp/qradar-dash-$stamp.dump"
  dc exec -T postgres pg_dump -U "$(env_get POSTGRES_USER)" -Fc \
    -d "$(env_get POSTGRES_DB)" -f "$BACKUP_CONTAINER_DUMP" \
    || die "database dump failed; the partial backup was removed."
  dc cp "postgres:$BACKUP_CONTAINER_DUMP" "$BACKUP_STAGE/database.dump" \
    || die "database dump copy-out failed; the partial backup was removed."
  dc exec -T postgres rm -f -- "$BACKUP_CONTAINER_DUMP" \
    || die "database dump cleanup failed; the partial backup was removed."
  BACKUP_CONTAINER_DUMP=""
  install -m 600 "$ENV_FILE" "$BACKUP_STAGE/env.bak" \
    || die "environment backup failed; the partial backup was removed."
  write_secrets_backup "$BACKUP_STAGE/secrets.tar" \
    || die "secrets backup failed; the partial backup was removed."
  if [ -f .qradar-dash/state.json ]; then
    install -m 600 .qradar-dash/state.json "$BACKUP_STAGE/state.json" \
      || die "state backup failed; the partial backup was removed."
    state_json=included
  fi
  write_backup_manifest \
    "$BACKUP_STAGE" "$db_size" "$alembic" "$state_json" "$BACKUP_SECRETS_VOLUMES" \
    || die "backup manifest failed; the partial backup was removed."
  chmod 600 "$BACKUP_STAGE"/*

  if [ "$verify" = yes ]; then
    drop_database qradar_obs_restore_test >/dev/null \
      || die "could not clear the backup verification database."
    # From this point cleanup may safely issue DROP IF EXISTS even when copy-in
    # or CREATE DATABASE itself is the failing step.
    BACKUP_SCRATCH_CREATED=yes
    restore_dump_into_database "$BACKUP_STAGE/database.dump" qradar_obs_restore_test \
      || die "backup verification restore failed; the partial backup was removed."
    verify_restored_database qradar_obs_restore_test "$alembic" yes \
      || die "backup verification failed; the partial backup was removed."
    drop_database qradar_obs_restore_test \
      || die "backup verification database cleanup failed; the partial backup was removed."
    BACKUP_SCRATCH_CREATED=no
  fi
  mv -- "$BACKUP_STAGE" "$final"
  BACKUP_STAGE=""
  trap - EXIT HUP INT TERM
  apply_backup_retention "$root" "$db_size"
  say "$final"
}

print_backup_timer() {
  cat <<EOF
# qradar-dash-backup.service
[Unit]
Description=Create a verified QRadar Dash backup

[Service]
Type=oneshot
WorkingDirectory=$ROOT
ExecStart=$ROOT/qradar-dash backup scheduled

# qradar-dash-backup.timer
[Unit]
Description=Create a daily QRadar Dash backup

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=15min
Unit=qradar-dash-backup.service

[Install]
WantedBy=timers.target
EOF
}

install_backup_timer() {
  local unit_dir systemctl_args=()
  if [ "$(id -u)" -eq 0 ]; then
    unit_dir=/etc/systemd/system
  else
    unit_dir=${HOME:?HOME is not set}/.config/systemd/user
    systemctl_args=(--user)
  fi
  mkdir -p -- "$unit_dir"
  print_backup_timer | sed -n '/^# qradar-dash-backup.service$/,/^# qradar-dash-backup.timer$/p' \
    | sed '$d' >"$unit_dir/qradar-dash-backup.service"
  print_backup_timer | sed -n '/^# qradar-dash-backup.timer$/,$p' \
    >"$unit_dir/qradar-dash-backup.timer"
  chmod 644 "$unit_dir/qradar-dash-backup.service" "$unit_dir/qradar-dash-backup.timer"
  systemctl "${systemctl_args[@]}" daemon-reload
  systemctl "${systemctl_args[@]}" enable --now qradar-dash-backup.timer
  say "Installed and enabled backup timer under $unit_dir."
  if [ "${#systemctl_args[@]}" -gt 0 ]; then
    say "A user timer runs only while that user has a session unless lingering is enabled."
    say "Enable lingering if required: loginctl enable-linger $(id -un)"
  fi
}

cmd_backup() {
  local reason=manual verify=yes action=create
  while [ $# -gt 0 ]; do
    case "$1" in
      manual | scheduled | pre-upgrade) reason=$1 ;;
      --no-verify) verify=no ;;
      --print-timer) action=print ;;
      --install-timer) action=install ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown backup option: $1"; return 2 ;;
    esac
    shift
  done
  if [ "$action" != create ]; then
    [ "$reason" = manual ] && [ "$verify" = yes ] \
      || { fail "timer options cannot be combined with a backup reason or --no-verify"; return 2; }
    if [ "$action" = print ]; then print_backup_timer; else install_backup_timer; fi
    return
  fi
  if [ "$reason" = pre-upgrade ] && [ "$verify" = no ]; then
    fail "pre-upgrade backups must be verified"
    return 2
  fi
  cmd_backup_create "$reason" "$verify"
}

backup_directory_complete() { # backup_directory_complete DIRECTORY
  local path=$1 file mode state_json secrets_volumes
  [ -d "$path" ] && [ ! -L "$path" ] || return 1
  mode=$(stat -c '%a' "$path" 2>/dev/null) || return 1
  [ "$mode" = 700 ] || return 1
  for file in database.dump env.bak secrets.tar MANIFEST; do
    [ -f "$path/$file" ] && [ ! -L "$path/$file" ] && [ -s "$path/$file" ] || return 1
    mode=$(stat -c '%a' "$path/$file" 2>/dev/null) || return 1
    [ "$mode" = 600 ] || return 1
  done
  state_json=$(manifest_get "$path" STATE_JSON)
  case "$state_json" in included | absent) ;; *) return 1 ;; esac
  if [ "$state_json" = included ] && [ ! -f "$path/state.json" ]; then return 1; fi
  if [ -e "$path/state.json" ] || [ -L "$path/state.json" ]; then
    [ -f "$path/state.json" ] && [ ! -L "$path/state.json" ] \
      && [ -s "$path/state.json" ] || return 1
    mode=$(stat -c '%a' "$path/state.json" 2>/dev/null) || return 1
    [ "$mode" = 600 ] || return 1
  fi
  secrets_volumes=$(manifest_get "$path" SECRETS_VOLUMES)
  case "$secrets_volumes" in qradar | qradar,proxy) ;; *) return 1 ;; esac
}

version_is_newer() { # version_is_newer CANDIDATE CURRENT
  [ "$1" = "$2" ] && return 1
  [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

encryption_key_compatible() { # encryption_key_compatible BACKUP_ENV
  local backup_key current keys item
  backup_key=$(sed -n 's/^ENCRYPTION_KEY=//p' "$1" | head -n1)
  current=$(env_get ENCRYPTION_KEY)
  [ -n "$backup_key" ] || return 1
  [ "$backup_key" = "$current" ] && return 0
  keys=$(env_get ENCRYPTION_KEYS_JSON)
  keys=${keys#\{}
  keys=${keys%\}}
  keys=${keys//[[:space:]]/}
  keys=${keys//,/$'\n'}
  while IFS= read -r item; do
    [[ $item == *:* ]] || continue
    item=${item#*:}
    item=${item#\"}
    item=${item%\"}
    [ "$item" = "$backup_key" ] && return 0
  done <<<"$keys"
  return 1
}

RESTORE_STOPPED_SERVICES=()

restore_stop_services() {
  local service running_text
  local -a running=()
  running_text=$(dc ps --services --status running) || return 1
  mapfile -t running <<<"$running_text"
  for service in backend celery-worker celery-beat frontend proxy; do
    if printf '%s\n' "${running[@]}" | grep -qx "$service"; then
      RESTORE_STOPPED_SERVICES+=("$service")
    fi
  done
  [ "${#RESTORE_STOPPED_SERVICES[@]}" -gt 0 ] || return 0
  dc stop "${RESTORE_STOPPED_SERVICES[@]}"
}

restore_start_services() {
  [ "${#RESTORE_STOPPED_SERVICES[@]}" -eq 0 ] || dc start "${RESTORE_STOPPED_SERVICES[@]}"
}

restore_failure_before_swap() { # restore_failure_before_swap DATABASE
  drop_database "$1" >/dev/null 2>&1 || true
  restore_start_services || true
}

print_broken_database_instructions() { # print_broken_database_instructions NAME
  say "Previous database kept as $1."
  say "Drop it later only after validation:"
  say "  docker compose -p $PROJECT -f docker-compose.yml -f docker-compose.prod.yml exec -T postgres psql -U $(env_get POSTGRES_USER) -d postgres -c 'DROP DATABASE $1;'"
}

restore_swap_database() { # restore_swap_database BACKUP_DIRECTORY REASON
  local backup=$1 reason=$2 stamp db_stamp restored broken live expected
  stamp=$(date -u +%Y%m%dT%H%M%SZ)
  db_stamp=${stamp,,}
  restored="qradar_obs_restore_$db_stamp"
  broken="qradar_obs_broken_$db_stamp"
  live=$(env_get POSTGRES_DB)
  validate_database_identifier "$live" || return 1
  expected=$(manifest_get "$backup" ALEMBIC_VERSION)
  RESTORE_STOPPED_SERVICES=()
  if ! restore_stop_services; then
    restore_start_services || true
    return 1
  fi
  if ! restore_dump_into_database "$backup/database.dump" "$restored"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! verify_restored_database "$restored" "$expected"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres \
    "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$live' AND pid <> pg_backend_pid();" \
      >/dev/null; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres "ALTER DATABASE $live RENAME TO $broken;"; then
    restore_failure_before_swap "$restored"
    return 1
  fi
  if ! postgres_sql postgres "ALTER DATABASE $restored RENAME TO $live;"; then
    if ! postgres_sql postgres "ALTER DATABASE $broken RENAME TO $live;"; then
      fail "restore swap failed and the original database could not be renamed back"
      say "Original database: $broken"
      say "Restored candidate database: $restored"
      say "Rename the original back with:"
      say "  docker compose -p $PROJECT -f docker-compose.yml -f docker-compose.prod.yml exec -T postgres psql -U $(env_get POSTGRES_USER) -d postgres -c 'ALTER DATABASE $broken RENAME TO $live;'"
    fi
    restore_start_services || true
    return 1
  fi
  print_broken_database_instructions "$broken"
  say "Database swap complete ($reason); services remain stopped."
}

restore_start_and_wait() { # restore_start_and_wait BACKUP_DIRECTORY REASON
  local backup=$1 reason=$2 port
  if ! restore_start_services; then
    fail "the database was restored but the stopped services did not all restart"
    return 1
  fi
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  if ! wait_ready "http://127.0.0.1:$port/api/v1/health/ready" 180; then
    fail "the database was restored but readiness did not answer within 180 seconds"
    return 1
  fi
  say "Restore complete ($reason)."
  say "Secrets were not restored. Inspect the archive with:"
  printf '  tar -tf %q\n' "$backup/secrets.tar"
}

cmd_restore() {
  local backup="" non_interactive=no yes=no version current db_size answer
  need_installed
  command -v docker >/dev/null 2>&1 || die "Docker is not installed"
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) non_interactive=yes ;;
      --yes) yes=yes ;;
      -h | --help) usage; return 0 ;;
      -*) fail "unknown restore option: $1"; return 2 ;;
      *) [ -z "$backup" ] || { fail "restore accepts one backup path"; return 2; }; backup=$1 ;;
    esac
    shift
  done
  [ -n "$backup" ] || { fail "restore needs a backup directory"; return 2; }
  backup=$(readlink -f -- "$backup") || {
    fail "restore refused: the backup path cannot be resolved"
    return 1
  }
  backup_directory_complete "$backup" || {
    fail "restore refused: the backup directory is incomplete or has unsafe modes"
    return 1
  }
  version=$(manifest_get "$backup" VERSION)
  current=$(env_get QRADAR_DASH_VERSION)
  [ -n "$version" ] && [ -n "$current" ] || {
    fail "restore refused: backup or current image version is unavailable"
    return 1
  }
  if [ "$version" != "$current" ]; then
    if version_is_newer "$version" "$current"; then
      fail "restore refused: backup version is newer; upgrade to that version first"
    else
      fail "restore refused: backup version is older; use rollback, or put that version's images back and then restore"
    fi
    return 1
  fi
  if ! encryption_key_compatible "$backup/env.bak"; then
    fail "restore refused: the backup encryption key is not in the current keyring."
    fail "Put the backup's key back as described in OPERATIONS-DESIGN section 5.1, without replacing or printing keys."
    return 1
  fi
  db_size=$(manifest_get "$backup" DATABASE_SIZE_BYTES)
  case "$db_size" in '' | *[!0-9]*) fail "restore refused: invalid database size in MANIFEST"; return 1 ;; esac
  local docker_root
  docker_root=$(docker_root_path) || {
    fail "restore refused: Docker root directory is unavailable"
    return 1
  }
  backup_disk_guard "$docker_root" "$db_size" 2 || return 1
  if [ "$non_interactive" = yes ]; then
    [ "$yes" = yes ] || { fail "--non-interactive restore requires --yes"; return 1; }
  else
    printf 'Type restore to replace the application database: '
    IFS= read -r answer || answer=""
    [ "$answer" = restore ] || { fail "restore confirmation was not given"; return 1; }
  fi
  restore_swap_database "$backup" manual || return 1
  restore_start_and_wait "$backup" manual || return 1
  write_restore_state "$backup" || {
    fail "restore completed but the state file could not be updated"
    return 1
  }
}

# ---------------------------------------------------------------- upgrade and rollback

UPGRADE_SERVICES=()
UPGRADE_CHECK_FAILURE=""

set_upgrade_services() {
  UPGRADE_SERVICES=(backend celery-worker celery-beat frontend)
  if doctor_profile_enabled proxy; then UPGRADE_SERVICES+=(proxy); fi
}

set_env_version() { # set_env_version VERSION
  local version=$1 tmp="$ENV_FILE.version.$$" count
  valid_release_version "$version" || return 1
  count=$(grep -c '^QRADAR_DASH_VERSION=' "$ENV_FILE" 2>/dev/null || true)
  [ "$count" -eq 1 ] || {
    fail "$ENV_FILE must contain exactly one QRADAR_DASH_VERSION line"
    return 1
  }
  umask 077
  if ! sed "s/^QRADAR_DASH_VERSION=.*/QRADAR_DASH_VERSION=$version/" \
      "$ENV_FILE" >"$tmp" \
    || ! chmod 600 "$tmp" \
    || ! mv -- "$tmp" "$ENV_FILE"; then
    rm -f -- "$tmp"
    fail "$ENV_FILE version update failed; the previous file was kept"
    return 1
  fi
}

release_notes_fields() { # release_notes_fields TEXT -> version<TAB>min_from
  local text=$1 front version min_from count
  [ "$(printf '%s\n' "$text" | sed -n '1p')" = "---" ] || return 1
  front=$(printf '%s\n' "$text" \
    | awk 'NR == 1 {next} /^---[[:space:]]*$/ {found=1; exit} {print}
        END {if (!found) exit 1}') || return 1
  count=$(printf '%s\n' "$front" | grep -c '^version:[[:space:]]*' || true)
  [ "$count" -eq 1 ] || return 1
  count=$(printf '%s\n' "$front" | grep -c '^min_from:[[:space:]]*' || true)
  [ "$count" -eq 1 ] || return 1
  version=$(printf '%s\n' "$front" \
    | sed -n 's/^version:[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')
  min_from=$(printf '%s\n' "$front" \
    | sed -n 's/^min_from:[[:space:]]*\([^[:space:]]*\)[[:space:]]*$/\1/p')
  valid_release_version "$version" && valid_release_version "$min_from" || return 1
  printf '%s\t%s\n' "$version" "$min_from"
}

upgrade_pull_target() { # upgrade_pull_target VERSION OFFLINE
  local target=$1 offline=$2 prefix service ref
  local -a services=(postgres redis backend frontend)
  doctor_profile_enabled proxy && services+=(proxy)
  doctor_profile_enabled mcp && services+=(qradar-mcp)
  if [ "$offline" = no ]; then
    QRADAR_DASH_VERSION=$target dc pull "${services[@]}"
    return
  fi
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=ghcr.io/wiembe/qradar-dashboard}"
  for service in postgres backend frontend; do
    docker image inspect "$prefix/$service:$target" >/dev/null || return 1
  done
  if doctor_profile_enabled proxy; then
    docker image inspect "$prefix/proxy:$target" >/dev/null || return 1
  fi
  if doctor_profile_enabled mcp; then
    docker image inspect "$prefix/qradar-mcp:$target" >/dev/null || return 1
  fi
  ref='redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499'
  docker image inspect "$ref" >/dev/null
}

read_target_release_notes() { # read_target_release_notes VERSION
  local target=$1 prefix notes fields version min_from
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=ghcr.io/wiembe/qradar-dashboard}"
  notes=$(docker run --rm --entrypoint cat "$prefix/backend:$target" \
    "/app/releases/$target.md") || return 1
  fields=$(release_notes_fields "$notes") || return 1
  IFS=$'\t' read -r version min_from <<<"$fields"
  [ "$version" = "$target" ] || return 1
  printf '%s\n' "$min_from"
}

# Only db_connect and migration_head decide an upgrade or rollback; the rest of the report
# (a beat heartbeat not written yet, QRadar checks) would read as a failed upgrade.
print_deciding_checks() { # print_deciding_checks REPORT
  printf '%s\n' "$1" | grep -E '^[A-Z]+[[:space:]]+(db_connect|migration_head)([[:space:]]|$)' || true
  say "Full report: ./qradar-dash doctor"
}

upgrade_doctor_preflight() {
  local report
  report=$(cmd_doctor || true)
  print_deciding_checks "$report"
  if printf '%s\n' "$report" \
      | grep -Eq '^FAIL[[:space:]]+(db_connect|migration_head)([[:space:]]|$)'; then
    fail "upgrade refused: database readiness is already failing; see runbook OPS-R11"
    return 1
  fi
  # Fail closed: a doctor that could not report either check proves nothing.
  if ! printf '%s\n' "$report" | grep -Eq '^PASS[[:space:]]+db_connect([[:space:]]|$)' \
    || ! printf '%s\n' "$report" | grep -Eq '^PASS[[:space:]]+migration_head([[:space:]]|$)'; then
    fail "upgrade refused: doctor did not report db_connect and migration_head as PASS; see runbook OPS-R11"
    return 1
  fi
}

upgrade_runtime_checks() { # upgrade_runtime_checks EXPECTED_VERSION
  local expected=$1 port api ready="" reported reported_version report left=180
  UPGRADE_CHECK_FAILURE=""
  port=$(env_get API_LOOPBACK_PORT)
  : "${port:=8000}"
  api="http://127.0.0.1:$port/api/v1"
  while [ "$left" -gt 0 ]; do
    ready=$(curl -fsS --max-time 5 "$api/health/ready" 2>/dev/null || true)
    if grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$ready"; then break; fi
    sleep 3
    left=$((left - 3))
  done
  if ! grep -Eq '"database"[[:space:]]*:[[:space:]]*"ok"' <<<"$ready"; then
    UPGRADE_CHECK_FAILURE="readiness did not report database ok within 180 seconds"
    return 1
  fi
  reported=$(curl -fsS --max-time 5 "$api/version" 2>/dev/null) || {
    UPGRADE_CHECK_FAILURE="version endpoint did not answer 200"
    return 1
  }
  reported_version=$(state_string_field "$reported" version)
  if [ "$reported_version" != "$expected" ]; then
    UPGRADE_CHECK_FAILURE="version endpoint did not report $expected"
    return 1
  fi
  report=$(cmd_doctor || true)
  print_deciding_checks "$report"
  if ! printf '%s\n' "$report" \
      | grep -Eq '^PASS[[:space:]]+db_connect([[:space:]]|$)'; then
    UPGRADE_CHECK_FAILURE="doctor db_connect is not PASS"
    return 1
  fi
  if ! printf '%s\n' "$report" \
      | grep -Eq '^PASS[[:space:]]+migration_head([[:space:]]|$)'; then
    UPGRADE_CHECK_FAILURE="doctor migration_head is not PASS"
    return 1
  fi
}

image_map_digest() { # image_map_digest MAP SERVICE
  local item service
  while IFS= read -r item; do
    service=${item%%:*}
    [ "$service" = "$2" ] && { printf '%s\n' "${item#*:}"; return 0; }
  done < <(printf '%s\n' "${1//,/$'\n'}")
  return 1
}

previous_images_are_local() { # previous_images_are_local MAP
  local item digest actual
  validate_image_map "$1" || return 1
  while IFS= read -r item; do
    digest=${item#*:}
    actual=$(docker image inspect --format '{{.Id}}' "$digest" 2>/dev/null) || return 1
    [ "$actual" = "$digest" ] || return 1
  done < <(printf '%s\n' "${1//,/$'\n'}")
}

tag_previous_images() { # tag_previous_images MAP VERSION
  local map=$1 version=$2 prefix service digest
  prefix=$(env_get QRADAR_DASH_IMAGE_PREFIX)
  : "${prefix:=ghcr.io/wiembe/qradar-dashboard}"
  for service in postgres backend frontend proxy qradar-mcp; do
    digest=$(image_map_digest "$map" "$service" 2>/dev/null || true)
    [ -n "$digest" ] || continue
    docker tag "$digest" "$prefix/$service:$version" || return 1
  done
}

UPGRADE_RESTART_OLD=no

upgrade_restart_old() { # start the stopped services again, on the old images
  [ "$UPGRADE_RESTART_OLD" = yes ] || return 0
  UPGRADE_RESTART_OLD=no
  restore_start_services || fail "the stopped services did not all restart; run: ./qradar-dash doctor"
}

start_upgrade_services() {
  dc up -d --wait --wait-timeout 180 "${UPGRADE_SERVICES[@]}"
}

record_rollback_failure() { # backup old-version old-images from to at
  local backup=$1 old_version=$2 old_images=$3 from=$4 to=$5 at=$6
  restore_stop_services >/dev/null 2>&1 || true
  say "Rollback failed; the writers and the UI are stopped. Verified backup: $backup"
  say "Nothing further was attempted. Run ./qradar-dash rollback again once the cause is fixed,"
  say "or ./qradar-dash restore $backup"
  write_state "$old_version" "$old_images" "$old_images" "$at" "$from" "$to" \
    failed "$backup" || true
  return 1
}

perform_rollback() { # backup old-version old-images from to at
  local backup=$1 old_version=$2 old_images=$3 from=$4 to=$5 at=$6 images
  if ! restore_swap_database "$backup" rollback; then
    record_rollback_failure "$backup" "$old_version" "$old_images" "$from" "$to" "$at"
    return 1
  fi
  if ! set_env_version "$old_version" \
    || ! tag_previous_images "$old_images" "$old_version" \
    || ! start_upgrade_services \
    || ! upgrade_runtime_checks "$old_version"; then
    [ -z "$UPGRADE_CHECK_FAILURE" ] || fail "$UPGRADE_CHECK_FAILURE"
    record_rollback_failure "$backup" "$old_version" "$old_images" "$from" "$to" "$at"
    return 1
  fi
  images=$(backup_image_digests) || images=$old_images
  write_state "$old_version" "$images" "" "$at" "$from" "$to" rolled_back "$backup" \
    || return 1
  say "Rollback complete."
}

cmd_upgrade() {
  local target="" offline=no installed min_from db_size backup_root old_images
  local backup_output backup at new_images old_env_version
  need_installed
  command -v docker >/dev/null 2>&1 || die "Docker is not installed"
  while [ $# -gt 0 ]; do
    case "$1" in
      --offline) offline=yes ;;
      -h | --help) usage; return 0 ;;
      -*) fail "unknown upgrade option: $1"; return 2 ;;
      *) [ -z "$target" ] || { fail "upgrade accepts one version"; return 2; }; target=$1 ;;
    esac
    shift
  done
  [ -n "$target" ] || { fail "upgrade needs a version"; return 2; }
  valid_release_version "$target" || {
    fail "upgrade version must be plain SemVer (MAJOR.MINOR.PATCH)"
    return 1
  }
  state_read .qradar-dash/state.json || {
    fail "upgrade refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    return 1
  }
  installed=$STATE_INSTALLED_VERSION
  set_upgrade_services
  if [ "$installed" = "$target" ]; then
    if upgrade_runtime_checks "$target"; then
      say "Version $target is already installed and healthy; nothing changed."
      return 0
    fi
    fail "version $target is recorded but the running stack is not healthy: $UPGRADE_CHECK_FAILURE"
    return 1
  fi
  if version_is_newer "$installed" "$target"; then
    fail "upgrade refused: $installed is newer than $target; that is rollback"
    return 1
  fi
  if [ "$STATE_LAST_PRESENT" = yes ] && [ "$STATE_LAST_OUTCOME" = failed ] \
    && [ -z "$STATE_LAST_RESTORED_FROM" ]; then
    fail "upgrade refused: the last upgrade failed; run rollback or restore first"
    return 1
  fi
  upgrade_pull_target "$target" "$offline" || {
    fail "upgrade refused: target images are unavailable; no container was stopped"
    return 1
  }
  min_from=$(read_target_release_notes "$target") || {
    fail "upgrade refused: target release notes are missing, invalid, or for another version"
    return 1
  }
  version_ge "$installed" "$min_from" || {
    fail "upgrade refused: $target requires at least $min_from"
    return 1
  }
  backup_root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -d "$backup_root" ] || { fail "upgrade refused: backup root is unavailable"; return 1; }
  db_size=$(database_size_bytes) || {
    fail "upgrade refused: database size is unavailable"
    return 1
  }
  backup_storage_guards "$backup_root" "$db_size" yes || return 1
  upgrade_doctor_preflight || return 1
  old_images=$(backup_image_digests) || {
    fail "upgrade refused: running image digests are unavailable"
    return 1
  }
  old_env_version=$(env_get QRADAR_DASH_VERSION)
  if [ "$old_env_version" != "$installed" ]; then
    fail "upgrade refused: $ENV_FILE has QRADAR_DASH_VERSION=${old_env_version:-unset} but the state file says $installed"
    return 1
  fi
  at=$(state_now) || {
    fail "upgrade refused: the UTC time is unavailable"
    return 1
  }
  RESTORE_STOPPED_SERVICES=()
  UPGRADE_RESTART_OLD=yes
  trap upgrade_restart_old EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  if ! restore_stop_services; then
    upgrade_restart_old
    fail "upgrade could not stop all writer and UI services"
    return 1
  fi
  # A subshell: cmd_backup_create calls die and sets its own EXIT trap. Called directly, a
  # failed backup would exit this script and replace the trap that restarts the old services.
  if ! backup_output=$( (cmd_backup_create pre-upgrade yes) ); then
    upgrade_restart_old
    fail "pre-upgrade backup failed; old services were restarted"
    return 1
  fi
  printf '%s\n' "$backup_output"
  backup=$(printf '%s\n' "$backup_output" | tail -n1)
  if ! backup_path_is_managed "$backup_root" "$backup" \
    || ! backup_directory_complete "$backup"; then
    upgrade_restart_old
    fail "pre-upgrade backup returned an unsafe or incomplete path; old services were restarted"
    return 1
  fi
  if ! dc exec -T redis redis-cli FLUSHALL >/dev/null; then
    upgrade_restart_old
    fail "Redis flush failed before migration; old services were restarted"
    return 1
  fi
  # Record the attempt before anything irreversible: a crash or reboot from here on leaves a
  # state that blocks upgrade and lets rollback run. Success, rollback and failure overwrite it.
  if ! write_state "$installed" "$old_images" "$old_images" "$at" "$installed" "$target" \
    failed "$backup"; then
    upgrade_restart_old
    fail "the upgrade attempt could not be recorded; old services were restarted"
    return 1
  fi
  if ! set_env_version "$target"; then
    # Nothing irreversible happened: put the recorded state back as it was.
    write_state "$installed" "$STATE_IMAGES" "$STATE_PREVIOUS_IMAGES" "$STATE_LAST_AT" \
      "$STATE_LAST_FROM" "$STATE_LAST_TO" "$STATE_LAST_OUTCOME" "$STATE_LAST_BACKUP" \
      "$STATE_LAST_RESTORED_FROM" || fail "the previous state could not be put back"
    upgrade_restart_old
    return 1
  fi
  UPGRADE_RESTART_OLD=no
  if ! dc run --rm -T migrate; then
    fail "migration failed; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  if ! start_upgrade_services; then
    fail "a required service was not healthy within 180 seconds; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  if ! upgrade_runtime_checks "$target"; then
    fail "$UPGRADE_CHECK_FAILURE; starting automatic rollback"
    upgrade_auto_rollback "$backup" "$installed" "$old_images" "$target" "$at"
    return 1
  fi
  new_images=$(backup_image_digests) || {
    fail "upgrade is healthy but its running image digests could not be recorded"
    return 1
  }
  write_state "$target" "$new_images" "$old_images" "$at" "$installed" "$target" \
    success "$backup" || return 1
  say "Upgrade complete: $installed -> $target."
}

upgrade_auto_rollback() { # backup old-version old-images target at
  if perform_rollback "$1" "$2" "$3" "$2" "$4" "$5"; then
    fail "upgrade to $4 failed and was rolled back to $2; the broken database was kept"
  fi
}

cmd_rollback() {
  local backup old_version old_images db_size docker_root at answer
  local non_interactive=no yes=no
  need_installed
  command -v docker >/dev/null 2>&1 || die "Docker is not installed"
  while [ $# -gt 0 ]; do
    case "$1" in
      --non-interactive) non_interactive=yes ;;
      --yes) yes=yes ;;
      -h | --help) usage; return 0 ;;
      *) fail "unknown rollback argument: $1"; return 2 ;;
    esac
    shift
  done
  state_read .qradar-dash/state.json || {
    fail "rollback refused: .qradar-dash/state.json field ${STATE_ERROR_FIELD:-json} is invalid or missing"
    return 1
  }
  old_images=$STATE_PREVIOUS_IMAGES
  [ -n "$old_images" ] || {
    fail "rollback refused: previous_images is null"
    return 1
  }
  [ "$STATE_LAST_PRESENT" = yes ] || {
    fail "rollback refused: last_upgrade is missing"
    return 1
  }
  backup=$STATE_LAST_BACKUP
  backup_directory_complete "$backup" || {
    fail "rollback refused: last_upgrade.backup is missing or incomplete: $backup"
    return 1
  }
  old_version=$STATE_LAST_FROM
  [ "$(manifest_get "$backup" VERSION)" = "$old_version" ] || {
    fail "rollback refused: backup version does not match last_upgrade.from"
    return 1
  }
  previous_images_are_local "$old_images" || {
    fail "rollback refused: a previous image is absent or has the wrong local digest"
    return 1
  }
  encryption_key_compatible "$backup/env.bak" || {
    fail "rollback refused: the backup's ENCRYPTION_KEY is not the current key or in ENCRYPTION_KEYS_JSON"
    return 1
  }
  db_size=$(manifest_get "$backup" DATABASE_SIZE_BYTES)
  case "$db_size" in '' | *[!0-9]*) fail "rollback refused: invalid backup size"; return 1 ;; esac
  docker_root=$(docker_root_path) || {
    fail "rollback refused: Docker root directory is unavailable"
    return 1
  }
  backup_disk_guard "$docker_root" "$db_size" 2 || return 1
  if [ "$non_interactive" = yes ]; then
    [ "$yes" = yes ] || { fail "--non-interactive rollback requires --yes"; return 1; }
  else
    say "Rollback replaces the live database with $backup; data written since is kept only in the broken copy."
    printf 'Type rollback to continue: '
    IFS= read -r answer || answer=""
    [ "$answer" = rollback ] || { fail "rollback confirmation was not given"; return 1; }
  fi
  set_upgrade_services
  at=$(state_now) || return 1
  perform_rollback "$backup" "$old_version" "$old_images" \
    "$STATE_LAST_FROM" "$STATE_LAST_TO" "$at"
}

# ---------------------------------------------------------------- doctor

DOCTOR_WORST=0
DOCTOR_HAS_DOCKER=0
DOCTOR_BACKEND_RUNNING=0
DOCTOR_ID_WIDTH=16

doctor_line() { # doctor_line STATUS ID MESSAGE [RUNBOOK]
  local status=$1 id=$2 message=$3 runbook=${4:-} severity=0
  case "$status" in
    WARN) severity=1 ;;
    FAIL) severity=2 ;;
  esac
  [ "$severity" -le "$DOCTOR_WORST" ] || DOCTOR_WORST=$severity
  printf '%-5s %-*s %s' "$status" "$DOCTOR_ID_WIDTH" "$id" "$message"
  [ -z "$runbook" ] || printf '    runbook: %s' "$runbook"
  printf '\n'
}

doctor_free_gib() { awk -v blocks="$1" 'BEGIN {printf "%.1f", blocks / 1048576}'; }

doctor_df() { # doctor_df PATH -> "FREE_KIB USED_PERCENT", or no output
  local row free used
  row=$(df -Pk -- "$1" 2>/dev/null | awk 'NR == 2 {print $4, $5}') || return 1
  read -r free used <<<"$row"
  used=${used%%%}
  case "$free:$used" in
    *[!0-9:]* | :* | *:) return 1 ;;
  esac
  printf '%s %s\n' "$free" "$used"
}

doctor_disk_docker() {
  local root metrics free used free_gib status
  if [ "$DOCTOR_HAS_DOCKER" -eq 0 ]; then
    doctor_line FAIL disk_docker "Docker is not installed"
    return
  fi
  root=$(docker info --format '{{.DockerRootDir}}' 2>/dev/null || true)
  if [ -z "$root" ]; then
    doctor_line FAIL disk_docker "Docker root directory is unavailable" OPS-R14
    return
  fi
  metrics=$(doctor_df "$root" || true)
  if [ -z "$metrics" ]; then
    doctor_line FAIL disk_docker "free space is unavailable for Docker root $root" OPS-R14
    return
  fi
  read -r free used <<<"$metrics"
  free_gib=$(doctor_free_gib "$free")
  status=PASS
  if [ "$used" -ge 90 ]; then status=FAIL; elif [ "$used" -ge 70 ]; then status=WARN; fi
  doctor_line "$status" disk_docker "$used% used; $free_gib GiB free on $root" \
    "$([ "$status" = PASS ] || echo OPS-R14)"
}

doctor_database_size() { # bytes on stdout; failure means unavailable
  [ "$DOCTOR_HAS_DOCKER" -eq 1 ] || return 1
  database_size_bytes
}

doctor_disk_backup() {
  local path metrics free used free_gib status=PASS message db_size required_kib required_gib
  path=$(env_get QRADAR_DASH_BACKUP_DIR)
  if [ -z "$path" ]; then
    doctor_line FAIL disk_backup "backup directory is not configured" OPS-R14
    return
  fi
  if [ ! -e "$path" ]; then
    doctor_line WARN disk_backup "backup directory does not exist: $path" OPS-R14
    return
  fi
  if [ ! -d "$path" ]; then
    doctor_line FAIL disk_backup "backup path is not a directory: $path" OPS-R14
    return
  fi
  metrics=$(doctor_df "$path" || true)
  if [ -z "$metrics" ]; then
    doctor_line FAIL disk_backup "free space is unavailable for backup directory $path" OPS-R14
    return
  fi
  read -r free used <<<"$metrics"
  free_gib=$(doctor_free_gib "$free")
  if [ "$used" -ge 90 ]; then status=FAIL; elif [ "$used" -ge 70 ]; then status=WARN; fi
  message="$used% used; $free_gib GiB free on $path"
  if db_size=$(doctor_database_size); then
    read -r _ required_kib <<<"$(backup_guard_values "$path" "$db_size" 2)"
    required_gib=$(doctor_free_gib "$required_kib")
    if [ "$free" -lt "$required_kib" ]; then
      status=FAIL
      message="$message; backup guard needs $required_gib GiB"
    else
      message="$message; backup guard passes"
    fi
  else
    [ "$status" = FAIL ] || status=WARN
    message="$message; database size unavailable"
  fi
  doctor_line "$status" disk_backup "$message" "$([ "$status" = PASS ] || echo OPS-R14)"
}

doctor_clock() {
  local synced
  if ! command -v timedatectl >/dev/null 2>&1; then
    doctor_line WARN qradar_clock "timedatectl is not available; check NTP by hand" OPS-R15
    return
  fi
  synced=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
  if [ "$synced" = yes ]; then
    doctor_line PASS qradar_clock "NTP is synchronized"
  else
    doctor_line WARN qradar_clock "NTP is not synchronized" OPS-R15
  fi
}

doctor_selinux() {
  local mode
  if ! command -v getenforce >/dev/null 2>&1; then
    doctor_line PASS selinux "SELinux is not installed"
    return
  fi
  mode=$(getenforce 2>/dev/null | head -n1 || true)
  doctor_line PASS selinux "${mode:-unknown}"
}

doctor_profile_enabled() {
  local profiles=${COMPOSE_PROFILES:-}
  [ -n "$profiles" ] || profiles=$(env_get COMPOSE_PROFILES)
  case ",${profiles// /,}," in *,$1,*) return 0 ;; *) return 1 ;; esac
}

doctor_container_runbook() {
  case "$1" in
    backend | postgres) say OPS-R36 ;;
    celery-worker) say OPS-R41 ;;
    celery-beat) say OPS-R9 ;;
  esac
}

doctor_containers() {
  local output row service state health exit_code state_l health_l total=0 runbook candidate detail
  local -a failures=()
  local -a failure_runbooks=()
  DOCTOR_BACKEND_RUNNING=0
  if [ "$DOCTOR_HAS_DOCKER" -eq 0 ]; then
    doctor_line FAIL containers "Docker is not installed"
    return
  fi
  if ! output=$(
    dc ps --all --format '{{.Service}}\t{{.State}}\t{{.Health}}\t{{.ExitCode}}' 2>/dev/null
  ); then
    doctor_line FAIL containers "docker compose ps failed"
    return
  fi
  while IFS= read -r row; do
    row=${row//$'\t'/$'\x1f'}
    IFS=$'\x1f' read -r service state health exit_code <<<"$row"
    [ -n "$service" ] || continue
    state_l=${state,,}
    health_l=${health,,}
    if [ "$service" = qradar-mcp ] && ! doctor_profile_enabled mcp; then continue; fi
    if [ "$service" = migrate ] && [ "$state_l" = exited ]; then
      if [ "$exit_code" = 0 ]; then continue; fi
      total=$((total + 1))
      failures+=("migrate is exited (exit code: ${exit_code:-unknown})")
      failure_runbooks+=(OPS-R11)
      continue
    fi
    total=$((total + 1))
    if [ "$service" = backend ] && [ "$state_l" = running ]; then
      DOCTOR_BACKEND_RUNNING=1
    fi
    if [ "$state_l" != running ] || { [ -n "$health_l" ] && [ "$health_l" != healthy ]; }; then
      detail="$service is ${state_l:-unknown}"
      [ -z "$health_l" ] || detail="$detail (health: $health_l)"
      failures+=("$detail")
      candidate=$(doctor_container_runbook "$service")
      failure_runbooks+=("$candidate")
    fi
  done <<<"$output"
  if [ "$total" -eq 0 ]; then
    doctor_line FAIL containers "no active Compose services were found"
  elif [ "${#failures[@]}" -gt 0 ]; then
    local joined=${failures[0]}
    for detail in "${failures[@]:1}"; do joined="$joined; $detail"; done
    runbook=${failure_runbooks[0]:-}
    if [ -n "$runbook" ]; then
      for candidate in "${failure_runbooks[@]}"; do
        if [ -z "$candidate" ] || [ "$candidate" != "$runbook" ]; then
          runbook=""
          break
        fi
      done
    fi
    doctor_line FAIL containers "$joined" "$runbook"
  else
    doctor_line PASS containers "$total Compose service(s) are running and healthy"
  fi
}

doctor_incontainer() {
  local rc
  if [ "$DOCTOR_BACKEND_RUNNING" -eq 0 ]; then
    doctor_line FAIL doctor_incontainer "backend container is not running" OPS-R36
    return
  fi
  set +e
  dc exec -T backend python -m app.cli.doctor
  rc=$?
  set -e
  case "$rc" in
    0) ;;
    1) [ "$DOCTOR_WORST" -ge 1 ] || DOCTOR_WORST=1 ;;
    *) DOCTOR_WORST=2 ;;
  esac
}

cmd_doctor() {
  need_installed
  if command -v docker >/dev/null 2>&1; then DOCTOR_HAS_DOCKER=1; fi
  doctor_disk_docker
  doctor_disk_backup
  doctor_clock
  doctor_selinux
  doctor_containers
  doctor_incontainer
  return "$DOCTOR_WORST"
}

# ---------------------------------------------------------------- support bundle

SUPPORT_STAGE=""

support_cleanup() {
  [ -z "$SUPPORT_STAGE" ] || rm -rf -- "$SUPPORT_STAGE"
}

support_error() { # support_error PART MESSAGE
  printf '%s\n' "$2" >"$SUPPORT_STAGE/input/$1.error.txt"
}

support_psql() { # support_psql PART QUERY
  local part=$1 query=$2 target="$SUPPORT_STAGE/input/$1.txt"
  if printf '%s\n' "$query" \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -P pager=off >"$target" 2>/dev/null; then
    return
  fi
  rm -f -- "$target"
  support_error "$part" "$part could not be read; inspect ./qradar-dash doctor and the service logs."
}

support_version() {
  local target="$SUPPORT_STAGE/input/version.txt" piece="$SUPPORT_STAGE/version-piece"
  local api_port ui_port service digest
  : >"$target"
  if [ -f .qradar-dash/state.json ]; then
    if cat .qradar-dash/state.json >"$piece"; then
      printf '%s\n' 'state.json'
      cat "$piece"
      printf '\n'
    else
      support_error version-state \
        "version state could not be read; check .qradar-dash/state.json permissions."
    fi >>"$target"
  fi

  api_port=$(env_get API_LOOPBACK_PORT)
  : "${api_port:=8000}"
  if curl -fsS --max-time 5 "http://127.0.0.1:$api_port/api/v1/version" \
    >"$piece" 2>/dev/null; then
    printf '%s\n' 'backend /api/v1/version'
    cat "$piece"
    printf '\n'
  else
    support_error version-backend \
      "backend version endpoint could not be read; inspect doctor.txt and backend.log."
  fi >>"$target"

  ui_port=$(env_get UI_LOOPBACK_PORT)
  : "${ui_port:=3000}"
  if curl -fsS --max-time 5 "http://127.0.0.1:$ui_port/api/health" \
    >"$piece" 2>/dev/null; then
    printf '%s\n' 'frontend /api/health'
    cat "$piece"
    printf '\n'
  else
    support_error version-frontend \
      "frontend health endpoint could not be read; inspect doctor.txt and frontend.log."
  fi >>"$target"

  if dc config --services >"$SUPPORT_STAGE/services" 2>/dev/null; then
    printf '%s\n' 'compose image digests' >>"$target"
    while IFS= read -r service; do
      [ -n "$service" ] || continue
      case "$service" in
        *[!A-Za-z0-9_.-]*)
          support_error version-images \
            "Compose returned an unsafe service name; image digests are incomplete."
          continue
          ;;
      esac
      digest=$(dc images -q "$service" 2>/dev/null || true)
      if [ -n "$digest" ]; then
        printf '%s\t%s\n' "$service" "$digest" >>"$target"
      else
        support_error "version-image-$service" \
          "the $service image digest is unavailable; ensure its image has been pulled."
      fi
    done <"$SUPPORT_STAGE/services"
    printf '\n' >>"$target"
  else
    : >"$SUPPORT_STAGE/services"
    support_error version-images \
      "Compose service discovery failed; verify the Compose files and rerun the bundle."
  fi

  if printf '%s\n' 'SELECT version_num FROM alembic_version;' \
    | dc exec -T postgres psql -U "$(env_get POSTGRES_USER)" -d "$(env_get POSTGRES_DB)" \
      -v ON_ERROR_STOP=1 -P pager=off >"$piece" 2>/dev/null; then
    printf '%s\n' 'alembic_version'
    cat "$piece"
    printf '\n'
  else
    support_error version-alembic \
      "alembic_version could not be read; inspect doctor.txt and postgres.log."
  fi >>"$target"
  rm -f -- "$piece"
}

support_logs() {
  local service
  mkdir -p "$SUPPORT_STAGE/input/logs"
  if [ ! -s "$SUPPORT_STAGE/services" ]; then
    support_error logs \
      "Compose service discovery failed; no service logs could be collected."
    return
  fi
  while IFS= read -r service; do
    [ -n "$service" ] || continue
    case "$service" in
      *[!A-Za-z0-9_.-]*) continue ;;
    esac
    if ! dc logs --tail=2000 --no-color "$service" \
      >"$SUPPORT_STAGE/input/logs/$service.log" 2>/dev/null; then
      rm -f -- "$SUPPORT_STAGE/input/logs/$service.log"
      printf '%s\n' \
        "$service logs could not be read; check whether the service has a container." \
        >"$SUPPORT_STAGE/input/logs/$service.error.txt"
    fi
  done <"$SUPPORT_STAGE/services"
}

support_stage_secret() { # support_stage_secret SOURCE NAME
  [ -e "$1" ] || return 0
  if [ ! -f "$1" ] || [ ! -r "$1" ]; then
    fail "secret input cannot be read: $1; fix its permissions and rerun. No archive was written."
    return 1
  fi
  if ! install -m 600 "$1" "$SUPPORT_STAGE/input/.support-input/$2"; then
    fail "secret input could not be staged: $1; fix disk access and rerun. No archive was written."
    return 1
  fi
}

cmd_support_bundle() {
  need_installed
  command -v docker >/dev/null 2>&1 || die \
    "Docker is not installed; install Docker and rerun support-bundle."
  command -v tar >/dev/null 2>&1 || die \
    "tar is not installed; install tar and rerun support-bundle."

  local backup_root timestamp final output
  backup_root=$(env_get QRADAR_DASH_BACKUP_DIR)
  [ -n "$backup_root" ] || die \
    "backup root is not configured; set QRADAR_DASH_BACKUP_DIR and rerun support-bundle."
  umask 077
  mkdir -p -- "$backup_root" || die \
    "backup root cannot be created: $backup_root; fix its parent permissions and rerun."
  SUPPORT_STAGE=$(mktemp -d "$backup_root/.support-staging.XXXXXX") || die \
    "staging directory cannot be created under $backup_root; fix its permissions and rerun."
  trap support_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
  chmod 700 "$SUPPORT_STAGE"
  mkdir -p "$SUPPORT_STAGE/input/.support-input/secrets"

  (cmd_doctor || true) >"$SUPPORT_STAGE/input/doctor.txt" 2>&1
  support_version
  if ! dc ps --all >"$SUPPORT_STAGE/input/compose-ps.txt" 2>/dev/null; then
    rm -f -- "$SUPPORT_STAGE/input/compose-ps.txt"
    support_error compose-ps \
      "docker compose ps failed; verify Docker access and inspect doctor.txt."
  fi
  support_psql watermarks \
    'SELECT id, instance_id, collector, watermark_at, last_run_at, lag_seconds, intervals_collected, consecutive_failures, last_error, collection_metadata, created_at, updated_at FROM collection_watermark ORDER BY instance_id, collector;'
  support_psql cadence \
    'SELECT family, cadence_seconds, last_slot_start, updated_at, updated_by, last_run_at, last_run_outcome, last_run_searches, last_run_buckets, last_run_splits FROM search_cadence ORDER BY family;'
  support_logs

  if ! install -m 600 "$ENV_FILE" "$SUPPORT_STAGE/input/.support-input/config.env"; then
    fail "configuration could not be staged; fix .env permissions and rerun. No archive was written."
    return 1
  fi
  support_stage_secret .secrets/qradar.sec secrets/qradar.sec
  support_stage_secret .secrets/ghcr.token secrets/ghcr.token
  support_stage_secret .secrets/tls.key secrets/tls.key

  output="$SUPPORT_STAGE/support.tar.gz"
  if ! tar -C "$SUPPORT_STAGE/input" -cf - . \
    | dc run --rm --no-deps -T backend python -m app.cli.support_bundle >"$output"; then
    fail "support-bundle scrubber failed; ensure the backend image is available, then rerun. No archive was written."
    return 1
  fi

  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  final="$backup_root/support-$timestamp.tar.gz"
  [ ! -e "$final" ] || die \
    "support archive already exists: $final; wait one second and rerun support-bundle."
  chmod 600 "$output"
  mv -- "$output" "$final"
  chmod 600 "$final"
  say "$final"
}

not_built() {
  fail "'$1' is not built yet ($2)."
  exit 64
}

main() {
  local cmd=${1:-}
  [ $# -eq 0 ] || shift
  case "$cmd" in
    install) cmd_install "$@" ;;
    status) cmd_status ;;
    logs) cmd_logs "$@" ;;
    upgrade) cmd_upgrade "$@" ;;
    rollback) cmd_rollback "$@" ;;
    backup) cmd_backup "$@" ;;
    restore) cmd_restore "$@" ;;
    doctor) cmd_doctor ;;
    support-bundle) cmd_support_bundle ;;
    bundle) not_built "$cmd" "the offline bundle is not part of this release; use ./qradar-dash install --build from a checkout, or install by pulling from the registry" ;;
    -h | --help | help | "") usage; [ -n "$cmd" ] || exit 2 ;;
    *) fail "unknown command: $cmd"; usage >&2; exit 2 ;;
  esac
}

if [ "${QRADAR_DASH_SOURCE_ONLY:-0}" != 1 ]; then main "$@"; fi
