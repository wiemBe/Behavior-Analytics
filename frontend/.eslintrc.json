{
  "extends": ["next/core-web-vitals"],
  "overrides": [
    {
      "files": [
        "src/app/**/*.ts",
        "src/app/**/*.tsx",
        "src/components/**/*.ts",
        "src/components/**/*.tsx",
        "src/widgets/**/*.ts",
        "src/widgets/**/*.tsx",
        "src/lib/**/*.ts",
        "src/lib/**/*.tsx"
      ],
      "excludedFiles": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/fixtures.ts",
        "**/subjectFixtures.ts",
        "**/KpiTestStates.tsx"
      ],
      "rules": {
        "react/jsx-no-literals": [
          "error",
          {
            "noStrings": true,
            "ignoreProps": true,
            "allowedStrings": ["—", "·", "…", "/", ":", "(", ")", ",", ".", "≥", "≥ "]
          }
        ]
      }
    }
  ]
}
