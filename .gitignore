# Secrets — never commit
.env
# No longer read by anything (SEC-4), but older install notes had operators put the
# QRadar token in it: keep it out of git on hosts that still have one.
deploy/mcp/config.json
*.pem
*.key
# Local secret material (QRadar service token, pinned CA). The whole directory
# is ignored rather than individual names, so a new secret dropped in here is
# safe by default instead of safe only if someone remembers to add a rule.
.secrets/
*.sec

# Python
__pycache__/
*.py[cod]
.venv
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# Node / Next
node_modules
.next/
frontend/out/
npm-debug.log*
# Generated by `next build` / `tsc --incremental`; regenerated on every build.
next-env.d.ts
*.tsbuildinfo

# Data / logs
logs/
*.log
postgres_data/

# Lab generator output. Run manifests and captured event files describe one
# operator's run and grow without bound; sanitized excerpts belong in
# docs/LAB-DEMO-RESULTS.md, and small fixtures live under backend/tests.
lab-runs/
*.summary.json

# Host-specific compose overlay (libvirt/macvlan layout of one machine).
docker-compose.override.yml

# Installer: the answers file and the generated edge/backup state
install.answers
.install-tmp/
.qradar-dash/

# Internal orchestration files: kept on the orchestrator's machine, never pushed (user, 2026-10-18)
AGENTS.md
docs/tasks/
docs/PLANNER.md
docs/NEXT-SESSION-PROMPT.md
docs/PHASE2-HANDOFF.md
docs/PHASE3-HANDOFF.md
docs/UI_Suggestions/
docs/UI-REDESIGN-PLAN.md
docs/UI-WORKSTREAM-COMPLETION.md
